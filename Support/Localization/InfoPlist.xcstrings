    "NSLocalNetworkUsageDescription": {
      "comment": "Why OctoMac asks for local network access (shown by macOS)",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac se připojuje k serverům OctoPrint ve vaší místní síti."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoMac yn cysylltu â gweinyddion OctoPrint ar eich rhwydwaith lleol."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac opretter forbindelse til OctoPrint-servere på dit lokale netværk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac verbindet sich mit OctoPrint-Servern in deinem lokalen Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac connects to OctoPrint servers on your local network."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac connects to OctoPrint servers on your local network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac se conecta a servidores OctoPrint de tu red local."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac muodostaa yhteyden lähiverkkosi OctoPrint-palvelimiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac se connecte aux serveurs OctoPrint de votre réseau local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac si collega ai server OctoPrint della tua rete locale."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac kobler til OctoPrint-servere på det lokale nettverket ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac maakt verbinding met OctoPrint-servers op je lokale netwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac łączy się z serwerami OctoPrint w Twojej sieci lokalnej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoMac liga-se a servidores OctoPrint na sua rede local."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac ansluter till OctoPrint-servrar på ditt lokala nätverk."
          }
        }
      }
    }
