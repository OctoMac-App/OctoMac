    "Breaks out of a heating wait (M109 or M190), for example when a cancel is stuck behind one.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přeruší čekání na ohřev (M109 nebo M190), například když za ním uvízlo zrušení."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn torri allan o aros i wresogi (M109 neu M190), er enghraifft pan fo canslo'n sownd y tu ôl i un."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbryder en ventetid på opvarmning (M109 eller M190), f.eks. når en annullering sidder fast bag en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bricht ein Warten aufs Aufheizen ab (M109 oder M190), z. B. wenn ein Abbruch dahinter feststeckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breaks out of a heating wait (M109 or M190), for example when a cancel is stuck behind one."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Breaks out of a heating wait (M109 or M190), for example when a cancel is stuck behind one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrumpe una espera de calentamiento (M109 o M190), por ejemplo cuando una cancelación se queda atascada detrás de una."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskeyttää lämmityksen odotuksen (M109 tai M190), esimerkiksi kun peruutus on jumissa sen takana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompt une attente de chauffe (M109 ou M190), par exemple quand une annulation est bloquée derrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe un'attesa di riscaldamento (M109 o M190), ad esempio quando un annullamento è bloccato dietro di essa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbryter en oppvarmingsventing (M109 eller M190), for eksempel når en avbrytelse sitter fast bak en."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderbreekt het wachten op opwarmen (M109 of M190), bijvoorbeeld als een annulering daarachter vastzit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przerywa oczekiwanie na nagrzanie (M109 lub M190), na przykład gdy utknęło za nim anulowanie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompe uma espera de aquecimento (M109 ou M190), por exemplo quando um cancelamento fica preso atrás dela."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbryter en uppvärmningsväntan (M109 eller M190), till exempel när en avbrytning har fastnat bakom en."
          }
        }
      }
    },
