    "E values after this are amounts to push from now. Most slicers use this.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodnoty E za tímto příkazem jsou množství k vytlačení od tohoto okamžiku. Používá to většina slicerů."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae gwerthoedd E ar ôl hyn yn symiau i'w gwthio o nawr. Mae'r rhan fwyaf o sleiswyr yn defnyddio hyn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "E-værdier efter dette er mængder, der skal skubbes frem herfra. De fleste slicere bruger dette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Werte danach sind Mengen ab jetzt. Die meisten Slicer nutzen das."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "E values after this are amounts to push from now. Most slicers use this."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "E values after this are amounts to push from now. Most slicers use this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores E a partir de aquí son cantidades a empujar desde ahora. La mayoría de los slicers usan esto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän jälkeen E-arvot ovat määriä, jotka pursotetaan nykyhetkestä. Useimmat slicerit käyttävät tätä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs E suivantes sont des quantités à pousser à partir de maintenant. La plupart des slicers utilisent ce mode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori E successivi sono quantità da spingere da ora. La maggior parte degli slicer usa questa modalità."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "E-verdier etter dette er mengder som skal mates fra nå av. De fleste slicere bruker dette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "E-waarden hierna zijn hoeveelheden om vanaf nu door te voeren. De meeste slicers gebruiken dit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolejne wartości E to ilości do wypchnięcia od teraz. Używa tego większość slicerów."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores E seguintes são quantidades a empurrar a partir de agora. A maioria dos slicers usa este modo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "E-värden efter detta är mängder att mata fram räknat från nu. De flesta slicers använder detta."
          }
        }
      }
    },
