          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint ainda está a ligar-se à impressora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ansluter fortfarande till skrivaren."
          }
        }
      }
    },
    "OctoPrint is stopping the print and running its cancel routine.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint zastavuje tisk a spouští svou rutinu pro zrušení."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoPrint yn stopio'r argraffiad ac yn rhedeg ei drefn ganslo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint stopper printet og kører sin annulleringsrutine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint stoppt den Druck und führt seine Abbruchroutine aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint is stopping the print and running its cancel routine."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint is stopping the print and running its cancel routine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint está deteniendo la impresión y ejecutando su rutina de cancelación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint pysäyttää tulostusta ja ajaa peruutusrutiiniaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint arrête l’impression et lance sa routine d’annulation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint sta interrompendo la stampa ed eseguendo la sua routine di annullamento."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint stopper utskriften og kjører avbrytrutinen sin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint stopt de print en voert zijn annuleerroutine uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint zatrzymuje wydruk i uruchamia procedurę anulowania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint está a parar a impressão e a executar a rotina de cancelamento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint stoppar utskriften och kör sin avbrytningsrutin."
          }
        }
      }
    },
    "OctoPrint is stopping the print, but the printer is waiting for its heaters and won't respond until that finishes.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint zastavuje tisk, ale tiskárna čeká na topení a nebude reagovat, dokud to neskončí."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoPrint yn stopio'r argraffiad, ond mae'r argraffydd yn aros am ei wresogyddion ac ni fydd yn ymateb nes i hynny orffen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint stopper printet, men printeren venter på sine varmelegemer og svarer ikke, før det er overstået."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint stoppt den Druck, aber der Drucker wartet auf seine Heizungen und reagiert erst, wenn das erledigt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint is stopping the print, but the printer is waiting for its heaters and won't respond until that finishes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint is stopping the print, but the printer is waiting for its heaters and won't respond until that finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint está deteniendo la impresión, pero la impresora está esperando a sus calentadores y no responderá hasta que terminen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint pysäyttää tulostusta, mutta tulostin odottaa lämmittimiään eikä vastaa ennen kuin se on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint arrête l’impression, mais l’imprimante attend ses éléments chauffants et ne répondra pas avant la fin de cette attente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint sta interrompendo la stampa, ma la stampante aspetta i riscaldatori e non risponderà finché non hanno finito."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint stopper utskriften, men skriveren venter på varmeelementene og svarer ikke før det er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint stopt de print, maar de printer wacht op de verwarming en reageert pas als die klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint zatrzymuje wydruk, ale drukarka czeka na grzałki i nie odpowie, dopóki to się nie skończy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint está a parar a impressão, mas a impressora está à espera dos aquecedores e não responde até isso terminar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint stoppar utskriften, men skrivaren väntar på sina värmare och svarar inte förrän det är klart."
          }
        }
      }
    },
    "OctoPrint makes the backup on the Raspberry Pi, with its settings and plugins. You can save a copy to this Mac once it's done.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint vytvoří zálohu na Raspberry Pi i s nastavením a pluginy. Až bude hotová, můžete si uložit kopii do tohoto Macu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoPrint yn gwneud y copi wrth gefn ar y Raspberry Pi, gyda'i osodiadau a'i ategion. Gallwch chi gadw copi ar y Mac hwn unwaith y bydd wedi gorffen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint laver sikkerhedskopien på Raspberry Pi med indstillinger og plugins. Du kan gemme en kopi på denne Mac, når den er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint erstellt das Backup auf dem Raspberry Pi, mit seinen Einstellungen und Plugins. Sobald es fertig ist, kannst du eine Kopie auf diesem Mac speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint makes the backup on the Raspberry Pi, with its settings and plugins. You can save a copy to this Mac once it's done."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint makes the backup on the Raspberry Pi, with its settings and plugins. You can save a copy to this Mac once it's done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint hace la copia de seguridad en la Raspberry Pi, con sus ajustes y plugins. Cuando termine, podrás guardar una copia en este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint tekee varmuuskopion Raspberry Pi:hin asetuksineen ja lisäosineen. Kun se on valmis, voit tallentaa kopion tähän Maciin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint crée la sauvegarde sur le Raspberry Pi, avec ses réglages et ses plugins. Une fois terminée, vous pouvez en enregistrer une copie sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint crea il backup sul Raspberry Pi, con le sue impostazioni e i plugin. Al termine puoi salvarne una copia su questo Mac."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint tar sikkerhetskopien på Raspberry Pi, med innstillinger og utvidelser. Du kan arkivere en kopi på denne Macen når den er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint maakt de back-up op de Raspberry Pi, met de instellingen en plug-ins. Zodra hij klaar is, kun je een kopie op deze Mac bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint tworzy kopię zapasową na Raspberry Pi, razem z ustawieniami i wtyczkami. Gdy będzie gotowa, możesz zachować jej kopię na tym Macu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint faz a cópia de segurança no Raspberry Pi, com as definições e os plugins. Quando terminar, pode guardar uma cópia neste Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint gör säkerhetskopian på Raspberry Pi, med inställningar och plugin. Du kan spara en kopia på den här Macen när den är klar."
          }
        }
      }
    },
    "OctoPrint needs a restart to start using it. OctoMac loses touch with the printer for a minute while it starts again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby ho OctoPrint mohl začít používat, potřebuje restart. OctoMac na minutu ztratí spojení s tiskárnou, než se znovu spustí."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae angen ailgychwyn OctoPrint i ddechrau ei ddefnyddio. Mae OctoMac yn colli cysylltiad â'r argraffydd am funud tra mae'n ailgychwyn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint skal genstartes for at begynde at bruge det. OctoMac mister kontakten til printeren i et minut, mens den starter igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint muss neu gestartet werden, um es zu verwenden. OctoMac verliert für eine Minute den Kontakt zum Drucker, während es neu startet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint needs a restart to start using it. OctoMac loses touch with the printer for a minute while it starts again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint needs a restart to start using it. OctoMac loses touch with the printer for a minute while it starts again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint necesita reiniciarse para empezar a usarlo. OctoMac pierde el contacto con la impresora durante un minuto mientras vuelve a arrancar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint täytyy käynnistää uudelleen, jotta lisäosa otetaan käyttöön. OctoMac menettää yhteyden tulostimeen minuutiksi, kun OctoPrint käynnistyy uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint doit redémarrer pour commencer à l’utiliser. OctoMac perd le contact avec l’imprimante pendant une minute, le temps qu’il redémarre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint deve riavviarsi per iniziare a usarlo. OctoMac perde il contatto con la stampante per un minuto mentre si riavvia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint må startes på nytt for å ta den i bruk. OctoMac mister kontakten med skriveren i et minutt mens den starter igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint moet herstarten om hem te gaan gebruiken. OctoMac verliest een minuut het contact met de printer terwijl OctoPrint opnieuw opstart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zacząć jej używać, trzeba ponownie uruchomić OctoPrint. OctoMac straci kontakt z drukarką na minutę, gdy OctoPrint będzie się uruchamiać."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint tem de reiniciar para começar a usá-lo. O OctoMac perde o contacto com a impressora durante um minuto enquanto volta a arrancar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint behöver startas om för att börja använda det. OctoMac tappar kontakten med skrivaren en minut medan OctoPrint startar igen."
          }
        }
      }
    },
    "OctoPrint needs this plugin": {
      "localizations": {
