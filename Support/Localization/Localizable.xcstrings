    "For next time, e.g. “needs a brim” or “245° worked well”": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro příště, např. „potřebuje brim“ nebo „245° fungovalo dobře“"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar gyfer y tro nesaf, e.e. “angen ymyl” neu “roedd 245° yn gweithio'n dda”"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til næste gang, f.eks. »skal have brim« eller »245° fungerede godt«"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fürs nächste Mal, z. B. „braucht einen Brim“ oder „245° hat gut funktioniert“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For next time, e.g. “needs a brim” or “245° worked well”"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "For next time, e.g. “needs a brim” or “245° worked well”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para la próxima vez, p. ej. «necesita brim» o «245° ha ido bien»"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraavaa kertaa varten, esim. ”tarvitsee brimin” tai ”245° toimi hyvin”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour la prochaine fois, par ex. « a besoin d’une bordure » ou « 245° a bien marché »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per la prossima volta, ad es. “serve un brim” o “245° ha funzionato bene”"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Til neste gang, f.eks. «trenger brim» eller «245° fungerte bra»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de volgende keer, bijv. “heeft een brim nodig” of “245° werkte goed”"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na następny raz, np. „potrzebny brim” lub „245° sprawdziło się”"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para a próxima vez, por ex. «precisa de aba» ou «245° funcionou bem»"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Till nästa gång, t.ex. ”behöver brim” eller ”245° fungerade bra”"
          }
        }
      }
    },
    "For printers you reach from outside your home through a reverse proxy. OctoMac sends these with every request to this address, and nowhere else.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tiskárny, ke kterým se připojujete mimo domov přes reverzní proxy. OctoMac je posílá s každým požadavkem na tuto adresu a nikam jinam."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar gyfer argraffwyr rydych chi'n eu cyrraedd o'r tu allan i'ch cartref drwy ddirprwy gwrthdro. Mae OctoMac yn anfon y rhain gyda phob cais i'r cyfeiriad hwn, a nunlle arall."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til printere, du når udefra via en reverse proxy. OctoMac sender disse med hver anmodning til denne adresse og ingen andre steder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Drucker, die du von außerhalb deines Zuhauses über einen Reverse Proxy erreichst. OctoMac sendet diese bei jeder Anfrage an diese Adresse und nirgendwo sonst hin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For printers you reach from outside your home through a reverse proxy. OctoMac sends these with every request to this address, and nowhere else."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "For printers you reach from outside your home through a reverse proxy. OctoMac sends these with every request to this address, and nowhere else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para impresoras a las que accedes desde fuera de casa a través de un proxy inverso. OctoMac las envía con cada solicitud a esta dirección, y a ningún otro sitio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulostimille, joihin otat yhteyden kodin ulkopuolelta käänteisen välityspalvelimen kautta. OctoMac lähettää nämä jokaisen tähän osoitteeseen menevän pyynnön mukana, eikä minnekään muualle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les imprimantes accessibles depuis l’extérieur de chez vous via un proxy inverse. OctoMac les envoie avec chaque requête vers cette adresse, et nulle part ailleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per le stampanti che raggiungi da fuori casa tramite un reverse proxy. OctoMac le invia con ogni richiesta a questo indirizzo, e a nessun altro."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For skrivere du når utenfra hjemmet via en omvendt proxy. OctoMac sender disse med hver forespørsel til denne adressen, og ingen andre steder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor printers die je van buitenaf bereikt via een reverse proxy. OctoMac stuurt deze mee met elk verzoek naar dit adres, en nergens anders heen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla drukarek, z którymi łączysz się spoza domu przez reverse proxy. OctoMac wysyła je z każdym żądaniem pod ten adres i nigdzie indziej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para impressoras a que acede fora de casa através de um proxy inverso. O OctoMac envia estes dados em cada pedido para este endereço, e para mais nenhum."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För skrivare som du når utanför hemmet via en omvänd proxy. OctoMac skickar dessa med varje begäran till den här adressen, och ingen annanstans."
          }
        }
      }
    },
