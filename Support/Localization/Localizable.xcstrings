    "That's sooner than the print takes. Started now, it would be done at %@.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To je dříve, než tisk trvá. Kdybyste začali teď, bylo by hotovo v %@."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae hynny'n gynt nag mae'r argraffiad yn ei gymryd. O'i ddechrau nawr, byddai'n gorffen am %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er hurtigere, end printet tager. Startet nu ville det være færdigt kl. %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist früher, als der Druck dauert. Jetzt gestartet, wäre er um %@ fertig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's sooner than the print takes. Started now, it would be done at %@."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "That's sooner than the print takes. Started now, it would be done at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es antes de lo que tarda la impresión. Si empezara ahora, terminaría a las %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on aikaisemmin kuin tulostus kestää. Nyt aloitettuna se olisi valmis klo %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est plus tôt que la durée de l’impression. Lancée maintenant, elle serait terminée à %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È prima di quanto duri la stampa. Avviandola ora finirebbe alle %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er kortere tid enn utskriften tar. Startet nå ville den vært ferdig kl. %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat is eerder dan de print duurt. Als je nu start, is hij om %@ klaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wcześniej, niż trwa wydruk. Uruchomiony teraz skończyłby się o %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É mais cedo do que o tempo que a impressão demora. Se começar agora, termina às %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är tidigare än utskriften tar. Startad nu skulle den bli klar kl. %@."
          }
        }
      }
    },
    "The Keychain didn't accept the keys, so they're still in OctoMac's own file.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíčenka klíče nepřijala, takže zůstávají ve vlastním souboru OctoMacu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni dderbyniodd y Keychain yr allweddi, felly maen nhw'n dal yn ffeil OctoMac ei hun."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøglering accepterede ikke nøglerne, så de ligger stadig i OctoMacs egen fil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüsselbund hat die Schlüssel nicht angenommen, daher liegen sie weiter in OctoMacs eigener Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Keychain didn't accept the keys, so they're still in OctoMac's own file."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Keychain didn't accept the keys, so they're still in OctoMac's own file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El llavero no ha aceptado las claves, así que siguen en el archivo propio de OctoMac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avainnippu ei hyväksynyt avaimia, joten ne ovat yhä OctoMacin omassa tiedostossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trousseau n’a pas accepté les clés, elles restent donc dans le fichier propre à OctoMac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Portachiavi non ha accettato le chiavi, quindi restano nel file di OctoMac."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøkkelring godtok ikke nøklene, så de ligger fortsatt i OctoMacs egen fil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutelhanger accepteerde de sleutels niet, dus ze staan nog in het eigen bestand van OctoMac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pęk kluczy nie przyjął kluczy, więc nadal są we własnym pliku OctoMac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Porta-chaves não aceitou as chaves, por isso continuam no ficheiro próprio do OctoMac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckelringen godtog inte nycklarna, så de ligger kvar i OctoMacs egen fil."
          }
        }
      }
    },
    "The Pi has been running below full speed, which can make prints stutter.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi běželo pod plnou rychlostí, což může způsobit zadrhávání tisku."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae'r Pi wedi bod yn rhedeg yn arafach na'i gyflymder llawn, a all wneud i argraffiadau atal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi'en har kørt under fuld hastighed, hvilket kan få prints til at hakke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pi lief unter voller Geschwindigkeit, wodurch Drucke stocken können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Pi has been running below full speed, which can make prints stutter."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Pi has been running below full speed, which can make prints stutter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Pi ha funcionado por debajo de su velocidad máxima, lo que puede provocar tirones en las impresiones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi on toiminut alle täyden nopeuden, mikä voi aiheuttaa tulosteisiin nykimistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Pi a fonctionné en dessous de sa pleine vitesse, ce qui peut faire saccader les impressions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Pi ha funzionato sotto la piena velocità, il che può far scattare le stampe."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi-en har kjørt under full hastighet, noe som kan gi hakkete utskrifter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Pi draaide onder volle snelheid, waardoor prints kunnen haperen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi pracowało poniżej pełnej prędkości, przez co wydruki mogą się zacinać."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pi tem funcionado abaixo da velocidade máxima, o que pode causar falhas nas impressões."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi:n har gått under full hastighet, vilket kan göra att utskrifter hackar."
          }
        }
      }
    },
    "The Pi is too hot and is slowing down. Prints may stutter.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi je příliš horké a zpomaluje. Tisk se může zadrhávat."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae'r Pi yn rhy boeth ac yn arafu. Efallai y bydd argraffiadau'n atal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi'en er for varm og sætter farten ned. Prints kan hakke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pi ist zu heiß und drosselt sich. Drucke können stocken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Pi is too hot and is slowing down. Prints may stutter."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Pi is too hot and is slowing down. Prints may stutter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Pi está demasiado caliente y va más lenta. Puede haber tirones en las impresiones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi on liian kuuma ja hidastaa. Tulostus voi nykiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Pi est trop chaud et ralentit. Les impressions peuvent saccader."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Pi è troppo caldo e sta rallentando. Le stampe potrebbero scattare."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi-en er for varm og blir tregere. Utskrifter kan hakke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Pi is te heet en vertraagt. Prints kunnen haperen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi jest za gorące i zwalnia. Wydruki mogą się zacinać."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pi está demasiado quente e está a abrandar. As impressões podem ter falhas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi:n är för varm och saktar ned. Utskrifter kan hacka."
          }
        }
      }
    },
    "The Pi isn't getting enough power. Prints may stutter; try a better power supply.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi nemá dostatek napájení. Tisk se může zadrhávat; zkuste lepší zdroj."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dydy'r Pi ddim yn cael digon o bŵer. Efallai y bydd argraffiadau'n atal; rhowch gynnig ar gyflenwad pŵer gwell."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi'en får ikke nok strøm. Prints kan hakke; prøv en bedre strømforsyning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Pi bekommt nicht genug Strom. Drucke können stocken, versuch es mit einem besseren Netzteil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Pi isn't getting enough power. Prints may stutter; try a better power supply."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Pi isn't getting enough power. Prints may stutter; try a better power supply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Pi no recibe suficiente alimentación. Puede haber tirones en las impresiones; prueba con una fuente de alimentación mejor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi ei saa tarpeeksi virtaa. Tulostus voi nykiä; kokeile parempaa virtalähdettä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Pi n’est pas assez alimenté. Les impressions peuvent saccader ; essayez une meilleure alimentation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Pi non riceve abbastanza alimentazione. Le stampe potrebbero scattare; prova un alimentatore migliore."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi-en får ikke nok strøm. Utskrifter kan hakke. Prøv en bedre strømforsyning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Pi krijgt te weinig stroom. Prints kunnen haperen; probeer een betere voeding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi ma za mało zasilania. Wydruki mogą się zacinać; spróbuj lepszego zasilacza."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pi não está a receber energia suficiente. As impressões podem ter falhas; experimente uma fonte de alimentação melhor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pi:n får inte tillräckligt med ström. Utskrifter kan hacka, prova ett bättre nätaggregat."
          }
        }
      }
    },
    "The Raspberry Pi is short of power or too hot. See the Machine tab.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Raspberry Pi má málo napájení nebo je příliš horké. Podívejte se na kartu Stroj."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae'r Raspberry Pi yn brin o bŵer neu'n rhy boeth. Gweler y tab Peiriant."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Raspberry Pi'en mangler strøm eller er for varm. Se fanen Maskine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Raspberry Pi hat zu wenig Strom oder ist zu heiß. Siehe Tab „Gerät“."
