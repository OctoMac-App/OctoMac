            "state": "translated",
            "value": "OctoMac busca una versión nueva una vez al día y pregunta antes de instalarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac etsii uutta versiota kerran päivässä ja kysyy ennen asentamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac recherche une nouvelle version une fois par jour et vous demande avant de l’installer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac cerca una nuova versione una volta al giorno e chiede prima di installarla."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac ser etter en ny versjon én gang om dagen og spør før den installeres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac zoekt eenmaal per dag naar een nieuwe versie en vraagt het je voordat die wordt geïnstalleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac sprawdza raz dziennie, czy jest nowa wersja, i pyta przed jej instalacją."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoMac procura uma nova versão uma vez por dia e pergunta antes de a instalar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac letar efter en ny version en gång om dagen och frågar innan den installeras."
          }
        }
      }
    },
    "OctoMac loses touch with the printer for a minute while OctoPrint starts again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během restartu OctoPrintu ztratí OctoMac na minutu spojení s tiskárnou."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoMac yn colli cysylltiad â'r argraffydd am funud tra mae OctoPrint yn ailgychwyn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac mister kontakten til printeren i et minut, mens OctoPrint starter igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac verliert für eine Minute den Kontakt zum Drucker, während OctoPrint neu startet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac loses touch with the printer for a minute while OctoPrint starts again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac loses touch with the printer for a minute while OctoPrint starts again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac pierde el contacto con la impresora durante un minuto mientras OctoPrint se reinicia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac menettää yhteyden tulostimeen minuutiksi, kun OctoPrint käynnistyy uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac perd le contact avec l’imprimante pendant une minute, le temps qu’OctoPrint redémarre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac perde il contatto con la stampante per un minuto mentre OctoPrint si riavvia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac mister kontakten med skriveren i et minutt mens OctoPrint starter på nytt."
          }
        },
        "nl": {
          "stringUnit": {
