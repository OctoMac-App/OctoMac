          "stringUnit": {
            "state": "translated",
            "value": "Pause or get a notification when the print reaches a layer"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause or get a notification when the print reaches a layer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar o recibir una notificación cuando la impresión llegue a una capa"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä tauko tai saa ilmoitus, kun tulostus saavuttaa kerroksen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire une pause ou recevoir une notification quand l’impression atteint une couche"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in pausa o ricevi una notifica quando la stampa raggiunge un layer"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett på pause eller få et varsel når utskriften når et lag"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzeer of krijg een melding als de print een bepaalde laag bereikt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymaj lub otrzymaj powiadomienie, gdy wydruk osiągnie warstwę"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
