        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint laster ned oppdateringene, installerer dem og starter på nytt. Skriveren forblir tilkoblet, men OctoMac mister kontakten med den i et minutt eller to."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint downloadt de updates, installeert ze en start opnieuw op. De printer blijft verbonden, maar OctoMac verliest een minuut of twee het contact."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint pobierze uaktualnienia, zainstaluje je i uruchomi się ponownie. Drukarka pozostanie połączona, ale OctoMac straci z nią kontakt na minutę lub dwie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint descarrega as atualizações, instala-as e reinicia. A impressora continua ligada, mas o OctoMac perde o contacto com ela durante um ou dois minutos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint hämtar uppdateringarna, installerar dem och startar om. Skrivaren förblir ansluten, men OctoMac tappar kontakten med den en minut eller två."
          }
        }
      }
    },
    "OctoPrint has restarted and the plugin is running.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint se restartoval a plugin běží."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoPrint wedi ailgychwyn ac mae'r ategyn yn rhedeg."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint er genstartet, og pluginnet kører."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint wurde neu gestartet und das Plugin läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint has restarted and the plugin is running."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint has restarted and the plugin is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint se ha reiniciado y el plugin está funcionando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint on käynnistynyt uudelleen ja lisäosa on käytössä."
          }
        },
        "fr": {
