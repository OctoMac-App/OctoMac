    "Add another printer first, then you can send files between them.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve přidejte další tiskárnu, pak mezi nimi můžete posílat soubory."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ychwanegwch argraffydd arall yn gyntaf, yna gallwch chi anfon ffeiliau rhyngddyn nhw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en printer mere først, så kan du sende filer mellem dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge zuerst einen weiteren Drucker hinzu, dann kannst du Dateien zwischen ihnen senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add another printer first, then you can send files between them."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add another printer first, then you can send files between them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade antes otra impresora y podrás enviar archivos entre ellas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää ensin toinen tulostin, niin voit lähettää tiedostoja niiden välillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d’abord une autre imprimante, puis vous pourrez envoyer des fichiers de l’une à l’autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi prima un'altra stampante, poi potrai inviare file dall'una all'altra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en skriver til først, så kan du sende filer mellom dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg eerst nog een printer toe, dan kun je bestanden tussen printers versturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw dodaj kolejną drukarkę, a potem przesyłaj pliki między nimi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione primeiro outra impressora para poder enviar ficheiros entre elas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en skrivare till först, sedan kan du skicka filer mellan dem."
          }
        }
      }
    },
    "Add one in OctoPrint's webcam settings and it'll appear here.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte ji v nastavení webkamery v OctoPrintu a objeví se zde."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ychwanegwch un yng ngosodiadau gwe-gamera OctoPrint a bydd yn ymddangos yma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj et i OctoPrints webcam-indstillinger, så vises det her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge in den Webcam-Einstellungen von OctoPrint eine hinzu, dann erscheint sie hier."
          }
