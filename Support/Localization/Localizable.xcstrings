        }
      }
    },
    "The hotend has to be hot before the printer will push filament.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotend musí být horký, než tiskárna začne vytlačovat filament."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Rhaid i'r hotend fod yn boeth cyn i'r argraffydd wthio ffilament."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotenden skal være varm, før printeren vil skubbe filament frem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hotend muss heiß sein, bevor der Drucker Filament fördert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hotend has to be hot before the printer will push filament."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The hotend has to be hot before the printer will push filament."
          }
        },
        "es": {
