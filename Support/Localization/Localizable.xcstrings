            "value": "OctoPrint nie mógł utworzyć kopii zapasowej: %@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint não conseguiu fazer a cópia de segurança: %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kunde inte göra säkerhetskopian: %@"
          }
        }
      }
    },
    "OctoPrint couldn't restore the backup. The log above may say why.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint nemohl zálohu obnovit. Důvod může uvádět protokol výše."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Methodd OctoPrint ag adfer y copi wrth gefn. Efallai y bydd y log uchod yn dweud pam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kunne ikke gendanne sikkerhedskopien. Loggen ovenfor kan måske forklare hvorfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint konnte das Backup nicht wiederherstellen. Das Protokoll oben nennt vielleicht den Grund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint couldn't restore the backup. The log above may say why."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint couldn't restore the backup. The log above may say why."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint no ha podido restaurar la copia de seguridad. El registro de arriba puede indicar el motivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ei voinut palauttaa varmuuskopiota. Yllä oleva loki voi kertoa syyn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint n’a pas pu restaurer la sauvegarde. Le journal ci-dessus peut indiquer pourquoi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint non è riuscito a ripristinare il backup. Il log qui sopra potrebbe spiegare il motivo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kunne ikke gjenopprette sikkerhetskopien. Loggen over kan si hvorfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kon de back-up niet terugzetten. Het logbestand hierboven zegt misschien waarom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint nie mógł przywrócić kopii zapasowej. Log powyżej może wyjaśnić dlaczego."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint não conseguiu restaurar a cópia de segurança. O registo acima pode indicar porquê."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kunde inte återställa säkerhetskopian. Loggen ovan kan visa varför."
          }
        }
      }
    },
    "OctoPrint didn't say why. The log above may help.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint neuvedl důvod. Může pomoct protokol výše."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Wnaeth OctoPrint ddim dweud pam. Efallai y bydd y log uchod yn helpu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint sagde ikke hvorfor. Loggen ovenfor kan måske hjælpe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint hat keinen Grund genannt. Das Protokoll oben hilft vielleicht weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint didn't say why. The log above may help."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint didn't say why. The log above may help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint no ha dicho por qué. El registro de arriba puede ayudarte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ei kertonut syytä. Yllä oleva loki voi auttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint n’a pas donné de raison. Le journal ci-dessus peut vous aider."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint non ha detto perché. Il registro qui sopra potrebbe aiutare."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint oppga ingen grunn. Loggen over kan hjelpe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint gaf geen reden. Het logboek hierboven kan helpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint nie podał przyczyny. Może pomóc dziennik powyżej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint não indicou o motivo. O registo acima pode ajudar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint angav ingen orsak. Loggen ovan kan hjälpa."
          }
        }
      }
    },
    "OctoPrint doesn't know this file's print time yet, so OctoMac can only start it at a set time.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint zatím nezná dobu tisku tohoto souboru, takže ho OctoMac může spustit jen v určený čas."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dydy OctoPrint ddim yn gwybod amser argraffu'r ffeil hon eto, felly dim ond ar amser penodol y gall OctoMac ei dechrau."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kender endnu ikke denne fils printtid, så OctoMac kan kun starte den på et fast tidspunkt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kennt die Druckzeit dieser Datei noch nicht, daher kann OctoMac sie nur zu einer festen Zeit starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint doesn't know this file's print time yet, so OctoMac can only start it at a set time."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint doesn't know this file's print time yet, so OctoMac can only start it at a set time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint aún no conoce el tiempo de impresión de este archivo, así que OctoMac solo puede empezarlo a una hora fija."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ei vielä tiedä tämän tiedoston tulostusaikaa, joten OctoMac voi aloittaa sen vain tiettynä kellonaikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ne connaît pas encore la durée d’impression de ce fichier, donc OctoMac ne peut le lancer qu’à une heure fixe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint non conosce ancora il tempo di stampa di questo file, quindi OctoMac può solo avviarlo a un orario stabilito."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint vet ikke utskriftstiden for denne filen ennå, så OctoMac kan bare starte den på et bestemt tidspunkt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint weet de printtijd van dit bestand nog niet, dus OctoMac kan het alleen op een vast tijdstip starten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint nie zna jeszcze czasu druku tego pliku, więc OctoMac może go uruchomić tylko o ustalonej godzinie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint ainda não sabe o tempo de impressão deste ficheiro, por isso o OctoMac só o pode iniciar a uma hora definida."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint vet inte den här filens utskriftstid än, så OctoMac kan bara starta den vid en bestämd tid."
          }
        }
      }
    },
    "OctoPrint downloads it from its plugin list and installs it. Plugins are made by the OctoPrint community, not by OctoMac, and most need OctoPrint to restart afterwards.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ho stáhne ze svého seznamu pluginů a nainstaluje. Pluginy vytváří komunita OctoPrintu, ne OctoMac, a většina z nich potřebuje po instalaci restart OctoPrintu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoPrint yn ei lwytho i lawr o'i restr ategion ac yn ei osod. Cymuned OctoPrint sy'n gwneud ategion, nid OctoMac, ac mae angen ailgychwyn OctoPrint wedyn ar y rhan fwyaf."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint henter det fra sin plugin-liste og installerer det. Plugins laves af OctoPrint-fællesskabet, ikke af OctoMac, og de fleste kræver, at OctoPrint genstartes bagefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint lädt es aus seiner Plugin-Liste herunter und installiert es. Plugins stammen aus der OctoPrint-Community, nicht von OctoMac, und die meisten brauchen danach einen Neustart von OctoPrint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint downloads it from its plugin list and installs it. Plugins are made by the OctoPrint community, not by OctoMac, and most need OctoPrint to restart afterwards."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint downloads it from its plugin list and installs it. Plugins are made by the OctoPrint community, not by OctoMac, and most need OctoPrint to restart afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint lo descarga de su lista de plugins y lo instala. Los plugins los crea la comunidad de OctoPrint, no OctoMac, y la mayoría necesitan reiniciar OctoPrint después."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint lataa sen lisäosaluettelostaan ja asentaa sen. Lisäosat tekee OctoPrint-yhteisö, ei OctoMac, ja useimmat vaativat OctoPrintin uudelleenkäynnistyksen asennuksen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint le télécharge depuis sa liste de plugins et l’installe. Les plugins sont créés par la communauté OctoPrint, pas par OctoMac, et la plupart nécessitent ensuite un redémarrage d’OctoPrint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint lo scarica dal suo elenco di plugin e lo installa. I plugin sono realizzati dalla comunità di OctoPrint, non da OctoMac, e la maggior parte richiede poi un riavvio di OctoPrint."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint laster den ned fra plugin-listen sin og installerer den. Plugins lages av OctoPrint-fellesskapet, ikke av OctoMac, og de fleste krever at OctoPrint startes på nytt etterpå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint downloadt hem uit de pluginlijst en installeert hem. Plugins worden gemaakt door de OctoPrint-community, niet door OctoMac, en de meeste hebben daarna een herstart van OctoPrint nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint pobierze ją ze swojej listy wtyczek i zainstaluje. Wtyczki tworzy społeczność OctoPrint, a nie OctoMac, i większość z nich wymaga potem ponownego uruchomienia OctoPrint."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint transfere-o da sua lista de plugins e instala-o. Os plugins são criados pela comunidade do OctoPrint, não pelo OctoMac, e a maioria precisa de reiniciar o OctoPrint depois."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint hämtar det från sin pluginlista och installerar det. Plugins görs av OctoPrint-communityn, inte av OctoMac, och de flesta kräver att OctoPrint startas om efteråt."
          }
        }
      }
    },
    "OctoPrint downloads the update, installs it and restarts. The printer stays connected, but OctoMac loses touch with it for a minute or two.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint stáhne aktualizaci, nainstaluje ji a restartuje se. Tiskárna zůstane připojená, ale OctoMac s ní na minutu nebo dvě ztratí spojení."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoPrint yn llwytho'r diweddariad i lawr, yn ei osod ac yn ailgychwyn. Mae'r argraffydd yn aros wedi'i gysylltu, ond mae OctoMac yn colli cysylltiad ag ef am funud neu ddau."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint henter opdateringen, installerer den og genstarter. Printeren forbliver forbundet, men OctoMac mister kontakten til den i et minut eller to."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint lädt das Update herunter, installiert es und startet neu. Der Drucker bleibt verbunden, aber OctoMac verliert für ein bis zwei Minuten den Kontakt zu ihm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint downloads the update, installs it and restarts. The printer stays connected, but OctoMac loses touch with it for a minute or two."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint downloads the update, installs it and restarts. The printer stays connected, but OctoMac loses touch with it for a minute or two."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint descarga la actualización, la instala y se reinicia. La impresora sigue conectada, pero OctoMac pierde el contacto con ella durante un minuto o dos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint lataa päivityksen, asentaa sen ja käynnistyy uudelleen. Tulostin pysyy yhdistettynä, mutta OctoMac menettää yhteyden siihen minuutiksi tai kahdeksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint télécharge la mise à jour, l’installe et redémarre. L’imprimante reste connectée, mais OctoMac perd le contact avec elle pendant une minute ou deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint scarica l'aggiornamento, lo installa e si riavvia. La stampante resta connessa, ma OctoMac perde il contatto per un minuto o due."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint laster ned oppdateringen, installerer den og starter på nytt. Skriveren forblir tilkoblet, men OctoMac mister kontakten med den i et minutt eller to."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint downloadt de update, installeert die en start opnieuw op. De printer blijft verbonden, maar OctoMac verliest een minuut of twee het contact."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint pobierze uaktualnienie, zainstaluje je i uruchomi się ponownie. Drukarka pozostanie połączona, ale OctoMac straci z nią kontakt na minutę lub dwie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint descarrega a atualização, instala-a e reinicia. A impressora continua ligada, mas o OctoMac perde o contacto com ela durante um ou dois minutos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint hämtar uppdateringen, installerar den och startar om. Skrivaren förblir ansluten, men OctoMac tappar kontakten med den en minut eller två."
          }
        }
      }
    },
    "OctoPrint downloads the updates, installs them and restarts. The printer stays connected, but OctoMac loses touch with it for a minute or two.": {
      "localizations": {
        "cs": {
          "stringUnit": {
