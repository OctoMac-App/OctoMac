    "Releases the motors so you can move the head and bed by hand.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvolní motory, abyste mohli hlavou a podložkou pohybovat ručně."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn rhyddhau'r moduron fel y gallwch chi symud y pen a'r gwely â llaw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slipper motorerne, så du kan flytte hovedet og pladen med hånden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt die Motoren frei, damit du Kopf und Bett von Hand bewegen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Releases the motors so you can move the head and bed by hand."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Releases the motors so you can move the head and bed by hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera los motores para que puedas mover el cabezal y la cama a mano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vapauttaa moottorit, jotta voit liikuttaa päätä ja alustaa käsin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libère les moteurs pour déplacer la tête et le plateau à la main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascia i motori così puoi muovere a mano la testina e il piatto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slipper motorene så du kan flytte hodet og platen for hånd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
