    "Extrusion flow (M221). Small changes help with over or under extrusion.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Průtok extruze (M221). Malé změny pomáhají při přeextrudování nebo podextrudování."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Llif allwthio (M221). Mae newidiadau bach yn helpu gyda gor-allwthio neu dan-allwthio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstruderingsflow (M221). Små ændringer hjælper mod over- eller underekstrudering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrusionsfluss (M221). Kleine Änderungen helfen bei Über- oder Unterextrusion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrusion flow (M221). Small changes help with over or under extrusion."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrusion flow (M221). Small changes help with over or under extrusion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flujo de extrusión (M221). Los pequeños cambios ayudan con la sobreextrusión o la subextrusión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pursotusvirtaus (M221). Pienet muutokset auttavat yli- tai alipursotukseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débit d’extrusion (M221). De petits ajustements aident en cas de sur ou sous-extrusion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Flusso di estrusione (M221). Piccole modifiche aiutano con la sovra o sottoestrusione."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstruderingsflyt (M221). Små endringer hjelper mot over- eller underekstrudering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrusieflow (M221). Kleine aanpassingen helpen bij over- of onderextrusie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepływ ekstruzji (M221). Drobne zmiany pomagają przy nad- lub podekstruzji."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluxo de extrusão (M221). Pequenas alterações ajudam em caso de sobre ou subextrusão."
          }
        },
        "sv": {
