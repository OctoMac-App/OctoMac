        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowuj klucze API w pęku kluczy"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar chaves da API no Porta-chaves"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara API-nycklar i nyckelringen"
          }
        }
      }
    },
    "Keep a command you use often as a button here, for this printer. Right-click a button to change it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příkaz, který často používáte, si tu můžete uložit jako tlačítko pro tuto tiskárnu. Kliknutím pravým tlačítkem ho změníte."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadwch orchymyn rydych chi'n ei ddefnyddio'n aml fel botwm yma, ar gyfer yr argraffydd hwn. De-gliciwch ar fotwm i'w newid."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem en kommando, du ofte bruger, som en knap her til denne printer. Højreklik på en knap for at ændre den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg einen Befehl, den du oft brauchst, hier als Taste für diesen Drucker ab. Klicke mit der rechten Maustaste auf eine Taste, um sie zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a command you use often as a button here, for this printer. Right-click a button to change it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a command you use often as a button here, for this printer. Right-click a button to change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda aquí como botón un comando que uses a menudo, para esta impresora. Haz clic con el botón derecho en un botón para cambiarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna usein käyttämäsi komento tähän painikkeeksi tälle tulostimelle. Voit muuttaa painiketta osoittamalla sitä hiiren oikealla painikkeella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez ici sous forme de bouton une commande que vous utilisez souvent, pour cette imprimante. Cliquez sur un bouton avec le bouton droit pour le modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni qui come pulsante un comando che usi spesso, per questa stampante. Fai clic con il tasto destro su un pulsante per modificarlo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha en kommando du bruker ofte som en knapp her, for denne skriveren. Høyreklikk på en knapp for å endre den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar een commando dat je vaak gebruikt hier als knop, voor deze printer. Klik met de rechtermuisknop op een knop om hem te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj tu często używane polecenie jako przycisk dla tej drukarki. Kliknij przycisk prawym przyciskiem myszy, aby go zmienić."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde aqui como botão um comando que use com frequência, para esta impressora. Clique num botão com o botão direito para o alterar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara ett kommando du använder ofta som en knapp här, för den här skrivaren. Högerklicka på en knapp för att ändra den."
          }
        }
      }
    },
    "Keep in the printer": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložit do tiskárny"
          }
        },
