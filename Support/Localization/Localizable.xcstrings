    "You're about to shut down the Raspberry Pi. You'll need to switch it on again yourself.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chystáte se vypnout Raspberry Pi. Znovu ho budete muset zapnout sami."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Rydych chi ar fin diffodd y Raspberry Pi. Bydd angen i chi ei droi ymlaen eto eich hun."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er ved at lukke Raspberry Pi'en ned. Du skal selv tænde den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist dabei, den Raspberry Pi herunterzufahren. Du musst ihn danach selbst wieder einschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're about to shut down the Raspberry Pi. You'll need to switch it on again yourself."
          }
        },
        "en-GB": {
