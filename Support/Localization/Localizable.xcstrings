    "Pause or get a notification when the print reaches a layer": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastavit nebo dostat oznámení, když tisk dosáhne vrstvy"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Seibio neu gael hysbysiad pan fydd yr argraffiad yn cyrraedd haen"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt på pause eller få en notifikation, når printet når et lag"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausieren oder benachrichtigt werden, wenn der Druck eine Schicht erreicht"
          }
        },
