            "state": "translated",
            "value": "Als een print mislukt of vanaf de printer wordt gestopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy wydruk się nie uda lub zostanie zatrzymany z drukarki."
          }
        },
        "pt-PT": {
