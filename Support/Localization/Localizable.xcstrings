    "Plan when to print: finish by a time that suits you": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naplánujte, kdy tisknout: dokončení v čase, který vám vyhovuje"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Cynllunio pryd i argraffu: gorffen erbyn amser sy'n gyfleus i chi"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlæg, hvornår der skal printes: bliv færdig på et tidspunkt, der passer dig"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Druck planen: zu einer Zeit fertig, die dir passt"
          }
        },
        "en": {
