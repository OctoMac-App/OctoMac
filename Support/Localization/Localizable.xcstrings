    "Moves in a straight line. G0 is for travel, G1 for printing moves. F sets the speed in mm per minute.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohyb po přímce. G0 je pro přejezdy, G1 pro tiskové pohyby. F nastavuje rychlost v mm za minutu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn symud mewn llinell syth. Mae G0 ar gyfer teithio, G1 ar gyfer symudiadau argraffu. Mae F yn gosod y cyflymder mewn mm y funud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevæger sig i en lige linje. G0 er til transport, G1 til printbevægelser. F angiver hastigheden i mm pr. minut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fährt in einer geraden Linie. G0 ist für Leerfahrten, G1 für Druckbewegungen. F setzt die Geschwindigkeit in mm pro Minute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves in a straight line. G0 is for travel, G1 for printing moves. F sets the speed in mm per minute."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves in a straight line. G0 is for travel, G1 for printing moves. F sets the speed in mm per minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mueve en línea recta. G0 es para desplazamientos, G1 para movimientos de impresión. F fija la velocidad en mm por minuto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikkuu suoraa linjaa. G0 on siirtoliikkeille, G1 tulostusliikkeille. F asettaa nopeuden millimetreinä minuutissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se déplace en ligne droite. G0 sert aux déplacements à vide, G1 aux mouvements d’impression. F définit la vitesse en mm par minute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si muove in linea retta. G0 è per gli spostamenti, G1 per i movimenti di stampa. F imposta la velocità in mm al minuto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beveger seg i en rett linje. G0 er for forflytning, G1 for utskriftsbevegelser. F angir hastigheten i mm per minutt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweegt in een rechte lijn. G0 is voor verplaatsingen, G1 voor printbewegingen. F stelt de snelheid in, in mm per minuut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruch po linii prostej. G0 służy do przejazdów, G1 do ruchów drukujących. F ustawia prędkość w mm na minutę."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Move-se em linha reta. G0 é para deslocações, G1 para movimentos de impressão. F define a velocidade em mm por minuto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rör sig i en rak linje. G0 är för förflyttningar, G1 för utskriftsrörelser. F anger hastigheten i mm per minut."
          }
        }
      }
    },
    "Moves in this layer": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohyby v této vrstvě"
          }
        },
        "cy": {
          "stringUnit": {
