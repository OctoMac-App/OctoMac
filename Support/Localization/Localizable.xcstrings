    "How far each point has moved since the earlier measurement. Above zero is higher now.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "O kolik se každý bod posunul od dřívějšího měření. Nad nulou je teď výš."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Faint mae pob pwynt wedi symud ers y mesuriad cynharach. Mae uwchben sero yn uwch nawr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor meget hvert punkt har flyttet sig siden den tidligere måling. Over nul er højere nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit sich jeder Punkt seit der früheren Messung verschoben hat. Über null ist jetzt höher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far each point has moved since the earlier measurement. Above zero is higher now."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "How far each point has moved since the earlier measurement. Above zero is higher now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto se ha movido cada punto desde la medición anterior. Por encima de cero está ahora más alto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka paljon kukin piste on siirtynyt aiemman mittauksen jälkeen. Yli nollan tarkoittaa, että se on nyt korkeammalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De combien chaque point a bougé depuis la mesure précédente. Au-dessus de zéro, il est plus haut maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto si è spostato ogni punto dalla misurazione precedente. Sopra lo zero significa più alto ora."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor langt hvert punkt har flyttet seg siden den forrige målingen. Over null betyr høyere nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel elk punt is verschoven sinds de eerdere meting. Boven nul is nu hoger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak bardzo każdy punkt przesunął się od wcześniejszego pomiaru. Powyżej zera oznacza, że teraz jest wyżej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto cada ponto se deslocou desde a medição anterior. Acima de zero significa que agora está mais alto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur långt varje punkt har flyttats sedan den tidigare mätningen. Över noll betyder högre nu."
          }
        }
      }
    },
