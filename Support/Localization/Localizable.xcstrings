    "Switch camera, save or copy a snapshot, or record a clip": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepnout kameru, uložit nebo zkopírovat snímek, nebo nahrát klip"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Newid camera, cadw neu gopïo ciplun, neu recordio clip"
          }
        },
        "da": {
