    "You're about to reboot the Raspberry Pi.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chystáte se restartovat Raspberry Pi."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Rydych chi ar fin ailgychwyn y Raspberry Pi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er ved at genstarte Raspberry Pi'en."
