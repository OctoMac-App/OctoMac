    "A camera picture once the first layer is down, so you can catch a bad start early.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímek z kamery po dokončení první vrstvy, abyste špatný začátek zachytili včas."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Llun camera unwaith mae'r haen gyntaf i lawr, er mwyn i chi sylwi ar ddechrau gwael yn gynnar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et kamerabillede, når det første lag er lagt, så du hurtigt kan fange en dårlig start."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kamerabild, sobald die erste Schicht liegt, damit du einen schlechten Start früh bemerkst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A camera picture once the first layer is down, so you can catch a bad start early."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A camera picture once the first layer is down, so you can catch a bad start early."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una imagen de la cámara cuando termina la primera capa, para detectar a tiempo un mal comienzo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerakuva, kun ensimmäinen kerros on valmis, jotta huomaat huonon alun ajoissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une photo de la caméra une fois la première couche posée, pour repérer tôt un mauvais départ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'immagine della videocamera appena finito il primo layer, così puoi accorgerti subito di una partenza sbagliata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et kamerabilde når første lag er lagt, så du kan oppdage en dårlig start tidlig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een camerabeeld zodra de eerste laag erop ligt, zodat je een slechte start vroeg ziet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie z kamery po ułożeniu pierwszej warstwy, żeby szybko wychwycić zły start."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma imagem da câmara assim que a primeira camada estiver feita, para detetar cedo um mau início."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En kamerabild när första lagret är klart, så att du upptäcker en dålig start i tid."
          }
        }
      }
    },
