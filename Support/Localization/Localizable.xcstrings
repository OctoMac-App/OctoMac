    "The camera didn't send any pictures. Check it's working, then try again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera neposlala žádné snímky. Zkontrolujte, že funguje, a zkuste to znovu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni anfonodd y camera unrhyw luniau. Gwiriwch ei fod yn gweithio, yna rhowch gynnig arall arni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraet sendte ingen billeder. Tjek, at det virker, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera hat keine Bilder gesendet. Prüfe, ob sie funktioniert, und versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera didn't send any pictures. Check it's working, then try again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera didn't send any pictures. Check it's working, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no ha enviado ninguna imagen. Comprueba que funciona y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
