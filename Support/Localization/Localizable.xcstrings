    "The printer is busy with a print. Wait for it to finish, or stop it first.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiskárna právě tiskne. Počkejte, až skončí, nebo tisk nejdřív zastavte."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae'r argraffydd yn brysur gydag argraffiad. Arhoswch iddo orffen, neu stopiwch ef yn gyntaf."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Printeren er optaget af et print. Vent, til det er færdigt, eller stop det først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Drucker ist mit einem Druck beschäftigt. Warte, bis er fertig ist, oder stoppe ihn zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer is busy with a print. Wait for it to finish, or stop it first."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer is busy with a print. Wait for it to finish, or stop it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora está ocupada con una impresión. Espera a que termine o detenla primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulostin on varattu tulostukseen. Odota, että se valmistuu, tai pysäytä se ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’imprimante est occupée par une impression. Attendez qu’elle se termine, ou arrêtez-la d’abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stampante è occupata con una stampa. Aspetta che finisca o interrompila prima."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriveren er opptatt med en utskrift. Vent til den er ferdig, eller stopp den først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De printer is bezig met een print. Wacht tot die klaar is, of stop hem eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drukarka jest zajęta wydrukiem. Poczekaj, aż się skończy, lub najpierw go zatrzymaj."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A impressora está ocupada com uma impressão. Espere que termine ou pare-a primeiro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivaren är upptagen med en utskrift. Vänta tills den är klar, eller stoppa den först."
          }
        }
      }
    },
    "The printer is waiting. Your answer is sent to it straight away.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiskárna čeká. Vaše odpověď se jí hned odešle."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae'r argraffydd yn aros. Bydd eich ateb yn cael ei anfon ato ar unwaith."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Printeren venter. Dit svar sendes til den med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Drucker wartet. Deine Antwort wird sofort an ihn gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer is waiting. Your answer is sent to it straight away."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer is waiting. Your answer is sent to it straight away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora está esperando. Tu respuesta se le envía al momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
