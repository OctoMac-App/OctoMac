          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella e tutto il suo contenuto verranno eliminati dalla stampante. Questa azione non può essere annullata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
