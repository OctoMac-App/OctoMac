            "value": "Når et print mislykkes eller stoppes fra printeren."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Druck fehlschlägt oder am Drucker gestoppt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a print fails, or is stopped from the printer."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When a print fails, or is stopped from the printer."
          }
        },
        "es": {
          "stringUnit": {
