          "stringUnit": {
            "state": "translated",
            "value": "Kun tulostus epäonnistuu tai se pysäytetään tulostimelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une impression échoue ou est arrêtée depuis l’imprimante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando una stampa non riesce o viene interrotta dalla stampante."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en utskrift mislykkes eller blir stoppet fra skriveren."
          }
        },
        "nl": {
