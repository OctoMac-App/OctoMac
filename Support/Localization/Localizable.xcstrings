    "Add your first OctoPrint server to get started. You'll need its address, like octopi.local.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začněte přidáním prvního serveru OctoPrint. Budete potřebovat jeho adresu, například octopi.local."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ychwanegwch eich gweinydd OctoPrint cyntaf i ddechrau. Bydd angen ei gyfeiriad arnoch chi, fel octopi.local."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj din første OctoPrint-server for at komme i gang. Du skal bruge dens adresse, f.eks. octopi.local."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deinen ersten OctoPrint-Server hinzu, um loszulegen. Du brauchst seine Adresse, z. B. octopi.local."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your first OctoPrint server to get started. You'll need its address, like octopi.local."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your first OctoPrint server to get started. You'll need its address, like octopi.local."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu primer servidor OctoPrint para empezar. Necesitarás su dirección, como octopi.local."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita lisäämällä ensimmäinen OctoPrint-palvelimesi. Tarvitset sen osoitteen, esimerkiksi octopi.local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre premier serveur OctoPrint pour commencer. Il vous faudra son adresse, par exemple octopi.local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il tuo primo server OctoPrint per iniziare. Ti servirà il suo indirizzo, ad esempio octopi.local."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til din første OctoPrint-server for å komme i gang. Du trenger adressen, for eksempel octopi.local."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg je eerste OctoPrint-server toe om te beginnen. Je hebt het adres nodig, zoals octopi.local."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj swój pierwszy serwer OctoPrint, aby zacząć. Potrzebny będzie jego adres, np. octopi.local."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o seu primeiro servidor OctoPrint para começar. Vai precisar do endereço, como octopi.local."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till din första OctoPrint-server för att komma igång. Du behöver dess adress, t.ex. octopi.local."
          }
        }
      }
    },
