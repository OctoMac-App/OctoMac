    "If your slicer lifts the nozzle when it retracts, set this to that height so a hop isn't taken as a new layer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud slicer při retrakci zvedá trysku, nastavte sem tuto výšku, aby se zdvih nepovažoval za novou vrstvu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Os yw eich sleisiwr yn codi'r ffroenell wrth dynnu'n ôl, gosodwch hwn i'r uchder hwnnw fel nad yw hop yn cael ei gyfrif fel haen newydd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis din slicer løfter dysen ved tilbagetrækning, så sæt dette til den højde, så et hop ikke opfattes som et nyt lag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein Slicer die Düse beim Rückzug anhebt, stell hier diese Höhe ein, damit ein Hop nicht als neue Schicht gilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your slicer lifts the nozzle when it retracts, set this to that height so a hop isn't taken as a new layer."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If your slicer lifts the nozzle when it retracts, set this to that height so a hop isn't taken as a new layer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu slicer levanta la boquilla al retraer, pon aquí esa altura para que un salto no cuente como una capa nueva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos slicer nostaa suutinta takaisinvedon aikana, aseta tähän sama korkeus, jotta hyppyä ei tulkita uudeksi kerrokseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre slicer lève la buse lors des rétractions, indiquez ici cette hauteur pour qu’un saut ne soit pas pris pour une nouvelle couche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lo slicer solleva l'ugello durante la retrazione, imposta qui quell'altezza, così un salto non viene preso per un nuovo layer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis sliceren løfter dysen når den trekker tilbake, setter du dette til den høyden, så et hopp ikke tolkes som et nytt lag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je slicer de nozzle optilt bij het terugtrekken, stel dit dan in op die hoogte, zodat een hop niet als een nieuwe laag telt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli slicer podnosi dyszę przy retrakcji, ustaw tu tę wysokość, aby podniesienie nie zostało uznane za nową warstwę."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o seu slicer levanta o bico ao retrair, defina aqui essa altura para que um salto não seja tomado por uma nova camada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om din slicer lyfter munstycket vid retraktion, ställ in den höjden här så att ett hopp inte räknas som ett nytt lager."
          }
        }
      }
    },
