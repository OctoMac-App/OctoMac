        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas a apagar la Raspberry Pi. Tendrás que volver a encenderla tú."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet sammuttamassa Raspberry Pi:n. Sinun täytyy kytkeä se itse uudelleen päälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes sur le point d’éteindre le Raspberry Pi. Vous devrez le rallumer vous-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai per spegnere il Raspberry Pi. Dovrai riaccenderlo tu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er i ferd med å slå av Raspberry Pi-en. Du må slå den på igjen selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je staat op het punt de Raspberry Pi uit te zetten. Je moet hem daarna zelf weer aanzetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za chwilę wyłączysz Raspberry Pi. Trzeba będzie samodzielnie włączyć je ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai encerrar o Raspberry Pi. Terá de o voltar a ligar manualmente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du håller på att stänga av Raspberry Pi. Du måste slå på den igen själv."
          }
        }
      }
    },
    "Your G-code files. Leave them out for a much smaller backup.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše soubory G-code. Bez nich bude záloha mnohem menší."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Eich ffeiliau G-code. Gadewch nhw allan i gael copi wrth gefn llawer llai."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine G-code-filer. Udelad dem for en meget mindre sikkerhedskopi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine G-code-Dateien. Ohne sie wird das Backup viel kleiner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your G-code files. Leave them out for a much smaller backup."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your G-code files. Leave them out for a much smaller backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus archivos G-code. Déjalos fuera para una copia mucho más pequeña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "G-code-tiedostosi. Jätä ne pois, niin varmuuskopio on paljon pienempi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos fichiers G-code. Excluez-les pour une sauvegarde bien plus légère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi file G-code. Escludili per un backup molto più piccolo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "G-code-filene dine. Utelat dem for en mye mindre sikkerhetskopi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je G-code-bestanden. Laat ze weg voor een veel kleinere back-up."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje pliki G-code. Pomiń je, a kopia będzie znacznie mniejsza."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus ficheiros G-code. Deixe-os de fora para uma cópia muito mais pequena."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina G-code-filer. Utelämna dem för en mycket mindre säkerhetskopia."
          }
        }
      }
    },
    "Your Mac is online, but macOS isn't letting OctoMac reach your printers. This can happen after an update. In Privacy & Security, open Local Network, then switch OctoMac off and on again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš Mac je online, ale macOS nedovoluje OctoMacu přístup k tiskárnám. To se může stát po aktualizaci. V Soukromí a zabezpečení otevřete Místní síť a pak OctoMac vypněte a znovu zapněte."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae eich Mac ar-lein, ond dydy macOS ddim yn gadael i OctoMac gyrraedd eich argraffwyr. Gall hyn ddigwydd ar ôl diweddariad. Yn Preifatrwydd a Diogelwch, agorwch Rhwydwaith Lleol, yna diffoddwch OctoMac a'i droi ymlaen eto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Mac er online, men macOS lader ikke OctoMac nå dine printere. Det kan ske efter en opdatering. Åbn Lokalt netværk under Anonymitet og sikkerhed, og slå så OctoMac fra og til igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac ist online, aber macOS lässt OctoMac deine Drucker nicht erreichen. Das kann nach einem Update passieren. Öffne unter „Datenschutz & Sicherheit“ den Bereich „Lokales Netzwerk“ und schalte OctoMac dort aus und wieder ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac is online, but macOS isn't letting OctoMac reach your printers. This can happen after an update. In Privacy & Security, open Local Network, then switch OctoMac off and on again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac is online, but macOS isn't letting OctoMac reach your printers. This can happen after an update. In Privacy & Security, open Local Network, then switch OctoMac off and on again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac tiene conexión, pero macOS no deja que OctoMac llegue a tus impresoras. Puede pasar tras una actualización. En Privacidad y seguridad, abre Red local y desactiva y vuelve a activar OctoMac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Macisi on verkossa, mutta macOS ei anna OctoMacin tavoittaa tulostimiasi. Näin voi käydä päivityksen jälkeen. Avaa Yksityisyys ja turvallisuus -kohdassa Paikallisverkko ja laita OctoMac pois ja takaisin päälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac est en ligne, mais macOS empêche OctoMac d’accéder à vos imprimantes. Cela peut arriver après une mise à jour. Dans Confidentialité et sécurité, ouvrez Réseau local, puis désactivez et réactivez OctoMac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac è online, ma macOS non permette a OctoMac di raggiungere le stampanti. Può succedere dopo un aggiornamento. In Privacy e sicurezza, apri Rete locale, poi disattiva e riattiva OctoMac."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Macen din er tilkoblet, men macOS lar ikke OctoMac nå skriverne dine. Dette kan skje etter en oppdatering. Åpne Lokalt nettverk under Personvern og sikkerhet, og slå OctoMac av og på igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Mac is online, maar macOS laat OctoMac je printers niet bereiken. Dit kan gebeuren na een update. Open in ‘Privacy en beveiliging’ de optie ‘Lokaal netwerk’ en zet OctoMac uit en weer aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój Mac jest online, ale macOS nie pozwala OctoMac łączyć się z drukarkami. Może się tak zdarzyć po uaktualnieniu. W sekcji Prywatność i ochrona otwórz Sieć lokalna, a potem wyłącz i ponownie włącz OctoMac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac está online, mas o macOS não está a deixar o OctoMac aceder às impressoras. Pode acontecer após uma atualização. Em Privacidade e segurança, abra Rede local e depois desative e volte a ativar o OctoMac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Mac är online, men macOS låter inte OctoMac nå dina skrivare. Det kan hända efter en uppdatering. Öppna Lokalt nätverk under Integritet och säkerhet och slå sedan av och på OctoMac igen."
          }
        }
      }
    },
    "Your OctoPrint account doesn't have permission to do that.": {
