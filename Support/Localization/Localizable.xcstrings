    "OctoPrint can't install plugins on this system, because it couldn't find pip.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint nemůže v tomto systému instalovat pluginy, protože nenašel pip."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dydy OctoPrint ddim yn gallu gosod ategion ar y system hon, am nad oedd yn gallu dod o hyd i pip."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kan ikke installere plugins på dette system, fordi det ikke kunne finde pip."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kann auf diesem System keine Plugins installieren, weil es pip nicht gefunden hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint can't install plugins on this system, because it couldn't find pip."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint can't install plugins on this system, because it couldn't find pip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint no puede instalar plugins en este sistema porque no ha encontrado pip."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ei voi asentaa lisäosia tähän järjestelmään, koska se ei löytänyt pipiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ne peut pas installer de plugins sur ce système, car il n’a pas trouvé pip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint non può installare plugin su questo sistema perché non ha trovato pip."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kan ikke installere utvidelser på dette systemet, fordi den ikke fant pip."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kan op dit systeem geen plug-ins installeren, omdat pip niet gevonden is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint nie może instalować wtyczek w tym systemie, bo nie znalazł pip."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint não pode instalar plugins neste sistema, porque não encontrou o pip."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kan inte installera plugin på det här systemet eftersom det inte hittade pip."
          }
        }
      }
    },
    "OctoPrint can't reach the internet, so it can't download plugins.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint se nemůže připojit k internetu, takže nemůže stahovat pluginy."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dydy OctoPrint ddim yn gallu cyrraedd y rhyngrwyd, felly dydy e ddim yn gallu llwytho ategion i lawr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kan ikke nå internettet og kan derfor ikke hente plugins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint erreicht das Internet nicht und kann daher keine Plugins herunterladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint can't reach the internet, so it can't download plugins."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint can't reach the internet, so it can't download plugins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint no tiene acceso a internet, así que no puede descargar plugins."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ei saa yhteyttä internetiin, joten se ei voi ladata lisäosia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint n’a pas accès à Internet, il ne peut donc pas télécharger de plugins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint non riesce a raggiungere internet, quindi non può scaricare plugin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint når ikke internett, så den kan ikke laste ned utvidelser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kan het internet niet bereiken en kan dus geen plug-ins downloaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint nie ma dostępu do internetu, więc nie może pobierać wtyczek."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint não consegue aceder à internet, por isso não pode descarregar plugins."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint når inte internet och kan därför inte hämta plugin."
          }
        }
      }
    },
    "OctoPrint connects to the printer by itself after the Raspberry Pi starts, with the settings it last used": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint se po spuštění Raspberry Pi sám připojí k tiskárně s naposledy použitým nastavením"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoPrint yn cysylltu â'r argraffydd ar ei ben ei hun ar ôl i'r Raspberry Pi ddechrau, gyda'r gosodiadau a ddefnyddiodd ddiwethaf"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint forbinder selv til printeren, når Raspberry Pi'en starter, med de indstillinger, det sidst brugte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint verbindet sich nach dem Start des Raspberry Pi von selbst mit dem Drucker, mit den zuletzt verwendeten Einstellungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint connects to the printer by itself after the Raspberry Pi starts, with the settings it last used"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint connects to the printer by itself after the Raspberry Pi starts, with the settings it last used"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint se conecta solo a la impresora cuando arranca la Raspberry Pi, con los últimos ajustes que usó"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint yhdistää tulostimeen itsestään, kun Raspberry Pi käynnistyy, viimeksi käyttämillään asetuksilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint se connecte tout seul à l’imprimante au démarrage du Raspberry Pi, avec les derniers réglages utilisés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint si connette da solo alla stampante all'avvio del Raspberry Pi, con le ultime impostazioni usate"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kobler seg til skriveren av seg selv når Raspberry Pi starter, med innstillingene den brukte sist"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint maakt zelf verbinding met de printer nadat de Raspberry Pi is opgestart, met de laatst gebruikte instellingen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint sam łączy się z drukarką po uruchomieniu Raspberry Pi, używając ostatnich ustawień"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint liga-se à impressora sozinho depois de o Raspberry Pi iniciar, com as últimas definições usadas"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ansluter till skrivaren av sig självt när Raspberry Pi har startat, med de inställningar det senast använde"
          }
        }
      }
    },
    "OctoPrint couldn't fetch the plugin list. Check the Raspberry Pi can reach the internet.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint nemohl načíst seznam pluginů. Zkontrolujte, že se Raspberry Pi může připojit k internetu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Doedd OctoPrint ddim yn gallu nôl y rhestr ategion. Gwiriwch fod y Raspberry Pi yn gallu cyrraedd y rhyngrwyd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kunne ikke hente pluginlisten. Tjek, at Raspberry Pi'en kan nå internettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint konnte die Plugin-Liste nicht laden. Prüfe, ob der Raspberry Pi das Internet erreicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint couldn't fetch the plugin list. Check the Raspberry Pi can reach the internet."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint couldn't fetch the plugin list. Check the Raspberry Pi can reach the internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint no ha podido obtener la lista de plugins. Comprueba que la Raspberry Pi tenga acceso a internet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ei voinut hakea lisäosaluetteloa. Tarkista, että Raspberry Pi saa yhteyden internetiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint n’a pas pu récupérer la liste des plugins. Vérifiez que le Raspberry Pi a accès à Internet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint non è riuscito a recuperare l'elenco dei plugin. Controlla che il Raspberry Pi possa raggiungere internet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kunne ikke hente utvidelseslisten. Sjekk at Raspberry Pi-en når internett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kon de plug-inlijst niet ophalen. Controleer of de Raspberry Pi het internet kan bereiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint nie mógł pobrać listy wtyczek. Sprawdź, czy Raspberry Pi ma dostęp do internetu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint não conseguiu obter a lista de plugins. Verifique se o Raspberry Pi consegue aceder à internet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kunde inte hämta pluginlistan. Kontrollera att Raspberry Pi når internet."
          }
        }
      }
    },
    "OctoPrint couldn't find the printer on any USB port. Check the printer is switched on and its USB cable is plugged in, then connect.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint nenašel tiskárnu na žádném portu USB. Zkontrolujte, že je tiskárna zapnutá a kabel USB je zapojený, a pak se připojte."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Methodd OctoPrint â dod o hyd i'r argraffydd ar unrhyw borth USB. Gwiriwch fod yr argraffydd ymlaen a bod ei gebl USB wedi'i blygio i mewn, yna cysylltwch."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kunne ikke finde printeren på nogen USB-port. Tjek, at printeren er tændt og USB-kablet sat i, og forbind så."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint hat den Drucker an keinem USB-Anschluss gefunden. Prüfe, ob der Drucker eingeschaltet und sein USB-Kabel eingesteckt ist, und verbinde dann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint couldn't find the printer on any USB port. Check the printer is switched on and its USB cable is plugged in, then connect."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint couldn't find the printer on any USB port. Check the printer is switched on and its USB cable is plugged in, then connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint no ha encontrado la impresora en ningún puerto USB. Comprueba que la impresora está encendida y su cable USB conectado, y luego conecta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ei löytänyt tulostinta mistään USB-portista. Tarkista, että tulostin on päällä ja sen USB-kaapeli on kiinni, ja yhdistä sitten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint n’a trouvé l’imprimante sur aucun port USB. Vérifiez que l’imprimante est allumée et que son câble USB est branché, puis connectez-la."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint non ha trovato la stampante su nessuna porta USB. Controlla che la stampante sia accesa e il cavo USB collegato, poi connettiti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint fant ikke skriveren på noen USB-port. Sjekk at skriveren er slått på og at USB-kabelen er koblet til, og koble deretter til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kon de printer op geen enkele USB-poort vinden. Controleer of de printer aanstaat en de USB-kabel is aangesloten, en maak dan verbinding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint nie znalazł drukarki na żadnym porcie USB. Sprawdź, czy drukarka jest włączona, a kabel USB podłączony, a potem połącz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint não encontrou a impressora em nenhuma porta USB. Verifique se a impressora está ligada e o cabo USB bem encaixado e depois clique em Ligar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint hittade inte skrivaren på någon USB-port. Kontrollera att skrivaren är påslagen och att USB-kabeln är ansluten, och anslut sedan."
          }
        }
      }
    },
