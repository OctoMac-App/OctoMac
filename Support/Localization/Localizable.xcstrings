    "A hot Pi slows down. A small heatsink or fan helps.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehřáté Pi se zpomalí. Pomůže malý chladič nebo ventilátor."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae Pi poeth yn arafu. Mae sinc gwres bach neu ffan yn helpu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En varm Pi bliver langsom. En lille køleplade eller blæser hjælper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein heißer Pi wird langsamer. Ein kleiner Kühlkörper oder Lüfter hilft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hot Pi slows down. A small heatsink or fan helps."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A hot Pi slows down. A small heatsink or fan helps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una Pi caliente va más lenta. Un pequeño disipador o un ventilador ayudan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuuma Pi hidastuu. Pieni jäähdytysripa tai tuuletin auttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Pi trop chaud ralentit. Un petit dissipateur ou un ventilateur aide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Pi caldo rallenta. Un piccolo dissipatore o una ventola aiutano."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En varm Pi blir tregere. En liten kjøleribbe eller vifte hjelper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een warme Pi wordt trager. Een klein koellichaam of ventilatortje helpt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gorące Pi zwalnia. Pomoże mały radiator lub wentylator."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Pi quente fica mais lento. Um pequeno dissipador ou uma ventoinha ajudam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En varm Pi blir långsam. En liten kylfläns eller fläkt hjälper."
          }
        }
      }
    },
