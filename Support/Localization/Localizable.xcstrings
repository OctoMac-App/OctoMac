    "Updating restarts OctoPrint, so wait until nothing is printing.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizace restartuje OctoPrint, proto počkejte, až se nic netiskne."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae diweddaru'n ailgychwyn OctoPrint, felly arhoswch nes nad oes dim byd yn argraffu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdatering genstarter OctoPrint, så vent, til der ikke printes noget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Aktualisieren startet OctoPrint neu, warte also, bis nichts gedruckt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating restarts OctoPrint, so wait until nothing is printing."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating restarts OctoPrint, so wait until nothing is printing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al actualizar se reinicia OctoPrint, así que espera a que no haya nada imprimiéndose."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitys käynnistää OctoPrintin uudelleen, joten odota, kunnes mikään ei tulostu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour redémarre OctoPrint, attendez donc qu’aucune impression ne soit en cours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aggiornamento riavvia OctoPrint, quindi attendi che non ci siano stampe in corso."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdatering starter OctoPrint på nytt, så vent til ingenting skrives ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijwerken herstart OctoPrint, dus wacht tot er niets wordt geprint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uaktualnienie uruchamia ponownie OctoPrint, więc poczekaj, aż nic nie będzie się drukować."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização reinicia o OctoPrint, por isso espere até não haver nada a imprimir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdateringen startar om OctoPrint, så vänta tills inget skrivs ut."
          }
        }
      }
    },
    "Updating. OctoPrint restarts when it's done, which can take a few minutes.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Probíhá aktualizace. Po dokončení se OctoPrint restartuje, což může trvat několik minut."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn diweddaru. Mae OctoPrint yn ailgychwyn pan fydd wedi gorffen, a gall hynny gymryd ychydig funudau."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdaterer. OctoPrint genstarter, når det er færdigt, hvilket kan tage et par minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird aktualisiert. OctoPrint startet danach neu, was ein paar Minuten dauern kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating. OctoPrint restarts when it's done, which can take a few minutes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating. OctoPrint restarts when it's done, which can take a few minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizando. OctoPrint se reiniciará cuando termine, lo que puede tardar unos minutos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitetään. OctoPrint käynnistyy uudelleen, kun päivitys on valmis, mikä voi kestää muutaman minuutin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour en cours. OctoPrint redémarre une fois terminé, ce qui peut prendre quelques minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornamento in corso. OctoPrint si riavvia al termine, il che può richiedere qualche minuto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdaterer. OctoPrint starter på nytt når det er ferdig, noe som kan ta noen minutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezig met bijwerken. OctoPrint start opnieuw op als het klaar is, wat een paar minuten kan duren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uaktualnianie. Po zakończeniu OctoPrint uruchomi się ponownie, co może potrwać kilka minut."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualizar. O OctoPrint reinicia quando terminar, o que pode demorar alguns minutos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdaterar. OctoPrint startar om när det är klart, vilket kan ta några minuter."
          }
        }
      }
    },
