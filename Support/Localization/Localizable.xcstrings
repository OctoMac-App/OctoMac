    "Moving the print head is locked while a print is running. Fan and speed still work.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během tisku je pohyb tiskové hlavy zamčený. Ventilátor a rychlost fungují dál."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae symud y pen argraffu wedi'i gloi tra mae argraffiad yn rhedeg. Mae'r ffan a'r cyflymder yn dal i weithio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Printhovedet kan ikke flyttes, mens et print kører. Blæser og hastighed virker stadig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Druckkopf ist gesperrt, solange ein Druck läuft. Lüfter und Geschwindigkeit funktionieren weiterhin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving the print head is locked while a print is running. Fan and speed still work."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving the print head is locked while a print is running. Fan and speed still work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover el cabezal está bloqueado mientras se imprime. El ventilador y la velocidad siguen funcionando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulostuspään siirtäminen on lukittu tulostuksen aikana. Tuuletin ja nopeus toimivat silti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déplacement de la tête d’impression est verrouillé pendant une impression. Le ventilateur et la vitesse restent réglables."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spostamento della testina è bloccato durante una stampa. Ventola e velocità funzionano comunque."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivehodet kan ikke flyttes mens en utskrift pågår. Vifte og hastighet virker fortsatt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De printkop bewegen is vergrendeld tijdens een print. Ventilator en snelheid werken nog wel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poruszanie głowicą jest zablokowane podczas wydruku. Wentylator i prędkość nadal działają."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível mover a cabeça de impressão durante uma impressão. A ventoinha e a velocidade continuam a funcionar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivhuvudet kan inte flyttas medan en utskrift pågår. Fläkt och hastighet fungerar fortfarande."
          }
        }
      }
    },
