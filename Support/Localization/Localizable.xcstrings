    "The certificate's SHA-256 fingerprint. OctoMac will only accept this exact certificate from this printer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otisk SHA-256 certifikátu. OctoMac od této tiskárny přijme jen přesně tento certifikát."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ôl bys SHA-256 y dystysgrif. Bydd OctoMac ond yn derbyn yr union dystysgrif hon gan yr argraffydd hwn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifikatets SHA-256-fingeraftryk. OctoMac accepterer kun præcis dette certifikat fra denne printer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der SHA-256-Fingerabdruck des Zertifikats. OctoMac akzeptiert von diesem Drucker nur genau dieses Zertifikat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate's SHA-256 fingerprint. OctoMac will only accept this exact certificate from this printer."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The certificate's SHA-256 fingerprint. OctoMac will only accept this exact certificate from this printer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La huella SHA-256 del certificado. OctoMac solo aceptará exactamente este certificado de esta impresora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmenteen SHA-256-sormenjälki. OctoMac hyväksyy tältä tulostimelta vain täsmälleen tämän varmenteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’empreinte SHA-256 du certificat. OctoMac n’acceptera que ce certificat précis de la part de cette imprimante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'impronta SHA-256 del certificato. OctoMac accetterà solo questo certificato esatto da questa stampante."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
