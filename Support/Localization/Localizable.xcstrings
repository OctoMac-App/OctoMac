    "No backups yet. A backup keeps OctoPrint's settings, plugins and files, so you can set it up again quickly if the SD card fails.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné zálohy. Záloha uchová nastavení, pluginy a soubory OctoPrintu, takže ho můžete rychle znovu nastavit, pokud selže SD karta."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dim copïau wrth gefn eto. Mae copi wrth gefn yn cadw gosodiadau, ategion a ffeiliau OctoPrint, felly gallwch chi ei osod eto'n gyflym os bydd y cerdyn SD yn methu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen sikkerhedskopier endnu. En sikkerhedskopi gemmer OctoPrints indstillinger, plugins og filer, så du hurtigt kan sætte det op igen, hvis SD-kortet svigter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Backups. Ein Backup enthält die Einstellungen, Plugins und Dateien von OctoPrint, damit du es schnell wieder einrichten kannst, falls die SD-Karte ausfällt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No backups yet. A backup keeps OctoPrint's settings, plugins and files, so you can set it up again quickly if the SD card fails."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No backups yet. A backup keeps OctoPrint's settings, plugins and files, so you can set it up again quickly if the SD card fails."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay copias de seguridad. Una copia de seguridad guarda los ajustes, plugins y archivos de OctoPrint, para que puedas volver a configurarlo rápido si falla la tarjeta SD."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä varmuuskopioita. Varmuuskopio säilyttää OctoPrintin asetukset, lisäosat ja tiedostot, joten saat sen nopeasti uudelleen käyttöön, jos SD-kortti hajoaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune sauvegarde pour l’instant. Une sauvegarde conserve les réglages, les plugins et les fichiers d’OctoPrint, pour que vous puissiez le réinstaller rapidement si la carte SD tombe en panne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun backup. Un backup conserva impostazioni, plugin e file di OctoPrint, così puoi configurarlo di nuovo in fretta se la scheda SD si guasta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen sikkerhetskopier ennå. En sikkerhetskopi tar vare på innstillingene, utvidelsene og filene til OctoPrint, så du raskt kan sette det opp igjen hvis SD-kortet svikter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen back-ups. Een back-up bewaart de instellingen, plug-ins en bestanden van OctoPrint, zodat je het snel opnieuw kunt instellen als de SD-kaart het begeeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak kopii zapasowych. Kopia zapasowa zawiera ustawienia, wtyczki i pliki OctoPrint, więc możesz szybko skonfigurować go od nowa, jeśli karta SD zawiedzie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem cópias de segurança. Uma cópia de segurança guarda as definições, os plugins e os ficheiros do OctoPrint, para que o possa configurar de novo rapidamente se o cartão SD falhar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga säkerhetskopior än. En säkerhetskopia sparar OctoPrints inställningar, plugin och filer, så att du snabbt kan ställa in det igen om SD-kortet går sönder."
          }
        }
      }
    },
    "No bed mesh yet. Measure the bed to see how flat it is.": {
      "localizations": {
        "cs": {
