            "state": "translated",
            "value": "La stampante è in attesa. La tua risposta le viene inviata subito."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriveren venter. Svaret ditt sendes til den med en gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De printer wacht. Je antwoord wordt meteen verstuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drukarka czeka. Twoja odpowiedź zostanie wysłana od razu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
