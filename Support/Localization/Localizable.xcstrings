        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotiajaa kaikki akselit mutta ohittaa verkkotasauksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met tous les axes à l’origine mais ignore le nivellement par maillage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegue l'home di tutti gli assi ma salta il livellamento mesh del piatto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjører alle akser hjem, men hopper over nivellering med platenett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Homet alle assen maar slaat mesh-bednivellering over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazuje wszystkie osie, ale pomija poziomowanie siatki stołu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Leva todos os eixos à origem, mas ignora o nivelamento por malha."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemkör alla axlar men hoppar över nätnivellering av bädden."
          }
        }
      }
    },
