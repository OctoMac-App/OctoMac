    "Coordinates after this are distances from where the head is now. Handy for nudging, for example G91 then G1 Z5.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Souřadnice za tímto příkazem jsou vzdálenosti od aktuální polohy hlavy. Hodí se pro posunutí, například G91 a pak G1 Z5."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae cyfesurynnau ar ôl hyn yn bellteroedd o ble mae'r pen nawr. Defnyddiol ar gyfer symud ychydig, er enghraifft G91 yna G1 Z5."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Koordinater efter dette er afstande fra, hvor hovedet er nu. Praktisk til små justeringer, f.eks. G91 og derefter G1 Z5."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koordinaten danach sind Abstände von der aktuellen Position des Kopfs. Praktisch zum Nachjustieren, z. B. G91 und dann G1 Z5."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordinates after this are distances from where the head is now. Handy for nudging, for example G91 then G1 Z5."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordinates after this are distances from where the head is now. Handy for nudging, for example G91 then G1 Z5."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las coordenadas a partir de aquí son distancias desde donde está ahora el cabezal. Útil para pequeños ajustes, por ejemplo G91 y luego G1 Z5."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän jälkeen koordinaatit ovat etäisyyksiä pään nykyisestä paikasta. Kätevä pieniin siirtoihin, esimerkiksi G91 ja sitten G1 Z5."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coordonnées suivantes sont des distances depuis la position actuelle de la tête. Pratique pour de petits ajustements, par exemple G91 puis G1 Z5."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coordinate successive sono distanze dalla posizione attuale della testina. Utile per piccoli spostamenti, ad esempio G91 e poi G1 Z5."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koordinater etter dette er avstander fra der hodet er nå. Nyttig for småjusteringer, for eksempel G91 og deretter G1 Z5."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coördinaten hierna zijn afstanden vanaf waar de kop nu is. Handig om iets bij te stellen, bijvoorbeeld G91 en dan G1 Z5."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolejne współrzędne to odległości od obecnej pozycji głowicy. Przydatne do drobnych przesunięć, na przykład G91, a potem G1 Z5."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As coordenadas seguintes são distâncias a partir da posição atual da cabeça. Útil para pequenos ajustes, por exemplo G91 seguido de G1 Z5."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koordinater efter detta är avstånd från där huvudet är nu. Praktiskt för små justeringar, till exempel G91 och sedan G1 Z5."
          }
        }
      }
    },
