    "Sets the hotend's PID values by hand. Send with no values to see the current ones.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ručně nastaví hodnoty PID hotendu. Bez hodnot zobrazí aktuální."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn gosod gwerthoedd PID yr hotend â llaw. Anfonwch heb werthoedd i weld y rhai presennol."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstiller hotendens PID-værdier manuelt. Send uden værdier for at se de aktuelle."
