    "Months before OctoMac was watching only count each file's latest print.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V měsících předtím, než OctoMac začal sledovat, se u každého souboru počítá jen jeho poslední tisk."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae misoedd cyn i OctoMac ddechrau gwylio ond yn cyfrif argraffiad diweddaraf pob ffeil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Måneder, før OctoMac holdt øje, tæller kun hver fils seneste print."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monate, bevor OctoMac zugeschaut hat, zählen nur den letzten Druck jeder Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Months before OctoMac was watching only count each file's latest print."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Months before OctoMac was watching only count each file's latest print."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los meses anteriores a que OctoMac empezara a vigilar solo cuenta la última impresión de cada archivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuukausista ennen kuin OctoMac seurasi lasketaan vain kunkin tiedoston viimeisin tulostus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les mois antérieurs au suivi d’OctoMac, seule la dernière impression de chaque fichier est comptée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per i mesi precedenti all'arrivo di OctoMac conta solo l'ultima stampa di ogni file."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Måneder før OctoMac fulgte med, teller bare den siste utskriften av hver fil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In maanden voordat OctoMac meekeek, telt alleen de laatste print van elk bestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W miesiącach, zanim OctoMac zaczął obserwować, liczy się tylko ostatni wydruk każdego pliku."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos meses anteriores ao OctoMac, só conta a última impressão de cada ficheiro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Månader innan OctoMac började hålla koll räknar bara varje fils senaste utskrift."
          }
        }
      }
    },
