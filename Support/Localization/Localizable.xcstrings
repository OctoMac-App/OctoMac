    "Low power makes the Pi slow down. A better power supply or cable usually fixes it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při nízkém napájení se Pi zpomalí. Obvykle pomůže lepší zdroj nebo kabel."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae pŵer isel yn gwneud i'r Pi arafu. Mae cyflenwad pŵer neu gebl gwell fel arfer yn datrys hyn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For lidt strøm får Pi'en til at gå langsommere. En bedre strømforsyning eller et bedre kabel løser det som regel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Strom bremst den Pi aus. Ein besseres Netzteil oder Kabel hilft meistens."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low power makes the Pi slow down. A better power supply or cable usually fixes it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Low power makes the Pi slow down. A better power supply or cable usually fixes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La falta de alimentación hace que la Pi vaya más lenta. Una fuente de alimentación o un cable mejores suelen solucionarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alhainen jännite hidastaa Pi:tä. Parempi virtalähde tai kaapeli yleensä korjaa sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une alimentation trop faible ralentit le Pi. Une meilleure alimentation ou un meilleur câble règle généralement le problème."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'alimentazione scarsa fa rallentare il Pi. Di solito basta un alimentatore o un cavo migliore."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lav strøm gjør Pi-en tregere. En bedre strømforsyning eller kabel løser det som regel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te weinig stroom maakt de Pi traag. Een betere voeding of kabel lost het meestal op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt niskie zasilanie spowalnia Pi. Zwykle pomaga lepszy zasilacz lub kabel."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A falta de energia torna o Pi mais lento. Uma fonte de alimentação ou um cabo melhor costuma resolver."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låg spänning gör Pi:n långsam. Ett bättre nätaggregat eller en bättre kabel brukar lösa det."
          }
        }
      }
    },
    "Low power or overheating on the Raspberry Pi, which can spoil prints.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nízké napájení nebo přehřátí Raspberry Pi, které může pokazit tisk."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Pŵer isel neu orboethi ar y Raspberry Pi, a all ddifetha argraffiadau."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For lidt strøm eller overophedning på Raspberry Pi, hvilket kan ødelægge prints."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenig Strom oder Überhitzung am Raspberry Pi, was Drucke verderben kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low power or overheating on the Raspberry Pi, which can spoil prints."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Low power or overheating on the Raspberry Pi, which can spoil prints."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta de alimentación o sobrecalentamiento en la Raspberry Pi, que pueden estropear las impresiones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alhainen jännite tai ylikuumeneminen Raspberry Pi:ssä, mikä voi pilata tulosteita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimentation faible ou surchauffe du Raspberry Pi, ce qui peut gâcher les impressions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimentazione scarsa o surriscaldamento sul Raspberry Pi, che possono rovinare le stampe."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lav strøm eller overoppheting på Raspberry Pi, som kan ødelegge utskrifter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te weinig stroom of oververhitting op de Raspberry Pi, wat prints kan verpesten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niskie zasilanie lub przegrzanie Raspberry Pi, co może psuć wydruki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta de energia ou sobreaquecimento no Raspberry Pi, o que pode estragar impressões."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låg spänning eller överhettning på Raspberry Pi, vilket kan förstöra utskrifter."
          }
        }
      }
    },
