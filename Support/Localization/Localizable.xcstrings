            "state": "translated",
            "value": "När en utskrift misslyckas eller stoppas från skrivaren."
          }
        }
      }
    },
    "When a print finishes, OctoMac asks you to clear the bed before starting the next one.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po dokončení tisku vás OctoMac požádá o uvolnění podložky před spuštěním dalšího."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Pan fydd argraffiad yn gorffen, mae OctoMac yn gofyn i chi glirio'r gwely cyn dechrau'r un nesaf."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når et print er færdigt, beder OctoMac dig rydde pladen, før det næste startes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Druck fertig ist, bittet OctoMac dich, das Bett abzuräumen, bevor der nächste startet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a print finishes, OctoMac asks you to clear the bed before starting the next one."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When a print finishes, OctoMac asks you to clear the bed before starting the next one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando termina una impresión, OctoMac te pide que despejes la cama antes de empezar la siguiente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tulostus valmistuu, OctoMac pyytää sinua tyhjentämään alustan ennen seuraavan aloittamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une impression se termine, OctoMac vous demande de libérer le plateau avant de lancer la suivante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al termine di una stampa, OctoMac ti chiede di liberare il piatto prima di avviare la successiva."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en utskrift er ferdig, ber OctoMac deg rydde platen før den neste starter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een print klaar is, vraagt OctoMac je het bed leeg te maken voordat de volgende begint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy wydruk się skończy, OctoMac poprosi o opróżnienie stołu przed uruchomieniem następnego."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma impressão termina, o OctoMac pede-lhe para limpar a mesa antes de iniciar a seguinte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När en utskrift är klar ber OctoMac dig tömma bädden innan nästa startar."
          }
        }
      }
    },
    "When a print reaches a layer you chose to be told about or pause at.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když tisk dosáhne vrstvy, u které jste chtěli upozornit nebo pozastavit."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Pan fydd argraffiad yn cyrraedd haen y dewisoch chi gael gwybod amdani neu seibio arni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når et print når et lag, du har valgt at få besked om eller holde pause ved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Druck eine Schicht erreicht, bei der du benachrichtigt werden oder pausieren wolltest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a print reaches a layer you chose to be told about or pause at."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When a print reaches a layer you chose to be told about or pause at."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando una impresión llega a una capa en la que elegiste recibir un aviso o pausar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tulostus saavuttaa kerroksen, josta halusit ilmoituksen tai jossa halusit tauon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une impression atteint une couche pour laquelle vous avez demandé une alerte ou une pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando una stampa raggiunge un layer per cui hai chiesto un avviso o una pausa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en utskrift når et lag du valgte å bli varslet om eller sette på pause ved."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een print een laag bereikt waarvoor je een melding of pauze hebt ingesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy wydruk osiągnie warstwę, na której ma nastąpić powiadomienie lub pauza."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma impressão chega a uma camada em que escolheu ser avisado ou fazer pausa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När en utskrift når ett lager som du ville bli meddelad om eller pausa vid."
          }
        }
      }
    },
    "When a scheduled print starts, and when the next print in the queue is ready to go.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když se spustí naplánovaný tisk a když je další tisk ve frontě připravený."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Pan fydd argraffiad wedi'i amserlennu'n dechrau, a phan fydd yr argraffiad nesaf yn y ciw yn barod i fynd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når et planlagt print starter, og når det næste print i køen er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein geplanter Druck startet und wenn der nächste Druck in der Warteschlange bereit ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a scheduled print starts, and when the next print in the queue is ready to go."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When a scheduled print starts, and when the next print in the queue is ready to go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando empieza una impresión programada y cuando la siguiente impresión de la cola está lista para empezar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun ajastettu tulostus alkaa ja kun jonon seuraava tulostus on valmis aloitettavaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une impression planifiée démarre, et quand la prochaine impression de la file d’attente est prête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando una stampa pianificata parte e quando la prossima stampa in coda è pronta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en planlagt utskrift starter, og når neste utskrift i køen er klar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een geplande print begint, en als de volgende print in de wachtrij klaarstaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy ruszy zaplanowany wydruk i gdy następny wydruk w kolejce będzie gotowy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma impressão agendada começa e quando a impressão seguinte na fila está pronta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När en schemalagd utskrift startar, och när nästa utskrift i kön är redo att köra."
          }
        }
      }
    },
    "When the printer reports an error or drops its connection mid-print.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když tiskárna nahlásí chybu nebo uprostřed tisku ztratí spojení."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Pan fydd yr argraffydd yn adrodd gwall neu'n colli ei gysylltiad yng nghanol argraffiad."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når printeren melder en fejl eller mister forbindelsen midt i et print."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Drucker einen Fehler meldet oder die Verbindung mitten im Druck verliert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the printer reports an error or drops its connection mid-print."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When the printer reports an error or drops its connection mid-print."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la impresora informa de un error o pierde la conexión en mitad de una impresión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tulostin ilmoittaa virheestä tai sen yhteys katkeaa kesken tulostuksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand l’imprimante signale une erreur ou perd sa connexion en pleine impression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la stampante segnala un errore o perde la connessione durante una stampa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når skriveren rapporterer en feil eller mister tilkoblingen midt i en utskrift."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de printer een fout meldt of de verbinding verliest tijdens een print."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy drukarka zgłosi błąd lub utraci połączenie w trakcie wydruku."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a impressora indica um erro ou perde a ligação a meio de uma impressão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När skrivaren rapporterar ett fel eller tappar anslutningen mitt under en utskrift."
          }
        }
      }
    },
    "Where OctoPrint finds the camera's video and still pictures. Addresses starting with / are on the Raspberry Pi itself.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kde OctoPrint najde video a statické snímky z kamery. Adresy začínající znakem / jsou přímo na Raspberry Pi."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Lle mae OctoPrint yn dod o hyd i fideo a lluniau llonydd y camera. Mae cyfeiriadau sy'n dechrau gyda / ar y Raspberry Pi ei hun."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor OctoPrint finder kameraets video og stillbilleder. Adresser, der starter med /, ligger på selve Raspberry Pi'en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo OctoPrint das Video und die Standbilder der Kamera findet. Adressen, die mit / beginnen, liegen auf dem Raspberry Pi selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where OctoPrint finds the camera's video and still pictures. Addresses starting with / are on the Raspberry Pi itself."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Where OctoPrint finds the camera's video and still pictures. Addresses starting with / are on the Raspberry Pi itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde encuentra OctoPrint el vídeo y las imágenes fijas de la cámara. Las direcciones que empiezan por / están en la propia Raspberry Pi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistä OctoPrint löytää kameran videon ja pysäytyskuvat. /-merkillä alkavat osoitteet ovat itse Raspberry Pi:llä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où OctoPrint trouve la vidéo et les images fixes de la caméra. Les adresses commençant par / se trouvent sur le Raspberry Pi lui-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove OctoPrint trova il video e le immagini fisse della videocamera. Gli indirizzi che iniziano con / si trovano sul Raspberry Pi stesso."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor OctoPrint finner videoen og stillbildene fra kameraet. Adresser som begynner med /, ligger på selve Raspberry Pi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar OctoPrint de video en stilstaande beelden van de camera vindt. Adressen die met / beginnen, staan op de Raspberry Pi zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdzie OctoPrint znajduje wideo i zdjęcia z kamery. Adresy zaczynające się od / są na samym Raspberry Pi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde o OctoPrint encontra o vídeo e as imagens estáticas da câmara. Os endereços que começam por / estão no próprio Raspberry Pi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Var OctoPrint hittar kamerans video och stillbilder. Adresser som börjar med / finns på själva Raspberry Pi."
          }
        }
      }
    },
