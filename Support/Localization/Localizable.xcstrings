    "Make sure its bed is clear first.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív se ujistěte, že je podložka volná."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Gwnewch yn siŵr bod ei wely'n glir yn gyntaf."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for, at pladen er ryddet først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte darauf, dass sein Bett vorher frei ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure its bed is clear first."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure its bed is clear first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate antes de que la cama está despejada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista ensin, että sen alusta on tyhjä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous d’abord que son plateau est libre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima assicurati che il piatto sia libero."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for at platen er tom først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg eerst dat het bed leeg is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw upewnij się, że stół jest pusty."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se primeiro de que a mesa está livre."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se till att bädden är tom först."
          }
        }
      }
    },
    "Make sure the bed is clear first. The printer starts straight away.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív se ujistěte, že je podložka volná. Tiskárna začne okamžitě."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Gwnewch yn siŵr bod y gwely'n glir yn gyntaf. Mae'r argraffydd yn dechrau ar unwaith."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for, at pladen er ryddet først. Printeren starter med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte darauf, dass das Bett vorher frei ist. Der Drucker startet sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the bed is clear first. The printer starts straight away."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the bed is clear first. The printer starts straight away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate antes de que la cama está despejada. La impresora empieza enseguida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista ensin, että alusta on tyhjä. Tulostin aloittaa heti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous d’abord que le plateau est libre. L’imprimante démarre tout de suite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima assicurati che il piatto sia libero. La stampante parte subito."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for at platen er tom først. Skriveren starter med en gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg eerst dat het bed leeg is. De printer begint meteen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw upewnij się, że stół jest pusty. Drukarka ruszy od razu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se primeiro de que a mesa está livre. A impressora começa de imediato."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se till att bädden är tom först. Skrivaren startar direkt."
          }
        }
      }
    },
