    "Powers the stepper motors so they hold their position.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapne krokové motory, aby držely svou polohu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn rhoi pŵer i'r moduron stepiwr fel eu bod yn dal eu safle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giver strøm til stepmotorerne, så de holder deres position."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versorgt die Schrittmotoren mit Strom, damit sie ihre Position halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Powers the stepper motors so they hold their position."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Powers the stepper motors so they hold their position."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimenta los motores paso a paso para que mantengan su posición."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kytkee askelmoottoreihin virran, jotta ne pysyvät paikallaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimente les moteurs pas à pas pour qu’ils gardent leur position."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimenta i motori passo-passo così mantengono la loro posizione."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gir strøm til trinnmotorene så de holder posisjonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet stroom op de stappenmotoren zodat ze hun positie vasthouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasila silniki krokowe, aby utrzymywały pozycję."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimenta os motores de passo para que mantenham a posição."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Strömsätter stegmotorerna så att de håller sin position."
          }
        }
      }
    },
