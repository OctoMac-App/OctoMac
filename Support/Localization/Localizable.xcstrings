    "One click heats the nozzle and bed for a material. They're shared with OctoPrint's own page.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedním kliknutím ohřejete trysku a podložku pro daný materiál. Předvolby se sdílejí s webovou stránkou OctoPrintu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae un clic yn gwresogi'r ffroenell a'r gwely ar gyfer deunydd. Maen nhw'n cael eu rhannu â thudalen OctoPrint ei hun."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét klik varmer dyse og plade op til et materiale. De deles med OctoPrints egen side."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Klick heizt Düse und Bett für ein Material. Sie werden mit der Webseite von OctoPrint geteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One click heats the nozzle and bed for a material. They're shared with OctoPrint's own page."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "One click heats the nozzle and bed for a material. They're shared with OctoPrint's own page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un clic se calientan la boquilla y la cama para un material. Se comparten con la propia página de OctoPrint."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdellä napsautuksella suutin ja alusta lämpenevät materiaalia varten. Ne ovat yhteisiä OctoPrintin oman sivun kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic chauffe la buse et le plateau pour un matériau. Ces préréglages sont partagés avec la page d’OctoPrint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un clic si riscaldano ugello e piatto per un materiale. Sono condivisi con la pagina di OctoPrint."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett klikk varmer opp dysen og platen for et materiale. De deles med OctoPrints egen side."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met één klik verwarm je de nozzle en het bed voor een materiaal. Ze worden gedeeld met de eigen pagina van OctoPrint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno kliknięcie nagrzewa dyszę i stół dla danego materiału. Ustawienia są wspólne ze stroną OctoPrint."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um clique aquece o bico e a mesa para um material. São partilhadas com a própria página do OctoPrint."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett klick värmer munstycket och bädden för ett material. De delas med OctoPrints egen sida."
          }
        }
      }
    },
