            "state": "translated",
            "value": "%@ är pausad och väntar på dig."
          }
        }
      }
    },
    "%@ is paused. Resume it when you're ready.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: pozastaveno. Až budete připraveni, pokračujte."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae %@ wedi'i seibio. Ailddechreuwch pan fyddwch chi'n barod."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er sat på pause. Genoptag, når du er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist pausiert. Setze den Druck fort, wenn du bereit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is paused. Resume it when you're ready."
          }
        },
        "en-GB": {
