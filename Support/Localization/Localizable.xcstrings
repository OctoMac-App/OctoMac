            "value": "En la cola; añádelo otra vez para imprimir otro"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonossa; lisää se uudelleen tulostaaksesi toisen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la file d’attente ; ajoutez-le à nouveau pour l’imprimer une autre fois"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In coda; aggiungilo di nuovo per stamparne un altro"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I køen. Legg den til igjen for å skrive ut én til"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
