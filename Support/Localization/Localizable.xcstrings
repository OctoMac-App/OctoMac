    "This printer measures the bed before every print and allows for its shape, so it has no levelling screws to turn.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato tiskárna před každým tiskem změří podložku a počítá s jejím tvarem, takže nemá žádné vyrovnávací šrouby k otáčení."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae'r argraffydd hwn yn mesur y gwely cyn pob argraffiad ac yn ystyried ei siâp, felly does ganddo ddim sgriwiau lefelu i'w troi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne printer måler pladen før hvert print og tager højde for dens form, så den har ingen nivelleringsskruer at dreje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Drucker vermisst das Bett vor jedem Druck und gleicht seine Form aus, daher gibt es keine Nivellierschrauben zum Drehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This printer measures the bed before every print and allows for its shape, so it has no leveling screws to turn."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This printer measures the bed before every print and allows for its shape, so it has no levelling screws to turn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta impresora mide la cama antes de cada impresión y compensa su forma, así que no tiene tornillos de nivelación que girar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tulostin mittaa alustan ennen jokaista tulostusta ja ottaa sen muodon huomioon, joten siinä ei ole käännettäviä tasausruuveja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette imprimante mesure le plateau avant chaque impression et tient compte de sa forme : elle n’a donc pas de vis de nivellement à tourner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa stampante misura il piatto prima di ogni stampa e ne compensa la forma, quindi non ha viti di livellamento da girare."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne skriveren måler platen før hver utskrift og tar hensyn til formen, så den har ingen nivelleringsskruer å skru på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze printer meet het bed voor elke print en houdt rekening met de vorm ervan, dus hij heeft geen nivelleerschroeven om aan te draaien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta drukarka mierzy stół przed każdym wydrukiem i uwzględnia jego kształt, więc nie ma śrub poziomujących do kręcenia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta impressora mede a mesa antes de cada impressão e compensa a sua forma, por isso não tem parafusos de nivelamento para rodar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här skrivaren mäter bädden före varje utskrift och tar hänsyn till dess form, så den har inga nivelleringsskruvar att vrida."
          }
        }
      }
    },
    "This printer's HTTPS certificate isn't trusted yet.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifikát HTTPS této tiskárny zatím není důvěryhodný."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Does dim ymddiriedaeth yn nhystysgrif HTTPS yr argraffydd hwn eto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne printers HTTPS-certifikat er ikke godkendt endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem HTTPS-Zertifikat dieses Druckers wird noch nicht vertraut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This printer's HTTPS certificate isn't trusted yet."
          }
        },
        "en-GB": {
