    "Events like a print finishing always arrive instantly. Slow updates down only on a poor connection.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Události, jako je dokončení tisku, přicházejí vždy okamžitě. Aktualizace zpomalte jen při špatném připojení."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae digwyddiadau fel argraffiad yn gorffen bob amser yn cyrraedd ar unwaith. Arafwch y diweddariadau dim ond ar gysylltiad gwael."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hændelser som et færdigt print kommer altid med det samme. Sænk kun opdateringshastigheden på en dårlig forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ereignisse wie ein fertiger Druck kommen immer sofort an. Verlangsame Updates nur bei einer schlechten Verbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events like a print finishing always arrive instantly. Slow updates down only on a poor connection."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Events like a print finishing always arrive instantly. Slow updates down only on a poor connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventos como el final de una impresión siempre llegan al instante. Ralentiza las actualizaciones solo si la conexión es mala."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapahtumat, kuten tulostuksen valmistuminen, tulevat aina heti. Hidasta päivityksiä vain, jos yhteys on huono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les événements comme la fin d’une impression arrivent toujours instantanément. Ne ralentissez les mises à jour que si la connexion est mauvaise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventi come la fine di una stampa arrivano sempre all'istante. Rallenta gli aggiornamenti solo con una connessione scarsa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hendelser som at en utskrift blir ferdig, kommer alltid umiddelbart. Senk oppdateringsfrekvensen bare ved dårlig tilkobling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebeurtenissen zoals een voltooide print komen altijd direct binnen. Vertraag updates alleen bij een slechte verbinding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdarzenia, takie jak zakończenie wydruku, zawsze docierają od razu. Spowalniaj aktualizacje tylko przy słabym połączeniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventos como o fim de uma impressão chegam sempre de imediato. Abrande as atualizações apenas numa ligação fraca."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Händelser som att en utskrift blir klar kommer alltid direkt. Sänk uppdateringstakten bara vid en dålig anslutning."
          }
        }
      }
    },
