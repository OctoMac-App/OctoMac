    "This printer doesn't accept Z nudges from OctoPrint. Use its own menu instead.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato tiskárna nepřijímá doladění Z z OctoPrintu. Použijte místo toho její vlastní nabídku."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dydy'r argraffydd hwn ddim yn derbyn addasiadau Z gan OctoPrint. Defnyddiwch ei ddewislen ei hun yn lle hynny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne printer tager ikke imod Z-justeringer fra OctoPrint. Brug i stedet printerens egen menu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Drucker nimmt keine Z-Korrekturen von OctoPrint an. Nutze stattdessen sein eigenes Menü."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This printer doesn't accept Z nudges from OctoPrint. Use its own menu instead."
          }
        },
