    "Lets the extruder move below its minimum temperature. Only for testing; it can grind filament.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní extruderu pohyb pod minimální teplotou. Jen pro testování; může rozdrtit filament."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn gadael i'r allwthiwr symud o dan ei dymheredd isaf. Ar gyfer profi yn unig; gall falu'r ffilament."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader extruderen bevæge sig under sin minimumstemperatur. Kun til test; det kan slibe filamentet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt dem Extruder, sich unterhalb seiner Mindesttemperatur zu bewegen. Nur zum Testen, es kann das Filament abschleifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the extruder move below its minimum temperature. Only for testing; it can grind filament."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the extruder move below its minimum temperature. Only for testing; it can grind filament."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que el extrusor se mueva por debajo de su temperatura mínima. Solo para pruebas; puede triturar el filamento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Antaa ekstruuderin liikkua alle vähimmäislämpötilansa. Vain testaukseen; se voi jauhaa filamenttia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à l’extrudeur de bouger sous sa température minimale. Uniquement pour des tests : cela peut ronger le filament."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permette all'estrusore di muoversi sotto la temperatura minima. Solo per test: può macinare il filamento."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lar ekstruderen bevege seg under minimumstemperaturen. Bare for testing. Den kan male opp filamentet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de extruder bewegen onder zijn minimumtemperatuur. Alleen om te testen; het kan filament vermalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala ekstruderowi pracować poniżej minimalnej temperatury. Tylko do testów; może zmielić filament."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que a extrusora se mova abaixo da temperatura mínima. Apenas para testes; pode desgastar o filamento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låter extrudern röra sig under sin minimitemperatur. Bara för tester, det kan slipa sönder filamentet."
          }
        }
      }
    },
