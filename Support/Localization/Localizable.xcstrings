    "Sets how far each motor moves per step. Send with no values to see them. Save with M500.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví, o kolik se každý motor posune za krok. Bez hodnot je zobrazí. Uložte pomocí M500."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn gosod pa mor bell mae pob modur yn symud fesul cam. Anfonwch heb werthoedd i'w gweld. Cadwch gydag M500."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiver, hvor langt hver motor bevæger sig pr. trin. Send uden værdier for at se dem. Gem med M500."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, wie weit sich jeder Motor pro Schritt bewegt. Ohne Werte gesendet, werden sie angezeigt. Mit M500 speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets how far each motor moves per step. Send with no values to see them. Save with M500."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets how far each motor moves per step. Send with no values to see them. Save with M500."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija cuánto se mueve cada motor por paso. Envíalo sin valores para verlos. Guarda con M500."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettaa, kuinka paljon kukin moottori liikkuu askelta kohden. Lähetä ilman arvoja nähdäksesi ne. Tallenna komennolla M500."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit la distance parcourue par chaque moteur à chaque pas. Envoyez sans valeur pour les voir. Enregistrez avec M500."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta quanto si muove ogni motore per passo. Invia senza valori per vederli. Salva con M500."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angir hvor langt hver motor flytter seg per steg. Send uten verdier for å se dem. Lagre med M500."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt in hoe ver elke motor per stap beweegt. Stuur zonder waarden om ze te zien. Bewaar met M500."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia, o ile każdy silnik przesuwa się na krok. Wyślij bez wartości, aby je zobaczyć. Zapisz przez M500."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define a distância que cada motor percorre por passo. Envie sem valores para os ver. Guarde com M500."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anger hur långt varje motor rör sig per steg. Skicka utan värden för att se dem. Spara med M500."
          }
        }
      }
    },
    "Sets the Z offset between the probe and the nozzle. Send with no values to see it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví offset Z mezi sondou a tryskou. Bez hodnot ho zobrazí."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn gosod y gwrthbwyso Z rhwng y chwiliedydd a'r ffroenell. Anfonwch heb werthoedd i'w weld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiver Z-offset mellem proben og dysen. Send uden værdier for at se det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt den Z-Offset zwischen Sensor und Düse fest. Ohne Werte gesendet, wird er angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the Z offset between the probe and the nozzle. Send with no values to see it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the Z offset between the probe and the nozzle. Send with no values to see it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija el offset Z entre la sonda y la boquilla. Envíalo sin valores para verlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettaa mittausanturin ja suuttimen välisen Z-siirtymän. Lähetä ilman arvoja nähdäksesi sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit le décalage Z entre la sonde et la buse. Envoyez sans valeur pour le voir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta l'offset Z tra sonda e ugello. Invia senza valori per vederlo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angir Z-forskyvningen mellom proben og dysen. Send uten verdier for å se den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt de Z-offset tussen de probe en de nozzle in. Stuur zonder waarden om hem te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia przesunięcie Z między sondą a dyszą. Wyślij bez wartości, aby je zobaczyć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define o desvio Z entre a sonda e o bico. Envie sem valores para o ver."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anger Z-förskjutningen mellan sonden och munstycket. Skicka utan värden för att se den."
          }
        }
      }
    },
    "Sets the acceleration for printing (P), retracting (R) and travel (T).": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví zrychlení pro tisk (P), retrakci (R) a přejezdy (T)."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn gosod y cyflymiad ar gyfer argraffu (P), tynnu'n ôl (R) a theithio (T)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiver accelerationen for print (P), tilbagetrækning (R) og transport (T)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die Beschleunigung für Drucken (P), Rückzug (R) und Leerfahrt (T) fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the acceleration for printing (P), retracting (R) and travel (T)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the acceleration for printing (P), retracting (R) and travel (T)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija la aceleración para imprimir (P), retraer (R) y desplazarse (T)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettaa kiihtyvyyden tulostukselle (P), takaisinvedolle (R) ja siirtoliikkeille (T)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit l’accélération pour l’impression (P), la rétraction (R) et les déplacements (T)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta l'accelerazione per la stampa (P), la retrazione (R) e gli spostamenti (T)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angir akselerasjonen for utskrift (P), tilbaketrekking (R) og forflytning (T)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt de acceleratie in voor printen (P), terugtrekken (R) en verplaatsen (T)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia przyspieszenie dla druku (P), retrakcji (R) i przejazdów (T)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define a aceleração para impressão (P), retração (R) e deslocação (T)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anger accelerationen för utskrift (P), retraktion (R) och förflyttning (T)."
          }
        }
      }
    },
    "Sets the bed temperature and carries on straight away. S0 turns it off.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví teplotu podložky a hned pokračuje. S0 ji vypne."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn gosod tymheredd y gwely ac yn parhau ar unwaith. Mae S0 yn ei ddiffodd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstiller pladetemperaturen og fortsætter med det samme. S0 slukker den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt die Betttemperatur und macht sofort weiter. S0 schaltet die Heizung aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the bed temperature and carries on straight away. S0 turns it off."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the bed temperature and carries on straight away. S0 turns it off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija la temperatura de la cama y continúa al momento. S0 la apaga."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettaa alustan lämpötilan ja jatkaa heti. S0 sammuttaa sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle la température du plateau et continue tout de suite. S0 l’éteint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la temperatura del piatto e continua subito. S0 la spegne."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angir platetemperaturen og fortsetter med en gang. S0 slår den av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt de bedtemperatuur in en gaat meteen verder. S0 zet hem uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia temperaturę stołu i od razu kontynuuje. S0 wyłącza grzanie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define a temperatura da mesa e continua de imediato. S0 desliga-a."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställer in bäddtemperaturen och fortsätter direkt. S0 stänger av den."
          }
        }
      }
    },
    "Sets the bed temperature and waits until it gets there.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví teplotu podložky a počká, až jí dosáhne."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn gosod tymheredd y gwely ac yn aros nes iddo gyrraedd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstiller pladetemperaturen og venter, til den er nået."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt die Betttemperatur und wartet, bis sie erreicht ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the bed temperature and waits until it gets there."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the bed temperature and waits until it gets there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija la temperatura de la cama y espera hasta alcanzarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettaa alustan lämpötilan ja odottaa, kunnes se saavutetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle la température du plateau et attend qu’elle soit atteinte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la temperatura del piatto e attende che la raggiunga."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angir platetemperaturen og venter til den er nådd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt de bedtemperatuur in en wacht tot die bereikt is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia temperaturę stołu i czeka, aż zostanie osiągnięta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define a temperatura da mesa e espera até a atingir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställer in bäddtemperaturen och väntar tills den nås."
          }
        }
      }
    },
