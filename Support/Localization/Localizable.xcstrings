        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Raspberry Pi ha poca alimentazione o è troppo caldo. Vedi la scheda Macchina."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
