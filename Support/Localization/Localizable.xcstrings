            "state": "translated",
            "value": "%@ is paused. Resume it when you're ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está en pausa. Reanúdala cuando quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on tauolla. Jatka, kun olet valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en pause. Reprenez-la quand vous voulez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è in pausa. Riprendila quando sei pronto."
          }
        },
