    "OctoMac follows your Mac's language unless you choose one here.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac používá jazyk vašeho Macu, pokud zde nevyberete jiný."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoMac yn dilyn iaith eich Mac oni bai eich bod chi'n dewis un yma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac følger din Macs sprog, medmindre du vælger et her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac folgt der Sprache deines Mac, außer du wählst hier eine aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac follows your Mac's language unless you choose one here."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac follows your Mac's language unless you choose one here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac usa el idioma de tu Mac salvo que elijas otro aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac käyttää Macisi kieltä, ellet valitse kieltä tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac suit la langue de votre Mac, sauf si vous en choisissez une ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac segue la lingua del tuo Mac, a meno che tu non ne scelga una qui."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac følger språket på Macen din, med mindre du velger et her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac volgt de taal van je Mac, tenzij je hier een taal kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac używa języka twojego Maca, chyba że wybierzesz inny tutaj."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoMac segue o idioma do Mac, a menos que escolha um aqui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac följer din Macs språk om du inte väljer ett här."
          }
        }
      }
    },
    "OctoMac forgets this printer and its API key. Nothing changes on the printer or in OctoPrint.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac zapomene tuto tiskárnu a její klíč API. Na tiskárně ani v OctoPrintu se nic nezmění."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Bydd OctoMac yn anghofio'r argraffydd hwn a'i allwedd API. Does dim byd yn newid ar yr argraffydd nac yn OctoPrint."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac glemmer denne printer og dens API-nøgle. Intet ændres på printeren eller i OctoPrint."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac vergisst diesen Drucker und seinen API-Schlüssel. Am Drucker und in OctoPrint ändert sich nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac forgets this printer and its API key. Nothing changes on the printer or in OctoPrint."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac forgets this printer and its API key. Nothing changes on the printer or in OctoPrint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac olvida esta impresora y su clave de API. No cambia nada en la impresora ni en OctoPrint."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac unohtaa tämän tulostimen ja sen API-avaimen. Tulostimeen tai OctoPrintiin ei tehdä muutoksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac oublie cette imprimante et sa clé API. Rien ne change sur l’imprimante ni dans OctoPrint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac dimentica questa stampante e la sua chiave API. Sulla stampante e in OctoPrint non cambia nulla."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac glemmer denne skriveren og API-nøkkelen. Ingenting endres på skriveren eller i OctoPrint."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac vergeet deze printer en de API-sleutel. Op de printer en in OctoPrint verandert niets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac zapomni tę drukarkę i jej klucz API. Nic się nie zmieni na drukarce ani w OctoPrint."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoMac esquece esta impressora e a respetiva chave da API. Nada muda na impressora nem no OctoPrint."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac glömmer den här skrivaren och dess API-nyckel. Inget ändras på skrivaren eller i OctoPrint."
          }
        }
      }
    },
    "OctoMac forgets this server and its API key. Nothing changes on the printer, and you can add it again later.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac zapomene tento server a jeho klíč API. Na tiskárně se nic nezmění a později ho můžete přidat znovu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Bydd OctoMac yn anghofio'r gweinydd hwn a'i allwedd API. Does dim byd yn newid ar yr argraffydd, a gallwch chi ei ychwanegu eto yn nes ymlaen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac glemmer denne server og dens API-nøgle. Intet ændres på printeren, og du kan tilføje den igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac vergisst diesen Server und seinen API-Schlüssel. Am Drucker ändert sich nichts, und du kannst ihn später wieder hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac forgets this server and its API key. Nothing changes on the printer, and you can add it again later."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac forgets this server and its API key. Nothing changes on the printer, and you can add it again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac olvida este servidor y su clave de API. No cambia nada en la impresora, y puedes volver a añadirlo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac unohtaa tämän palvelimen ja sen API-avaimen. Tulostimeen ei tehdä muutoksia, ja voit lisätä sen myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac oublie ce serveur et sa clé API. Rien ne change sur l’imprimante, et vous pourrez l’ajouter à nouveau plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac dimentica questo server e la sua chiave API. Sulla stampante non cambia nulla e potrai aggiungerlo di nuovo in seguito."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac glemmer denne serveren og API-nøkkelen. Ingenting endres på skriveren, og du kan legge den til igjen senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac vergeet deze server en de API-sleutel. Op de printer verandert niets, en je kunt hem later opnieuw toevoegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac zapomni ten serwer i jego klucz API. Nic się nie zmieni na drukarce, a później możesz dodać go ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoMac esquece este servidor e a respetiva chave da API. Nada muda na impressora e pode voltar a adicioná-lo mais tarde."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac glömmer den här servern och dess API-nyckel. Inget ändras på skrivaren, och du kan lägga till den igen senare."
          }
        }
      }
    },
    "OctoMac hasn't been allowed to send notifications yet.": {
      "localizations": {
        "cs": {
          "stringUnit": {
