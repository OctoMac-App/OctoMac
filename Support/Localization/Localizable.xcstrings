    "You can install plugins once the print has finished.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pluginy můžete instalovat, až tisk skončí."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Gallwch chi osod ategion unwaith y bydd yr argraffiad wedi gorffen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan installere plugins, når printet er færdigt."
          }
        },
