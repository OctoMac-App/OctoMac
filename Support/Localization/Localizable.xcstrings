    "Finished, failed and paused prints show what the camera sees, so you can check without opening OctoMac.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokončené, neúspěšné a pozastavené tisky ukazují, co vidí kamera, takže je můžete zkontrolovat bez otevírání OctoMacu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae argraffiadau sydd wedi gorffen, wedi methu neu wedi'u seibio yn dangos beth mae'r camera'n ei weld, er mwyn i chi wirio heb agor OctoMac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Færdige, mislykkede og pausede prints viser, hvad kameraet ser, så du kan tjekke uden at åbne OctoMac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertige, fehlgeschlagene und pausierte Drucke zeigen, was die Kamera sieht, damit du nachsehen kannst, ohne OctoMac zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished, failed and paused prints show what the camera sees, so you can check without opening OctoMac."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished, failed and paused prints show what the camera sees, so you can check without opening OctoMac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las impresiones terminadas, fallidas y en pausa muestran lo que ve la cámara, para que lo compruebes sin abrir OctoMac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmiista, epäonnistuneista ja tauolla olevista tulostuksista näytetään kameran kuva, joten voit tarkistaa tilanteen avaamatta OctoMacia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les impressions terminées, échouées ou en pause affichent ce que voit la caméra, pour vérifier sans ouvrir OctoMac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stampe terminate, non riuscite e in pausa mostrano cosa vede la videocamera, così puoi controllare senza aprire OctoMac."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferdige, mislykkede og pausede utskrifter viser hva kameraet ser, så du kan sjekke uten å åpne OctoMac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooide, mislukte en gepauzeerde prints tonen wat de camera ziet, zodat je kunt kijken zonder OctoMac te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukończone, nieudane i wstrzymane wydruki pokazują obraz z kamery, więc możesz sprawdzić stan bez otwierania OctoMac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As impressões concluídas, falhadas e em pausa mostram o que a câmara vê, para poder verificar sem abrir o OctoMac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klara, misslyckade och pausade utskrifter visar vad kameran ser, så att du kan kontrollera utan att öppna OctoMac."
          }
        }
      }
    },
