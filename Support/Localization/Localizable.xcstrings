          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataa firmwaren oletusarvot. Lähetä sen jälkeen M500, jos haluat säilyttää ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge les valeurs par défaut du firmware. Envoyez M500 ensuite pour les conserver."
          }
