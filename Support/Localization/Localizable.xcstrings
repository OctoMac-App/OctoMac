    "The file will be deleted from the printer. This can't be undone.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor bude z tiskárny smazán. Tuto akci nelze vrátit."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Bydd y ffeil yn cael ei dileu o'r argraffydd. Does dim modd dadwneud hyn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen slettes fra printeren. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wird vom Drucker gelöscht. Das kann nicht widerrufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file will be deleted from the printer. This can't be undone."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The file will be deleted from the printer. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se eliminará de la impresora. No se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedosto poistetaan tulostimelta. Tätä ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier sera supprimé de l’imprimante. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file verrà eliminato dalla stampante. Questa azione non può essere annullata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen slettes fra skriveren. Dette kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand wordt van de printer verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zostanie usunięty z drukarki. Tego nie można cofnąć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro será apagado da impressora. Esta ação não pode ser anulada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen raderas från skrivaren. Det går inte att ångra."
          }
        }
      }
    },
    "The folder and everything in it will be deleted from the printer. This can't be undone.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Složka a vše v ní bude z tiskárny smazáno. Tuto akci nelze vrátit."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Bydd y ffolder a phopeth ynddo yn cael eu dileu o'r argraffydd. Does dim modd dadwneud hyn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen og alt i den slettes fra printeren. Det kan ikke fortrydes."
          }
        },
        "de": {
