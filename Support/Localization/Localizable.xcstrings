            "state": "translated",
            "value": "Eso aún no parece una dirección."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä ei vielä näytä osoitteelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne ressemble pas encore à une adresse."
          }
        },
        "it": {
