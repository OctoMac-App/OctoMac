    "%@: check it looks right before it carries on.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: zkontrolujte, že vše vypadá správně, než bude tisk pokračovat."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: gwiriwch ei fod yn edrych yn iawn cyn iddo barhau."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: tjek, at det ser rigtigt ud, før den fortsætter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Prüfe, ob alles gut aussieht, bevor es weitergeht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: check it looks right before it carries on."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: check it looks right before it carries on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: comprueba que todo va bien antes de que continúe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: tarkista, että kaikki näyttää hyvältä, ennen kuin tulostus jatkuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : vérifiez que tout est correct avant de continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: controlla che sia tutto a posto prima che continui."
          }
        },
