    "Homes all axes but skips mesh bed levelling.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najede všemi osami domů, ale vynechá vyrovnání podložky podle sítě."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn cartrefu pob echelin ond yn hepgor lefelu gwely rhwyll."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Homer alle akser, men springer mesh-nivellering af pladen over."
          }
        },
