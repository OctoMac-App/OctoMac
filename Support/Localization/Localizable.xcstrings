            "value": "Vastaa jokaisen lämmittimen nykyisellä ja tavoitelämpötilalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renvoie la température actuelle et la température cible de chaque élément chauffant."
          }
        },
        "it": {
