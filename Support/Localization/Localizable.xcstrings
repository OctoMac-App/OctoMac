            "value": "OctoMac a besoin d’une clé API de ce serveur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac ha bisogno di una chiave API da questo server"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac trenger en API-nøkkel fra denne serveren"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac heeft een API-sleutel van deze server nodig"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac potrzebuje klucza API z tego serwera"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoMac precisa de uma chave da API deste servidor"
          }
        },
        "sv": {
          "stringUnit": {
