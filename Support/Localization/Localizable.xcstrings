            "state": "translated",
            "value": "A impressora não pode fazer isso agora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivaren kan inte göra det just nu."
          }
        }
      }
    },
    "The printer can't do that right now. Is it connected and idle?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiskárna to teď nemůže udělat. Je připojená a nečinná?"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dydy'r argraffydd ddim yn gallu gwneud hynny ar hyn o bryd. Ydy e wedi cysylltu ac yn segur?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Printeren kan ikke gøre det lige nu. Er den forbundet og ledig?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Drucker kann das gerade nicht tun. Ist er verbunden und frei?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer can't do that right now. Is it connected and idle?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer can't do that right now. Is it connected and idle?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora no puede hacer eso ahora mismo. ¿Está conectada e inactiva?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulostin ei voi tehdä sitä juuri nyt. Onko se yhdistetty ja joutilaana?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’imprimante ne peut pas faire cela pour le moment. Est-elle connectée et inactive ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stampante non può farlo in questo momento. È connessa e inattiva?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriveren kan ikke gjøre det akkurat nå. Er den tilkoblet og ledig?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De printer kan dat nu niet. Is hij verbonden en niet bezig?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drukarka nie może tego teraz zrobić. Czy jest połączona i bezczynna?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A impressora não pode fazer isso agora. Está ligada e inativa?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivaren kan inte göra det just nu. Är den ansluten och ledig?"
          }
        }
      }
    },
    "The printer didn't offer any answers. Carry on from its own screen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiskárna nenabídla žádné odpovědi. Pokračujte na jejím displeji."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Wnaeth yr argraffydd ddim cynnig unrhyw atebion. Ewch ymlaen o'i sgrin ei hun."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Printeren tilbød ingen svar. Fortsæt på dens egen skærm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Drucker hat keine Antworten angeboten. Mach am Display des Druckers weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer didn't offer any answers. Carry on from its own screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer didn't offer any answers. Carry on from its own screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora no ha ofrecido ninguna respuesta. Continúa desde su propia pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulostin ei tarjonnut vastausvaihtoehtoja. Jatka tulostimen omalta näytöltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’imprimante n’a proposé aucune réponse. Continuez depuis son propre écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stampante non ha offerto risposte. Continua dal suo schermo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriveren ga ingen svaralternativer. Fortsett fra skriverens egen skjerm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De printer gaf geen antwoorden om uit te kiezen. Ga verder op het eigen scherm van de printer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drukarka nie podała żadnych odpowiedzi. Kontynuuj na jej ekranie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A impressora não ofereceu respostas. Continue no ecrã da própria impressora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivaren gav inga svarsalternativ. Fortsätt på dess egen skärm."
          }
        }
      }
    },
    "The printer goes back to the first layer and prints the whole file again. Clear the bed first, since what's printed so far stays where it is.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiskárna se vrátí na první vrstvu a vytiskne celý soubor znovu. Nejdřív uvolněte podložku, protože to, co je už vytištěné, na ní zůstane."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae'r argraffydd yn mynd yn ôl i'r haen gyntaf ac yn argraffu'r ffeil gyfan eto. Cliriwch y gwely yn gyntaf, gan fod yr hyn sydd wedi'i argraffu hyd yma yn aros lle mae."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Printeren går tilbage til det første lag og printer hele filen igen. Ryd pladen først, for det, der er printet indtil nu, bliver liggende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Drucker beginnt wieder bei der ersten Schicht und druckt die ganze Datei noch einmal. Räum zuerst das Bett ab, denn was bisher gedruckt wurde, bleibt liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer goes back to the first layer and prints the whole file again. Clear the bed first, since what's printed so far stays where it is."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer goes back to the first layer and prints the whole file again. Clear the bed first, since what's printed so far stays where it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora vuelve a la primera capa e imprime de nuevo todo el archivo. Despeja antes la cama, porque lo impreso hasta ahora se queda donde está."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulostin palaa ensimmäiseen kerrokseen ja tulostaa koko tiedoston uudelleen. Tyhjennä alusta ensin, sillä tähän mennessä tulostettu jää paikalleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’imprimante revient à la première couche et réimprime tout le fichier. Dégagez d’abord le plateau, car ce qui a déjà été imprimé reste en place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stampante torna al primo layer e stampa di nuovo l'intero file. Libera prima il piatto, perché ciò che è stato stampato finora resta dov'è."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriveren går tilbake til første lag og skriver ut hele filen på nytt. Rydd platen først, siden det som er skrevet ut så langt, blir liggende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De printer gaat terug naar de eerste laag en print het hele bestand opnieuw. Maak eerst het bed leeg, want wat al geprint is, blijft liggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drukarka wróci do pierwszej warstwy i wydrukuje cały plik od nowa. Najpierw opróżnij stół, bo to, co już wydrukowano, zostanie na miejscu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A impressora volta à primeira camada e imprime o ficheiro inteiro de novo. Limpe a mesa primeiro, pois o que já foi impresso fica onde está."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivaren går tillbaka till första lagret och skriver ut hela filen igen. Töm bädden först, eftersom det som redan skrivits ut ligger kvar."
          }
        }
      }
    },
    "The printer halts immediately: heaters and motors switch off, even mid-move.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiskárna se okamžitě zastaví: topení a motory se vypnou, i uprostřed pohybu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae'r argraffydd yn stopio ar unwaith: mae'r gwresogyddion a'r moduron yn diffodd, hyd yn oed yng nghanol symudiad."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Printeren standser med det samme: Varmelegemer og motorer slukkes, selv midt i en bevægelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Drucker stoppt sofort: Heizungen und Motoren gehen aus, auch mitten in einer Bewegung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer halts immediately: heaters and motors switch off, even mid-move."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer halts immediately: heaters and motors switch off, even mid-move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora se detiene de inmediato: calentadores y motores se apagan, incluso a mitad de un movimiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulostin pysähtyy heti: lämmittimet ja moottorit sammuvat, vaikka liike olisi kesken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’imprimante s’arrête immédiatement : les éléments chauffants et les moteurs se coupent, même en plein mouvement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stampante si ferma subito: riscaldatori e motori si spengono, anche durante un movimento."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriveren stopper umiddelbart: varmeelementer og motorer slås av, selv midt i en bevegelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De printer stopt onmiddellijk: verwarming en motoren gaan uit, zelfs midden in een beweging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drukarka natychmiast się zatrzymuje: grzałki i silniki wyłączają się, nawet w trakcie ruchu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A impressora para de imediato: aquecedores e motores desligam-se, mesmo a meio de um movimento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivaren stannar omedelbart: värmare och motorer stängs av, även mitt i en rörelse."
          }
        }
      }
    },
