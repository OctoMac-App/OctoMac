    "The printer stopped replying to OctoPrint. Check it's still switched on, then connect again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiskárna přestala odpovídat OctoPrintu. Zkontrolujte, že je stále zapnutá, a připojte se znovu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopiodd yr argraffydd ateb OctoPrint. Gwiriwch ei fod yn dal ymlaen, yna cysylltwch eto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Printeren holdt op med at svare OctoPrint. Tjek, at den stadig er tændt, og forbind igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Drucker antwortet OctoPrint nicht mehr. Prüfe, ob er noch eingeschaltet ist, und verbinde dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer stopped replying to OctoPrint. Check it's still switched on, then connect again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer stopped replying to OctoPrint. Check it's still switched on, then connect again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora ha dejado de responder a OctoPrint. Comprueba que sigue encendida y vuelve a conectar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulostin lakkasi vastaamasta OctoPrintille. Tarkista, että se on yhä päällä, ja yhdistä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’imprimante a cessé de répondre à OctoPrint. Vérifiez qu’elle est toujours allumée, puis reconnectez-la."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stampante ha smesso di rispondere a OctoPrint. Controlla che sia ancora accesa, poi connettiti di nuovo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriveren sluttet å svare OctoPrint. Sjekk at den fortsatt er slått på, og koble til igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De printer reageerde niet meer op OctoPrint. Controleer of hij nog aanstaat en maak opnieuw verbinding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drukarka przestała odpowiadać OctoPrint. Sprawdź, czy nadal jest włączona, i połącz ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A impressora deixou de responder ao OctoPrint. Verifique se continua ligada e volte a clicar em Ligar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivaren slutade svara OctoPrint. Kontrollera att den fortfarande är påslagen och anslut sedan igen."
          }
        }
      }
    },
