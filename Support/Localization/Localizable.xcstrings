    "Tells the printer where it is without moving. G92 E0 resets the extruder count.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řekne tiskárně, kde je, bez pohybu. G92 E0 vynuluje počítadlo extruderu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn dweud wrth yr argraffydd ble mae heb symud. Mae G92 E0 yn ailosod cyfrif yr allwthiwr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortæller printeren, hvor den er, uden at flytte sig. G92 E0 nulstiller extruderens tæller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagt dem Drucker, wo er ist, ohne ihn zu bewegen. G92 E0 setzt den Extruderzähler zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells the printer where it is without moving. G92 E0 resets the extruder count."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells the printer where it is without moving. G92 E0 resets the extruder count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica a la impresora dónde está sin moverse. G92 E0 pone a cero el contador del extrusor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kertoo tulostimelle sen sijainnin liikkumatta. G92 E0 nollaa ekstruuderin laskurin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique à l’imprimante sa position sans la déplacer. G92 E0 remet à zéro le compteur de l’extrudeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice alla stampante dove si trova senza muoverla. G92 E0 azzera il conteggio dell'estrusore."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forteller skriveren hvor den er uten å flytte seg. G92 E0 nullstiller ekstruderingstelleren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertelt de printer waar hij is zonder te bewegen. G92 E0 zet de extrudertelling op nul."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informuje drukarkę, gdzie jest, bez ruchu. G92 E0 zeruje licznik ekstrudera."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica à impressora onde está sem a mover. G92 E0 repõe a contagem da extrusora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Talar om för skrivaren var den är utan att röra sig. G92 E0 nollställer extruderns räknare."
          }
        }
      }
    },
