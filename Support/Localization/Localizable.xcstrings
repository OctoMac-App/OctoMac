    "Demo mode is on. Your own printers come back when you leave it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukázkový režim je zapnutý. Vaše tiskárny se vrátí, až ho opustíte."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae'r modd arddangos ymlaen. Bydd eich argraffwyr eich hun yn dod yn ôl pan fyddwch chi'n ei adael."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Demotilstand er slået til. Dine egne printere kommer tilbage, når du forlader den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Demomodus ist aktiv. Deine eigenen Drucker kommen zurück, wenn du ihn beendest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo mode is on. Your own printers come back when you leave it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo mode is on. Your own printers come back when you leave it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de demostración está activado. Tus impresoras volverán cuando salgas de él."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esittelytila on päällä. Omat tulostimesi palaavat, kun poistut siitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode démo est activé. Vos imprimantes reviennent quand vous le quittez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità demo è attiva. Le tue stampanti tornano quando la lasci."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Demomodus er på. Dine egne skrivere kommer tilbake når du går ut av den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Demomodus staat aan. Je eigen printers komen terug als je de demo verlaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb demo jest włączony. Twoje drukarki wrócą, gdy go opuścisz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo de demonstração está ativo. As suas impressoras voltam quando sair dele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Demoläget är på. Dina egna skrivare kommer tillbaka när du lämnar det."
          }
        }
      }
    },
