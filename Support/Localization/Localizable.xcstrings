            "state": "translated",
            "value": "Het HTTPS-certificaat van deze printer wordt nog niet vertrouwd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Certyfikat HTTPS tej drukarki nie jest jeszcze zaufany."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O certificado HTTPS desta impressora ainda não é de confiança."
          }
        },
        "sv": {
          "stringUnit": {
