    "Includes about 5 minutes to heat up. OctoMac needs to be open at the start time.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahrnuje asi 5 minut na ohřev. OctoMac musí být v čase spuštění otevřený."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn cynnwys tua 5 munud i wresogi. Mae angen i OctoMac fod ar agor ar yr amser dechrau."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkluderer ca. 5 minutters opvarmning. OctoMac skal være åben på starttidspunktet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält etwa 5 Minuten zum Aufheizen. OctoMac muss zur Startzeit geöffnet sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes about 5 minutes to heat up. OctoMac needs to be open at the start time."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes about 5 minutes to heat up. OctoMac needs to be open at the start time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye unos 5 minutos para calentar. OctoMac tiene que estar abierto a la hora de inicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisältää noin 5 minuuttia lämpenemiseen. OctoMacin täytyy olla auki aloitusaikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclut environ 5 minutes de chauffe. OctoMac doit être ouvert à l’heure de début."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Include circa 5 minuti per il riscaldamento. OctoMac deve essere aperto all'ora di inizio."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkluderer omtrent 5 minutter oppvarming. OctoMac må være åpen ved starttidspunktet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclusief ongeveer 5 minuten opwarmen. OctoMac moet op de starttijd geopend zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obejmuje około 5 minut nagrzewania. OctoMac musi być otwarty w chwili startu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui cerca de 5 minutos para aquecer. O OctoMac tem de estar aberto à hora de início."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inklusive cirka 5 minuters uppvärmning. OctoMac måste vara öppet vid starttiden."
          }
        }
      }
    },
