    "Unloads filament from the hotend. On an MMU, M702 C unloads the current slot.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vysune filament z hotendu. Na MMU vysune M702 C aktuální slot."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn dadlwytho ffilament o'r hotend. Ar MMU, mae M702 C yn dadlwytho'r slot presennol."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tager filament ud af hotenden. På en MMU tager M702 C den aktuelle plads ud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entlädt Filament aus dem Hotend. Bei einer MMU entlädt M702 C den aktuellen Slot."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unloads filament from the hotend. On an MMU, M702 C unloads the current slot."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Unloads filament from the hotend. On an MMU, M702 C unloads the current slot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga el filamento del hotend. En un MMU, M702 C descarga la ranura actual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa filamentin hotendista. MMU:ssa M702 C poistaa nykyisen paikan filamentin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décharge le filament du hotend. Sur un MMU, M702 C décharge l’emplacement actuel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica il filamento dall'hotend. Su un MMU, M702 C scarica lo slot attuale."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Laster filament ut av hotenden. På en MMU laster M702 C ut gjeldende spor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontlaadt filament uit de hotend. Op een MMU ontlaadt M702 C het huidige slot."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyładowuje filament z hotendu. W MMU M702 C wyładowuje bieżący slot."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Retira o filamento do hotend. Num MMU, M702 C retira o da ranhura atual."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Matar ut filament från hotenden. På en MMU matar M702 C ut den aktuella platsen."
          }
        }
      }
    },
