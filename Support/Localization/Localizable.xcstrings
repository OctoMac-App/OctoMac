    "From OctoPrint's official plugin list. Plugins are made by the OctoPrint community, not by OctoMac.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z oficiálního seznamu pluginů OctoPrintu. Pluginy vytváří komunita OctoPrintu, ne OctoMac."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "O restr ategion swyddogol OctoPrint. Cymuned OctoPrint sy'n gwneud yr ategion, nid OctoMac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra OctoPrints officielle pluginliste. Plugins laves af OctoPrint-fællesskabet, ikke af OctoMac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus der offiziellen Plugin-Liste von OctoPrint. Plugins stammen von der OctoPrint-Community, nicht von OctoMac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From OctoPrint's official plugin list. Plugins are made by the OctoPrint community, not by OctoMac."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "From OctoPrint's official plugin list. Plugins are made by the OctoPrint community, not by OctoMac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De la lista oficial de plugins de OctoPrint. Los plugins los crea la comunidad de OctoPrint, no OctoMac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrintin virallisesta lisäosaluettelosta. Lisäosat tekee OctoPrint-yhteisö, ei OctoMac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Issus de la liste officielle des plugins d’OctoPrint. Les plugins sont créés par la communauté OctoPrint, pas par OctoMac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dall'elenco ufficiale dei plugin di OctoPrint. I plugin sono creati dalla comunità di OctoPrint, non da OctoMac."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra OctoPrints offisielle utvidelsesliste. Utvidelsene er laget av OctoPrint-fellesskapet, ikke av OctoMac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit de officiële plug-inlijst van OctoPrint. Plug-ins worden gemaakt door de OctoPrint-community, niet door OctoMac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z oficjalnej listy wtyczek OctoPrint. Wtyczki tworzy społeczność OctoPrint, nie OctoMac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Da lista oficial de plugins do OctoPrint. Os plugins são feitos pela comunidade do OctoPrint, não pelo OctoMac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från OctoPrints officiella pluginlista. Pluginen görs av OctoPrint-communityn, inte av OctoMac."
          }
        }
      }
    },
    "From OctoPrint's records of each file: how often it finished or failed, and its usual print time and filament.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze záznamů OctoPrintu o každém souboru: jak často byl dokončen nebo selhal a jeho obvyklá doba tisku a spotřeba filamentu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "O gofnodion OctoPrint ar gyfer pob ffeil: pa mor aml y gorffennodd neu y methodd, a'i amser argraffu a'i ffilament arferol."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra OctoPrints registreringer af hver fil: hvor ofte den blev færdig eller mislykkedes, og dens typiske printtid og filamentforbrug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus OctoPrints Aufzeichnungen zu jeder Datei: wie oft sie fertig wurde oder fehlschlug und ihre übliche Druckzeit und Filamentmenge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From OctoPrint's records of each file: how often it finished or failed, and its usual print time and filament."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "From OctoPrint's records of each file: how often it finished or failed, and its usual print time and filament."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según los registros de OctoPrint de cada archivo: cuántas veces terminó o falló, y su tiempo de impresión y filamento habituales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrintin tiedoista kustakin tiedostosta: kuinka usein se valmistui tai epäonnistui sekä sen tavallinen tulostusaika ja filamentti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’après l’historique d’OctoPrint pour chaque fichier : combien de fois il a réussi ou échoué, avec sa durée d’impression et son filament habituels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai dati di OctoPrint su ogni file: quante volte è terminato o non è riuscito, e il tempo di stampa e il filamento abituali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra OctoPrints oversikt over hver fil: hvor ofte den ble ferdig eller mislyktes, og vanlig utskriftstid og filamentforbruk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit wat OctoPrint over elk bestand bijhoudt: hoe vaak het voltooid of mislukt is, en de gebruikelijke printtijd en hoeveelheid filament."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z zapisów OctoPrint dla każdego pliku: jak często się udał lub nie, a także typowy czas druku i zużycie filamentu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base nos registos do OctoPrint de cada ficheiro: quantas vezes terminou ou falhou, e o tempo de impressão e filamento habituais."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från OctoPrints uppgifter om varje fil: hur ofta den blev klar eller misslyckades, och dess vanliga utskriftstid och filamentåtgång."
          }
        }
      }
    },
