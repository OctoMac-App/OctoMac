          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara i skrivaren"
          }
        }
      }
    },
    "Keep in the printer sends M500. Printers with a bed probe then keep the nudge as their Z offset. Without a probe, add it to your slicer's Z offset instead.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložit do tiskárny odešle M500. Tiskárny se sondou podložky si pak doladění ponechají jako offset Z. Bez sondy ho místo toho přičtěte k offsetu Z ve sliceru."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae Cadw yn yr argraffydd yn anfon M500. Bydd argraffyddion sydd â chwiliedydd gwely wedyn yn cadw'r addasiad fel eu gwrthbwyso Z. Heb chwiliedydd, ychwanegwch ef at wrthbwyso Z eich sleisiwr yn lle hynny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem i printeren sender M500. Printere med en sengeprobe gemmer så justeringen som deres Z-offset. Uden probe skal du i stedet lægge den til din slicers Z-offset."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Im Drucker speichern“ sendet M500. Drucker mit Bettsensor übernehmen die Korrektur dann als Z-Offset. Ohne Sensor trägst du sie stattdessen im Z-Offset deines Slicers ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep in the printer sends M500. Printers with a bed probe then keep the nudge as their Z offset. Without a probe, add it to your slicer's Z offset instead."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep in the printer sends M500. Printers with a bed probe then keep the nudge as their Z offset. Without a probe, add it to your slicer's Z offset instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar en la impresora envía M500. Las impresoras con sonda de cama conservan entonces el ajuste como su offset Z. Sin sonda, añádelo al offset Z de tu slicer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilytä tulostimessa -painike lähettää komennon M500. Tulostimet, joissa on alustan mittausanturi, säilyttävät säädön Z-siirtymänään. Jos anturia ei ole, lisää säätö sen sijaan slicerin Z-siirtymään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder dans l’imprimante envoie M500. Les imprimantes équipées d’une sonde de plateau conservent alors l’ajustement comme décalage Z. Sans sonde, ajoutez-le plutôt au décalage Z de votre slicer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni nella stampante invia M500. Le stampanti con sonda del piatto mantengono poi la regolazione come offset Z. Senza sonda, aggiungila invece all'offset Z dello slicer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold i skriveren sender M500. Skrivere med måleprobe beholder da justeringen som Z-forskyvning. Uten probe legger du den heller til i Z-forskyvningen i sliceren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar in de printer verstuurt M500. Printers met een bedprobe bewaren de bijstelling dan als hun Z-offset. Zonder probe tel je hem in plaats daarvan op bij de Z-offset in je slicer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj w drukarce wysyła M500. Drukarki z sondą stołu zachowają wtedy korektę jako swoje przesunięcie Z. Bez sondy dodaj ją zamiast tego do przesunięcia Z w slicerze."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar na impressora envia M500. As impressoras com sonda da mesa passam a usar o ajuste como desvio Z. Sem sonda, adicione-o antes ao desvio Z do seu slicer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara i skrivaren skickar M500. Skrivare med bäddsond behåller då justeringen som sin Z-förskjutning. Utan sond lägger du i stället till den i slicerns Z-förskjutning."
          }
        }
      }
    },
