    "Added %lld printers, and skipped %lld already here. Approve each one in OctoPrint to connect.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidané tiskárny: %1$lld. Přeskočené, protože už tu jsou: %2$lld. Pro připojení každou novou schvalte v OctoPrintu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Argraffwyr wedi'u hychwanegu: %1$lld. Wedi'u hepgor am eu bod yma'n barod: %2$lld. Cymeradwywch bob un newydd yn OctoPrint i gysylltu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføjede printere: %1$lld. Sprunget over, fordi de allerede er her: %2$lld. Godkend hver ny printer i OctoPrint for at oprette forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzugefügte Drucker: %1$lld. Übersprungen, weil schon vorhanden: %2$lld. Bestätige jeden neuen in OctoPrint, um ihn zu verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Printers added: %1$lld. Skipped because they're already here: %2$lld. Approve each new one in OctoPrint to connect."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Printers added: %1$lld. Skipped because they're already here: %2$lld. Approve each new one in OctoPrint to connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impresoras añadidas: %1$lld. Omitidas por estar ya aquí: %2$lld. Aprueba cada una nueva en OctoPrint para conectarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisätyt tulostimet: %1$lld. Ohitetut, koska ne ovat jo täällä: %2$lld. Hyväksy jokainen uusi OctoPrintissa, niin yhteys muodostuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprimantes ajoutées : %1$lld. Déjà présentes, donc ignorées : %2$lld. Approuvez chaque nouvelle imprimante dans OctoPrint pour vous connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stampanti aggiunte: %1$lld. Già presenti e saltate: %2$lld. Approva ciascuna nuova stampante in OctoPrint per collegarti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivere lagt til: %1$lld. Allerede her og hoppet over: %2$lld. Godkjenn hver nye skriver i OctoPrint for å koble til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Printers toegevoegd: %1$lld. Al aanwezig en overgeslagen: %2$lld. Keur elke nieuwe printer goed in OctoPrint om verbinding te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodane drukarki: %1$lld. Pominięte, bo już są: %2$lld. Zatwierdź każdą nową drukarkę w OctoPrint, aby się połączyć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
