    "Afterwards, reset the printer (press the knob or power cycle) and reconnect it here.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poté tiskárnu resetujte (stiskněte ovladač nebo ji vypněte a zapněte) a znovu ji zde připojte."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Wedyn, ailosodwch yr argraffydd (pwyswch y bwlyn neu ei ddiffodd a'i droi ymlaen eto) a'i ailgysylltu yma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulstil derefter printeren (tryk på knappen, eller sluk og tænd den), og forbind den igen her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze den Drucker danach zurück (Drehknopf drücken oder aus- und wieder einschalten) und verbinde ihn hier erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Afterwards, reset the printer (press the knob or power cycle) and reconnect it here."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Afterwards, reset the printer (press the knob or power cycle) and reconnect it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, reinicia la impresora (pulsa el mando o apágala y enciéndela) y vuelve a conectarla aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nollaa sen jälkeen tulostin (paina säätönuppia tai katkaise virta hetkeksi) ja yhdistä se uudelleen tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, réinitialisez l’imprimante (appuyez sur le bouton ou éteignez-la puis rallumez-la) et reconnectez-la ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi resetta la stampante (premi la manopola o spegnila e riaccendila) e ricollegala qui."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbakestill deretter skriveren (trykk på knappen eller slå den av og på) og koble den til igjen her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset daarna de printer (druk op de knop of zet hem uit en weer aan) en maak hier opnieuw verbinding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następnie zresetuj drukarkę (naciśnij pokrętło lub wyłącz i włącz zasilanie) i połącz ją tutaj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois, reinicie a impressora (prima o botão rotativo ou desligue e volte a ligar a alimentação) e volte a ligá-la aqui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställ sedan skrivaren (tryck på ratten eller slå av och på strömmen) och anslut den igen här."
          }
        }
      }
    },
