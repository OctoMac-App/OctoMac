            "state": "translated",
            "value": "El hotend tiene que estar caliente para que la impresora empuje el filamento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotendin täytyy olla kuuma, ennen kuin tulostin pursottaa filamenttia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le hotend doit être chaud pour que l’imprimante pousse du filament."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hotend deve essere caldo prima che la stampante spinga il filamento."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotenden må være varm før skriveren vil mate filament."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
