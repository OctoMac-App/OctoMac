    "Restarting OctoPrint. OctoMac reconnects when it's back, usually within a minute.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Restartuje se OctoPrint. OctoMac se znovu připojí, jakmile bude zpět, obvykle do minuty."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn ailgychwyn OctoPrint. Mae OctoMac yn ailgysylltu pan fydd yn ôl, fel arfer o fewn munud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genstarter OctoPrint. OctoMac forbinder igen, når det er tilbage, normalt inden for et minut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint wird neu gestartet. OctoMac verbindet sich wieder, sobald es zurück ist, meist innerhalb einer Minute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restarting OctoPrint. OctoMac reconnects when it's back, usually within a minute."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Restarting OctoPrint. OctoMac reconnects when it's back, usually within a minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiniciando OctoPrint. OctoMac se volverá a conectar cuando vuelva, normalmente en menos de un minuto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint käynnistyy uudelleen. OctoMac yhdistää uudelleen, kun se palaa, yleensä minuutin sisällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarrage d’OctoPrint. OctoMac se reconnecte dès son retour, généralement en moins d’une minute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riavvio di OctoPrint. OctoMac si riconnette quando torna attivo, di solito entro un minuto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter OctoPrint på nytt. OctoMac kobler til igjen når den er tilbake, vanligvis innen et minutt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint wordt herstart. OctoMac maakt opnieuw verbinding zodra het terug is, meestal binnen een minuut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponowne uruchamianie OctoPrint. OctoMac połączy się ponownie, gdy wróci, zwykle w ciągu minuty."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A reiniciar o OctoPrint. O OctoMac volta a ligar-se quando ele voltar, normalmente dentro de um minuto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Startar om OctoPrint. OctoMac ansluter igen när det är tillbaka, oftast inom en minut."
          }
        }
      }
    },
