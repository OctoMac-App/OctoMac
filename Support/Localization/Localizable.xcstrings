    "This printer's firmware has a known bug that can spoil prints or upset OctoPrint.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmware této tiskárny má známou chybu, která může pokazit tisky nebo zmást OctoPrint."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae gan gadarnwedd yr argraffydd hwn fyg hysbys a all ddifetha argraffiadau neu darfu ar OctoPrint."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne printers firmware har en kendt fejl, der kan ødelægge prints eller forstyrre OctoPrint."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Firmware dieses Druckers hat einen bekannten Fehler, der Drucke verderben oder OctoPrint durcheinanderbringen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This printer's firmware has a known bug that can spoil prints or upset OctoPrint."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This printer's firmware has a known bug that can spoil prints or upset OctoPrint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El firmware de esta impresora tiene un error conocido que puede estropear impresiones o confundir a OctoPrint."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän tulostimen firmwaressa on tunnettu bugi, joka voi pilata tulosteita tai sotkea OctoPrintin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le firmware de cette imprimante a un bug connu qui peut gâcher des impressions ou perturber OctoPrint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il firmware di questa stampante ha un bug noto che può rovinare le stampe o mandare in confusione OctoPrint."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmwaren på denne skriveren har en kjent feil som kan ødelegge utskrifter eller forstyrre OctoPrint."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De firmware van deze printer heeft een bekende fout die prints kan verpesten of OctoPrint kan verstoren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmware tej drukarki ma znany błąd, który może psuć wydruki lub zakłócać pracę OctoPrint."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O firmware desta impressora tem um erro conhecido que pode estragar impressões ou perturbar o OctoPrint."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här skrivarens firmware har en känd bugg som kan förstöra utskrifter eller störa OctoPrint."
          }
        }
      }
    },
    "This printer's firmware has a known safety problem. Don't leave it printing alone until it's fixed.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmware této tiskárny má známý bezpečnostní problém. Dokud nebude opravený, nenechávejte ji tisknout bez dozoru."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae gan gadarnwedd yr argraffydd hwn broblem diogelwch hysbys. Peidiwch â'i adael yn argraffu ar ei ben ei hun nes ei bod wedi'i thrwsio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne printers firmware har et kendt sikkerhedsproblem. Lad den ikke printe uden opsyn, før det er rettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Firmware dieses Druckers hat ein bekanntes Sicherheitsproblem. Lass ihn nicht unbeaufsichtigt drucken, bis es behoben ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This printer's firmware has a known safety problem. Don't leave it printing alone until it's fixed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This printer's firmware has a known safety problem. Don't leave it printing alone until it's fixed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El firmware de esta impresora tiene un problema de seguridad conocido. No la dejes imprimiendo sola hasta que se corrija."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän tulostimen firmwaressa on tunnettu turvallisuusongelma. Älä jätä sitä tulostamaan valvomatta, ennen kuin se on korjattu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le firmware de cette imprimante a un problème de sécurité connu. Ne la laissez pas imprimer sans surveillance tant qu’il n’est pas corrigé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il firmware di questa stampante ha un problema di sicurezza noto. Non lasciarla stampare da sola finché non è risolto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmwaren på denne skriveren har et kjent sikkerhetsproblem. Ikke la den skrive ut uten tilsyn før det er fikset."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De firmware van deze printer heeft een bekend veiligheidsprobleem. Laat hem niet alleen printen totdat het is opgelost."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmware tej drukarki ma znany problem z bezpieczeństwem. Nie zostawiaj jej drukującej bez nadzoru, dopóki nie zostanie naprawiony."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O firmware desta impressora tem um problema de segurança conhecido. Não a deixe a imprimir sozinha até estar corrigido."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här skrivarens firmware har ett känt säkerhetsproblem. Lämna den inte att skriva ut ensam förrän det är åtgärdat."
          }
        }
      }
    },
