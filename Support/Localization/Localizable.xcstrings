    "Connection options load once OctoPrint is reachable.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Možnosti připojení se načtou, jakmile bude OctoPrint dostupný."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae opsiynau cysylltu'n llwytho pan fydd modd cyrraedd OctoPrint."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbindelsesmuligheder indlæses, når OctoPrint kan nås."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungsoptionen werden geladen, sobald OctoPrint erreichbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection options load once OctoPrint is reachable."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection options load once OctoPrint is reachable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las opciones de conexión se cargan cuando OctoPrint esté accesible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteysvalinnat latautuvat, kun OctoPrint on tavoitettavissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les options de connexion se chargent dès qu’OctoPrint est accessible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le opzioni di connessione si caricano quando OctoPrint è raggiungibile."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilkoblingsvalg lastes inn når OctoPrint kan nås."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindingsopties worden geladen zodra OctoPrint bereikbaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcje połączenia wczytają się, gdy OctoPrint będzie osiągalny."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
