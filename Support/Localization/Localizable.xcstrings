          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pianifica quando stampare: finisci all'ora che preferisci"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlegg når du skal skrive ut: bli ferdig til et tidspunkt som passer deg"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan wanneer je print: klaar op een tijd die jou uitkomt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaplanuj, kiedy drukować: koniec o wygodnej porze"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
