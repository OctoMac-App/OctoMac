    "Stops everything at once. The printer must be reset and reconnected afterwards.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Okamžitě zastaví vše. Tiskárnu pak musíte resetovat a znovu připojit."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn stopio popeth ar unwaith. Rhaid ailosod ac ailgysylltu'r argraffydd wedyn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopper alt med det samme. Printeren skal nulstilles og forbindes igen bagefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt alles auf einmal. Der Drucker muss danach zurückgesetzt und neu verbunden werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops everything at once. The printer must be reset and reconnected afterwards."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops everything at once. The printer must be reset and reconnected afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo detiene todo de golpe. Después hay que reiniciar la impresora y volver a conectarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysäyttää kaiken kerralla. Tulostin täytyy sen jälkeen nollata ja yhdistää uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête tout immédiatement. L’imprimante devra ensuite être réinitialisée et reconnectée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferma tutto all'istante. In seguito la stampante deve essere resettata e ricollegata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopper alt på én gang. Skriveren må tilbakestilles og kobles til igjen etterpå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopt alles in één keer. De printer moet daarna worden gereset en opnieuw verbonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymuje wszystko naraz. Potem trzeba zresetować drukarkę i połączyć ją ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para tudo de uma vez. Depois, a impressora tem de ser reiniciada e ligada novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppar allt på en gång. Skrivaren måste återställas och anslutas igen efteråt."
          }
        }
      }
    },
    "Stops tiny layers or vase mode filling the video.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabrání, aby video zaplnily drobné vrstvy nebo režim vázy."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn atal haenau bach iawn neu'r modd fâs rhag llenwi'r fideo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhindrer, at små lag eller vasetilstand fylder videoen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass winzige Schichten oder der Vasenmodus das Video füllen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops tiny layers or vase mode filling the video."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops tiny layers or vase mode filling the video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que las capas diminutas o el modo jarrón llenen el vídeo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Estää pieniä kerroksia tai maljakkotilaa täyttämästä videota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évite que les couches très fines ou le mode vase remplissent la vidéo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita che layer minuscoli o la modalità vaso riempiano il video."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindrer at bittesmå lag eller vasemodus fyller videoen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorkomt dat heel dunne lagen of vaasmodus de video vullen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapobiega temu, by bardzo cienkie warstwy lub tryb wazy zapełniły film."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que camadas muito finas ou o modo vaso encham o vídeo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindrar att pyttesmå lager eller vasläge fyller videon."
          }
        }
      }
    },
    "Stops until someone presses the printer's knob or button.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví, dokud někdo nestiskne ovladač nebo tlačítko tiskárny."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn stopio nes bod rhywun yn pwyso bwlyn neu fotwm yr argraffydd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopper, indtil nogen trykker på printerens knap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält an, bis jemand den Knopf oder die Taste am Drucker drückt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops until someone presses the printer's knob or button."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops until someone presses the printer's knob or button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detiene hasta que alguien pulse el mando o el botón de la impresora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysähtyy, kunnes joku painaa tulostimen säätönuppia tai painiketta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’arrête jusqu’à ce que quelqu’un appuie sur le bouton de l’imprimante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ferma finché qualcuno non preme la manopola o il pulsante della stampante."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter til noen trykker på knappen på skriveren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopt tot iemand op de knop van de printer drukt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymuje się, dopóki ktoś nie naciśnie pokrętła lub przycisku drukarki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para até alguém premir o botão da impressora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stannar tills någon trycker på skrivarens ratt eller knapp."
          }
        }
      }
    },
