    "The profile is removed from OctoPrint. Printers using it switch to the default profile.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil bude z OctoPrintu odstraněn. Tiskárny, které ho používají, přejdou na výchozí profil."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Bydd y proffil yn cael ei dynnu o OctoPrint. Bydd argraffwyr sy'n ei ddefnyddio yn newid i'r proffil rhagosodedig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilen fjernes fra OctoPrint. Printere, der bruger den, skifter til standardprofilen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil wird aus OctoPrint entfernt. Drucker, die es nutzen, wechseln zum Standardprofil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile is removed from OctoPrint. Printers using it switch to the default profile."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile is removed from OctoPrint. Printers using it switch to the default profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil se eliminará de OctoPrint. Las impresoras que lo usan pasarán al perfil predeterminado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiili poistetaan OctoPrintista. Sitä käyttävät tulostimet siirtyvät oletusprofiiliin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil est supprimé d’OctoPrint. Les imprimantes qui l’utilisent passent au profil par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il profilo viene eliminato da OctoPrint. Le stampanti che lo usano passano al profilo predefinito."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilen slettes fra OctoPrint. Skrivere som bruker den, bytter til standardprofilen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het profiel wordt uit OctoPrint verwijderd. Printers die het gebruiken, schakelen over naar het standaardprofiel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil zostanie usunięty z OctoPrint. Drukarki, które go używają, przełączą się na profil domyślny."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil é removido do OctoPrint. As impressoras que o usam passam para o perfil predefinido."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilen tas bort från OctoPrint. Skrivare som använder den byter till standardprofilen."
          }
        }
      }
    },
