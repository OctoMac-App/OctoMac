    "Parks the head and walks you through swapping filament on the printer's screen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaparkuje hlavu a provede vás výměnou filamentu na displeji tiskárny."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn parcio'r pen ac yn eich tywys drwy gyfnewid ffilament ar sgrin yr argraffydd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Parkerer hovedet og guider dig gennem filamentskiftet på printerens skærm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Parkt den Kopf und führt dich auf dem Display des Druckers durch den Filamentwechsel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parks the head and walks you through swapping filament on the printer's screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Parks the head and walks you through swapping filament on the printer's screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparca el cabezal y te guía para cambiar el filamento en la pantalla de la impresora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirtää pään sivuun ja opastaa filamentin vaihdossa tulostimen näytöllä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gare la tête et vous guide pour changer le filament sur l’écran de l’imprimante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcheggia la testina e ti guida nel cambio del filamento sullo schermo della stampante."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Parkerer hodet og leder deg gjennom filamentbyttet på skriverens skjerm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Parkeert de kop en helpt je via het scherm van de printer met het wisselen van filament."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Parkuje głowicę i prowadzi cię przez wymianę filamentu na ekranie drukarki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estaciona a cabeça e orienta-o na troca de filamento no ecrã da impressora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parkerar huvudet och guidar dig genom filamentbytet på skrivarens skärm."
          }
        }
      }
    },
