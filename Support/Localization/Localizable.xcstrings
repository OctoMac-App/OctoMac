    "Save your printer list to move it to another Mac. API keys and sign-ins aren't included.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte seznam tiskáren a přeneste ho na jiný Mac. Klíče API a přihlášení se nezahrnují."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadwch eich rhestr argraffwyr i'w symud i Mac arall. Dydy allweddi API a manylion mewngofnodi ddim wedi'u cynnwys."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem din printerliste for at flytte den til en anden Mac. API-nøgler og logins medtages ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere deine Druckerliste, um sie auf einen anderen Mac zu übertragen. API-Schlüssel und Anmeldungen sind nicht enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your printer list to move it to another Mac. API keys and sign-ins aren't included."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your printer list to move it to another Mac. API keys and sign-ins aren't included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tu lista de impresoras para pasarla a otro Mac. No incluye las claves de API ni los inicios de sesión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna tulostinluettelo siirtääksesi sen toiseen Maciin. API-avaimet ja kirjautumistiedot eivät tule mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez votre liste d’imprimantes pour la transférer sur un autre Mac. Les clés API et les connexions ne sont pas incluses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva l'elenco delle stampanti per spostarlo su un altro Mac. Chiavi API e accessi non sono inclusi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre skriverlisten for å flytte den til en annen Mac. API-nøkler og pålogginger er ikke med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar je printerlijst om hem naar een andere Mac te verhuizen. API-sleutels en aanmeldingen zitten er niet bij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz listę drukarek, aby przenieść ją na innego Maca. Klucze API i dane logowania nie są dołączone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde a lista de impressoras para a passar para outro Mac. As chaves da API e os inícios de sessão não estão incluídos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara skrivarlistan för att flytta den till en annan Mac. API-nycklar och inloggningar ingår inte."
          }
        }
      }
    },
    "Saves the current settings so they survive a restart.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloží aktuální nastavení, aby přežilo restart."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn cadw'r gosodiadau presennol fel eu bod yn goroesi ailgychwyn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemmer de aktuelle indstillinger, så de overlever en genstart."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert die aktuellen Einstellungen, damit sie einen Neustart überstehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the current settings so they survive a restart."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the current settings so they survive a restart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda los ajustes actuales para que se conserven tras un reinicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallentaa nykyiset asetukset, jotta ne säilyvät uudelleenkäynnistyksen yli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre les réglages actuels pour qu’ils survivent à un redémarrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva le impostazioni attuali così restano dopo un riavvio."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagrer gjeldende innstillinger så de overlever en omstart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart de huidige instellingen zodat ze een herstart overleven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje bieżące ustawienia, aby przetrwały restart."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda as definições atuais para que se mantenham após reiniciar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparar de aktuella inställningarna så att de finns kvar efter en omstart."
          }
        }
      }
