    "Loads the firmware's defaults. Send M500 afterwards to keep them.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načte výchozí hodnoty firmwaru. Pro jejich zachování pak pošlete M500."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn llwytho rhagosodiadau'r gadarnwedd. Anfonwch M500 wedyn i'w cadw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indlæser firmwarens standardværdier. Send M500 bagefter for at beholde dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt die Standardwerte der Firmware. Sende danach M500, um sie zu behalten."
          }
        },
        "en": {
