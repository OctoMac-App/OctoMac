        }
      }
    },
    "A rough guess from progress so far. It gets better as the print goes on.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hrubý odhad podle dosavadního průběhu. S postupem tisku se zpřesňuje."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Amcangyfrif bras o'r cynnydd hyd yma. Mae'n gwella wrth i'r argraffu fynd yn ei flaen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et groft skøn ud fra fremskridtet indtil nu. Det bliver mere præcist, efterhånden som printet skrider frem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine grobe Schätzung anhand des bisherigen Fortschritts. Sie wird im Verlauf des Drucks genauer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rough guess from progress so far. It gets better as the print goes on."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A rough guess from progress so far. It gets better as the print goes on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una estimación aproximada según el progreso hasta ahora. Mejora a medida que avanza la impresión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Karkea arvio tähänastisen edistymisen perusteella. Se tarkentuu tulostuksen edetessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une estimation d’après la progression actuelle. Elle s’affine au fil de l’impression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stima approssimativa basata sull'avanzamento finora. Diventa più precisa man mano che la stampa procede."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et grovt anslag basert på fremdriften så langt. Det blir bedre etter hvert som utskriften går."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ruwe schatting op basis van de voortgang tot nu toe. Die wordt nauwkeuriger naarmate de print vordert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przybliżone oszacowanie na podstawie dotychczasowego postępu. Z czasem staje się dokładniejsze."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma estimativa aproximada com base no progresso até agora. Fica mais precisa à medida que a impressão avança."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En grov uppskattning utifrån förloppet hittills. Den blir bättre ju längre utskriften pågår."
          }
        }
      }
    },
    "A stopped print can't be resumed. The part stays on the bed as it is, and OctoPrint runs its cancel routine, which usually turns the heaters off and parks the print head.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastavený tisk nelze obnovit. Výtisk zůstane na podložce tak, jak je, a OctoPrint spustí svou rutinu pro zrušení, která obvykle vypne topení a zaparkuje tiskovou hlavu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Does dim modd ailddechrau argraffiad sydd wedi'i stopio. Mae'r darn yn aros ar y gwely fel y mae, ac mae OctoPrint yn rhedeg ei drefn ganslo, sydd fel arfer yn diffodd y gwresogyddion ac yn parcio'r pen argraffu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et stoppet print kan ikke genoptages. Emnet bliver liggende på pladen, som det er, og OctoPrint kører sin annulleringsrutine, som normalt slukker varmen og parkerer printhovedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gestoppter Druck kann nicht fortgesetzt werden. Das Teil bleibt so auf dem Bett, wie es ist, und OctoPrint führt seine Abbruchroutine aus, die meist die Heizungen ausschaltet und den Druckkopf parkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stopped print can't be resumed. The part stays on the bed as it is, and OctoPrint runs its cancel routine, which usually turns the heaters off and parks the print head."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A stopped print can't be resumed. The part stays on the bed as it is, and OctoPrint runs its cancel routine, which usually turns the heaters off and parks the print head."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una impresión detenida no se puede reanudar. La pieza se queda en la cama tal cual, y OctoPrint ejecuta su rutina de cancelación, que suele apagar los calentadores y aparcar el cabezal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysäytettyä tulostusta ei voi jatkaa. Kappale jää alustalle sellaisenaan, ja OctoPrint ajaa peruutusrutiininsa, joka yleensä sammuttaa lämmittimet ja siirtää tulostuspään sivuun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une impression arrêtée ne peut pas être reprise. La pièce reste sur le plateau telle quelle, et OctoPrint lance sa routine d’annulation, qui coupe généralement les éléments chauffants et gare la tête d’impression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stampa interrotta non può essere ripresa. Il pezzo resta sul piatto così com'è e OctoPrint esegue la sua routine di annullamento, che di solito spegne i riscaldatori e parcheggia la testina."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En stoppet utskrift kan ikke fortsettes. Delen blir liggende på platen som den er, og OctoPrint kjører avbrytrutinen sin, som vanligvis slår av varmeelementene og parkerer skrivehodet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gestopte print kan niet worden hervat. Het onderdeel blijft op het bed zoals het is, en OctoPrint voert zijn annuleerroutine uit, die meestal de verwarming uitzet en de printkop parkeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymanego wydruku nie da się wznowić. Część zostaje na stole w obecnym stanie, a OctoPrint uruchamia procedurę anulowania, która zwykle wyłącza grzałki i parkuje głowicę."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma impressão parada não pode ser retomada. A peça fica na mesa tal como está e o OctoPrint executa a rotina de cancelamento, que normalmente desliga os aquecedores e estaciona a cabeça de impressão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En stoppad utskrift kan inte återupptas. Detaljen ligger kvar på bädden som den är, och OctoPrint kör sin avbrytningsrutin, som oftast stänger av värmen och parkerar skrivhuvudet."
          }
        }
      }
    },
