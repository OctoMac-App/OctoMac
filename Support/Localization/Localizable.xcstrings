    "That doesn't look like an address yet.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím to nevypadá jako adresa."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dydy hwnnw ddim yn edrych fel cyfeiriad eto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ligner ikke en adresse endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht noch nicht nach einer Adresse aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look like an address yet."
          }
        },
