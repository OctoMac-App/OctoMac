    "Stop one part if it fails, and let the rest finish": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastavit jednu část, pokud selže, a nechat dokončit zbytek"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopio un rhan os yw'n methu, a gadael i'r gweddill orffen"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop én del, hvis den mislykkes, og lad resten blive færdig"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil stoppen, wenn es misslingt, und den Rest fertig drucken"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop one part if it fails, and let the rest finish"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop one part if it fails, and let the rest finish"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener una pieza si falla y dejar que el resto termine"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysäytä yksi kappale, jos se epäonnistuu, ja anna muiden valmistua"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter une pièce si elle échoue, et laisser les autres se terminer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferma un pezzo se fallisce e lascia finire gli altri"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp én del hvis den mislykkes, og la resten bli ferdig"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop één onderdeel als het mislukt en laat de rest afmaken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj jedną część, jeśli się nie uda, a resztę dokończ"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar uma peça se falhar e deixar as restantes terminar"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppa en del om den misslyckas och låt resten bli klar"
          }
        }
      }
    },
    "Stop one part if it's failed, and the others carry on printing. A cancelled part can't be resumed.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastavte jednu část, pokud selhala, a ostatní se budou tisknout dál. Zrušenou část nelze obnovit."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopiwch un rhan os yw wedi methu, ac mae'r lleill yn dal ati i argraffu. Does dim modd ailddechrau rhan sydd wedi'i chanslo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop én del, hvis den er mislykket, så de andre fortsætter. En annulleret del kan ikke genoptages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppe ein Teil, wenn es misslungen ist, und die anderen werden weitergedruckt. Ein abgebrochenes Teil kann nicht fortgesetzt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop one part if it's failed, and the others carry on printing. A canceled part can't be resumed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop one part if it's failed, and the others carry on printing. A cancelled part can't be resumed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detén una pieza si ha fallado y las demás siguen imprimiéndose. Una pieza cancelada no se puede reanudar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysäytä epäonnistunut kappale, niin muut jatkavat tulostumista. Peruttua kappaletta ei voi jatkaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez une pièce si elle a échoué, et les autres continuent de s’imprimer. Une pièce annulée ne peut pas être reprise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferma un pezzo se non è riuscito: gli altri continuano a stampare. Un pezzo annullato non può essere ripreso."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp én del hvis den har mislyktes, så fortsetter de andre å skrives ut. En avbrutt del kan ikke fortsettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop één onderdeel als het mislukt is, dan printen de andere gewoon door. Een geannuleerd onderdeel kan niet worden hervat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj jedną część, jeśli się nie udała, a pozostałe będą drukowane dalej. Anulowanej części nie można wznowić."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare uma peça que falhou e as outras continuam a imprimir. Uma peça cancelada não pode ser retomada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppa en del som har misslyckats, så fortsätter de andra att skrivas ut. En avbruten del kan inte återupptas."
          }
        }
      }
    },
