            "state": "translated",
            "value": "Pausa eller få en notis när utskriften når ett visst lager"
          }
        }
      }
    },
    "Pause to drop in magnets, nuts or a new colour, or just get a notification when the print gets there.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozastavte tisk a vložte magnety, matice nebo novou barvu, nebo jen dostaňte oznámení, až tam tisk dojde."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Seibio i ollwng magnetau, nytiau neu liw newydd i mewn, neu ddim ond cael hysbysiad pan fydd yr argraffiad yn cyrraedd yno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt på pause for at lægge magneter, møtrikker eller en ny farve i, eller få bare en notifikation, når printet når dertil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiere, um Magnete, Muttern oder eine neue Farbe einzulegen, oder lass dich einfach benachrichtigen, wenn der Druck so weit ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause to drop in magnets, nuts or a new color, or just get a notification when the print gets there."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause to drop in magnets, nuts or a new colour, or just get a notification when the print gets there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa para meter imanes, tuercas o un color nuevo, o simplemente recibe una notificación cuando la impresión llegue ahí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä tauko lisätäksesi magneetteja, muttereita tai uuden värin, tai saa vain ilmoitus, kun tulostus etenee sinne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une pause pour insérer des aimants, des écrous ou une nouvelle couleur, ou recevez simplement une notification quand l’impression y arrive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in pausa per inserire magneti, dadi o un nuovo colore, oppure ricevi solo una notifica quando la stampa arriva lì."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett på pause for å legge inn magneter, muttere eller en ny farge, eller få bare et varsel når utskriften kommer dit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauzeer om magneten, moeren of een nieuwe kleur toe te voegen, of krijg gewoon een melding als de print daar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymaj, aby włożyć magnesy, nakrętki lub zmienić kolor, albo po prostu otrzymaj powiadomienie, gdy wydruk tam dotrze."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause para inserir ímanes, porcas ou uma nova cor, ou receba apenas uma notificação quando a impressão lá chegar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa för att lägga i magneter, muttrar eller byta färg, eller få bara en notis när utskriften kommer dit."
          }
        }
      }
    },
