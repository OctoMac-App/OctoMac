    "Notifications are turned off for OctoMac in System Settings.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení jsou pro OctoMac vypnutá v Nastavení systému."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae hysbysiadau wedi'u diffodd ar gyfer OctoMac yng Ngosodiadau'r System."
          }
        },
        "da": {
