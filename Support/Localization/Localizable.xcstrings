          }
        }
      }
    },
    "The Raspberry Pi's storage is %@ full. Delete old prints, timelapses or backups to make room.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úložiště Raspberry Pi je zaplněné na %@. Uvolněte místo smazáním starých tisků, timelapsů nebo záloh."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae storfa'r Raspberry Pi %@ yn llawn. Dilëwch hen argraffiadau, timelapses neu gopïau wrth gefn i wneud lle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Raspberry Pi'ens lager er %@ fyldt. Slet gamle prints, timelapses eller sikkerhedskopier for at gøre plads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher des Raspberry Pi ist zu %@ voll. Lösche alte Drucke, Zeitraffer oder Backups, um Platz zu schaffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Raspberry Pi's storage is %@ full. Delete old prints, timelapses or backups to make room."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Raspberry Pi's storage is %@ full. Delete old prints, timelapses or backups to make room."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento de la Raspberry Pi está al %@ de su capacidad. Elimina impresiones, timelapses o copias de seguridad antiguas para hacer sitio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Raspberry Pi:n tallennustila on %@ täynnä. Poista vanhoja tulosteita, timelapseja tai varmuuskopioita, jotta tilaa vapautuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage du Raspberry Pi est plein à %@. Supprimez d’anciennes impressions, des timelapses ou des sauvegardes pour libérer de la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio del Raspberry Pi occupato: %@. Elimina vecchie stampe, timelapse o backup per fare spazio."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagringsplassen på Raspberry Pi er %@ full. Slett gamle utskrifter, timelapser eller sikkerhetskopier for å frigjøre plass."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opslag van de Raspberry Pi is voor %@ vol. Verwijder oude prints, timelapses of back-ups om ruimte te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamięć Raspberry Pi jest zapełniona w %@. Usuń stare wydruki, timelapse’y lub kopie zapasowe, aby zrobić miejsce."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento do Raspberry Pi está %@ cheio. Apague impressões, timelapses ou cópias de segurança antigas para libertar espaço."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raspberry Pis lagring är %@ full. Radera gamla utskrifter, timelapser eller säkerhetskopior för att frigöra plats."
          }
        }
      }
    },
    "The access request was denied or timed out.": {
