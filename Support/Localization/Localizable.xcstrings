    "Replies with every heater's current and target temperature.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátí aktuální a cílovou teplotu každého topení."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn ateb gyda thymheredd presennol a tharged pob gwresogydd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svarer med hvert varmelegemes aktuelle temperatur og måltemperatur."
          }
        },
