    "%@ is paused and waiting for you.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: pozastaveno, čeká na vás."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae %@ wedi'i seibio ac yn aros amdanoch chi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er sat på pause og venter på dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist pausiert und wartet auf dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is paused and waiting for you."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is paused and waiting for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está en pausa y te espera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on tauolla ja odottaa sinua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en pause et vous attend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è in pausa e ti aspetta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er satt på pause og venter på deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is gepauzeerd en wacht op je."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: wstrzymano, czeka na ciebie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está em pausa e à sua espera."
          }
        },
        "sv": {
