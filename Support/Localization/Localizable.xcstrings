    "A picture every %@ over %@, played back in %lld seconds, %@. Keep this window open while it records.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímek každých %1$@ po dobu %2$@, přehrání za %3$lld s, %4$@. Během nahrávání nechte toto okno otevřené."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Llun bob %1$@ dros %2$@, wedi'i chwarae'n ôl mewn %3$lld eiliad, %4$@. Cadwch y ffenestr hon ar agor tra mae'n recordio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et billede hver %1$@ i %2$@, afspillet på %3$lld sekunder, %4$@. Hold dette vindue åbent, mens der optages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bild alle %1$@ über %2$@, abgespielt in %3$lld Sekunden, %4$@. Lass dieses Fenster offen, während aufgenommen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A picture every %1$@ over %2$@, played back in %3$lld seconds, %4$@. Keep this window open while it records."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A picture every %1$@ over %2$@, played back in %3$lld seconds, %4$@. Keep this window open while it records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una imagen cada %1$@ durante %2$@, reproducida en %3$lld segundos, %4$@. Mantén esta ventana abierta mientras graba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva %1$@ välein, kesto %2$@, toisto %3$lld sekunnissa, %4$@. Pidä tämä ikkuna auki tallennuksen ajan."
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Une photo toutes les %1$@ pendant %2$@, lue en %3$lld seconde, %4$@. Gardez cette fenêtre ouverte pendant l’enregistrement."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Une photo toutes les %1$@ pendant %2$@, lue en %3$lld secondes, %4$@. Gardez cette fenêtre ouverte pendant l’enregistrement."
                }
              }
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'immagine ogni %1$@ per %2$@, riprodotta in %3$lld secondi, %4$@. Tieni aperta questa finestra durante la registrazione."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et bilde hvert %1$@ i %2$@, spilt av på %3$lld sekunder, %4$@. La dette vinduet være åpent mens det tar opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke %1$@ een foto, %2$@ lang, afgespeeld in %3$lld seconden, %4$@. Houd dit venster open tijdens de opname."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcie co %1$@ przez %2$@, odtwarzane w %3$lld s, %4$@. Nie zamykaj tego okna podczas nagrywania."
          }
        },
        "pt-PT": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Uma imagem a cada %1$@ durante %2$@, reproduzida em %3$lld segundo, %4$@. Mantenha esta janela aberta enquanto grava."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Uma imagem a cada %1$@ durante %2$@, reproduzida em %3$lld segundos, %4$@. Mantenha esta janela aberta enquanto grava."
                }
              }
            }
          }
        },
        "sv": {
