    "Printers always work in Celsius; this only changes what OctoMac shows.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiskárny vždy pracují ve stupních Celsia; mění se jen to, co zobrazuje OctoMac."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae argraffwyr bob amser yn gweithio mewn Celsius; mae hyn ond yn newid yr hyn mae OctoMac yn ei ddangos."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Printere arbejder altid i Celsius; dette ændrer kun, hvad OctoMac viser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drucker arbeiten immer in Celsius, das ändert nur, was OctoMac anzeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Printers always work in Celsius; this only changes what OctoMac shows."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Printers always work in Celsius; this only changes what OctoMac shows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las impresoras siempre trabajan en Celsius; esto solo cambia lo que muestra OctoMac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulostimet toimivat aina Celsius-asteissa; tämä muuttaa vain sitä, mitä OctoMac näyttää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les imprimantes fonctionnent toujours en Celsius ; cela ne change que l’affichage d’OctoMac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stampanti lavorano sempre in Celsius; questo cambia solo ciò che mostra OctoMac."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivere bruker alltid Celsius. Dette endrer bare hva OctoMac viser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Printers werken altijd in Celsius; dit verandert alleen wat OctoMac toont."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drukarki zawsze pracują w stopniach Celsjusza; to zmienia tylko to, co pokazuje OctoMac."
          }
        },
        "pt-PT": {
          "stringUnit": {
