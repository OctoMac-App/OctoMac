          "stringUnit": {
            "state": "translated",
            "value": "Rydder et fejlstop, så printeren tager imod kommandoer igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebt einen Fehlerstopp auf, damit der Drucker wieder Befehle annimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears an error stop so the printer accepts commands again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears an error stop so the printer accepts commands again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina una parada por error para que la impresora vuelva a aceptar comandos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuittaa virhepysäytyksen, jotta tulostin hyväksyy taas komentoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface un arrêt sur erreur pour que l’imprimante accepte à nouveau les commandes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla un arresto per errore così la stampante accetta di nuovo i comandi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nullstiller en feilstopp, så skriveren tar imot kommandoer igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heft een foutstop op zodat de printer weer commando's accepteert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasuje zatrzymanie po błędzie, aby drukarka znów przyjmowała polecenia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa uma paragem por erro para que a impressora volte a aceitar comandos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nollställer ett felstopp så att skrivaren tar emot kommandon igen."
          }
        }
      }
    },
    "Click a command to put it in the box below the console. Nothing is sent until you press Send.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknutím vložíte příkaz do pole pod konzolí. Nic se neodešle, dokud nestisknete Odeslat."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliciwch ar orchymyn i'w roi yn y blwch o dan y consol. Does dim byd yn cael ei anfon nes i chi bwyso Anfon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på en kommando for at sætte den i feltet under konsollen. Intet sendes, før du trykker på Send."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf einen Befehl, um ihn in das Feld unter der Konsole zu übernehmen. Gesendet wird erst, wenn du auf „Senden“ klickst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a command to put it in the box below the console. Nothing is sent until you press Send."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a command to put it in the box below the console. Nothing is sent until you press Send."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un comando para ponerlo en el cuadro bajo la consola. No se envía nada hasta que pulses Enviar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoita komentoa, niin se siirtyy konsolin alla olevaan kenttään. Mitään ei lähetetä ennen kuin painat Lähetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur une commande pour la placer dans le champ sous la console. Rien n’est envoyé tant que vous n’appuyez pas sur Envoyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su un comando per inserirlo nel campo sotto la console. Non viene inviato nulla finché non premi Invia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på en kommando for å legge den i feltet under konsollen. Ingenting sendes før du trykker Send."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op een commando om het in het veld onder de console te zetten. Er wordt niets verstuurd tot je op Verstuur drukt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij polecenie, aby wstawić je do pola pod konsolą. Nic nie zostanie wysłane, dopóki nie naciśniesz Wyślij."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique num comando para o colocar na caixa abaixo da consola. Nada é enviado até premir Enviar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på ett kommando för att lägga det i rutan under konsolen. Inget skickas förrän du trycker på Skicka."
          }
        }
      }
    },
