    "OctoPrint no longer accepts this API key. Request access again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint už tento klíč API nepřijímá. Požádejte o přístup znovu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dydy OctoPrint ddim yn derbyn yr allwedd API hon mwyach. Gofynnwch am fynediad eto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint accepterer ikke længere denne API-nøgle. Anmod om adgang igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint akzeptiert diesen API-Schlüssel nicht mehr. Fordere erneut Zugriff an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint no longer accepts this API key. Request access again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint no longer accepts this API key. Request access again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ya no acepta esta clave de API. Vuelve a solicitar acceso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ei enää hyväksy tätä API-avainta. Pyydä käyttöoikeutta uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint n’accepte plus cette clé API. Demandez l’accès à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint non accetta più questa chiave API. Richiedi di nuovo l'accesso."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint godtar ikke lenger denne API-nøkkelen. Be om tilgang på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint accepteert deze API-sleutel niet meer. Vraag opnieuw toegang aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint nie akceptuje już tego klucza API. Poproś o dostęp ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint já não aceita esta chave da API. Peça acesso novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint godkänner inte längre den här API-nyckeln. Begär åtkomst igen."
          }
        }
      }
    },
    "OctoPrint removes it from the Raspberry Pi. Copies you've saved to this Mac aren't affected.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ji odstraní z Raspberry Pi. Kopií uložených v tomto Macu se to nedotkne."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoPrint yn ei dynnu oddi ar y Raspberry Pi. Dydy copïau rydych chi wedi'u cadw ar y Mac hwn ddim yn cael eu heffeithio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint fjerner den fra Raspberry Pi. Kopier, du har gemt på denne Mac, påvirkes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint entfernt es vom Raspberry Pi. Kopien, die du auf diesem Mac gespeichert hast, bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint removes it from the Raspberry Pi. Copies you've saved to this Mac aren't affected."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint removes it from the Raspberry Pi. Copies you've saved to this Mac aren't affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint la elimina de la Raspberry Pi. Las copias que hayas guardado en este Mac no se ven afectadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint poistaa sen Raspberry Pi:stä. Tähän Maciin tallentamiisi kopioihin tämä ei vaikuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint la supprime du Raspberry Pi. Les copies enregistrées sur ce Mac ne sont pas touchées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint lo rimuove dal Raspberry Pi. Le copie salvate su questo Mac non vengono toccate."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint fjerner den fra Raspberry Pi. Kopier du har arkivert på denne Macen, påvirkes ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint verwijdert hem van de Raspberry Pi. Kopieën die je op deze Mac hebt bewaard, blijven gewoon bestaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint usunie ją z Raspberry Pi. Nie wpłynie to na kopie zachowane na tym Macu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint remove-a do Raspberry Pi. As cópias que guardou neste Mac não são afetadas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint tar bort den från Raspberry Pi. Kopior du har sparat på den här Macen påverkas inte."
          }
        }
      }
    },
    "OctoPrint removes it from the Raspberry Pi. Logs are useful when reporting a problem, so keep recent ones.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ho odstraní z Raspberry Pi. Protokoly se hodí při hlášení problému, takže si ty nedávné nechte."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoPrint yn ei dynnu oddi ar y Raspberry Pi. Mae logiau'n ddefnyddiol wrth adrodd problem, felly cadwch y rhai diweddar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint fjerner den fra Raspberry Pi. Logfiler er nyttige, når du rapporterer et problem, så behold de nyeste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint entfernt es vom Raspberry Pi. Protokolle helfen, wenn du ein Problem meldest, also behalte die neueren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint removes it from the Raspberry Pi. Logs are useful when reporting a problem, so keep recent ones."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint removes it from the Raspberry Pi. Logs are useful when reporting a problem, so keep recent ones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint lo elimina de la Raspberry Pi. Los registros son útiles para informar de un problema, así que conserva los recientes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint poistaa sen Raspberry Pi:ltä. Lokeista on hyötyä ongelmasta ilmoitettaessa, joten säilytä tuoreimmat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint le supprime du Raspberry Pi. Les journaux sont utiles pour signaler un problème, alors gardez les plus récents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint lo elimina dal Raspberry Pi. I log sono utili per segnalare un problema, quindi conserva quelli recenti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint sletter den fra Raspberry Pi. Logger er nyttige når du melder fra om et problem, så behold de nyeste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint verwijdert hem van de Raspberry Pi. Logbestanden zijn handig als je een probleem meldt, dus bewaar recente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint usunie go z Raspberry Pi. Logi przydają się przy zgłaszaniu problemu, więc zachowaj te najnowsze."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint remove-o do Raspberry Pi. Os registos são úteis para comunicar um problema, por isso mantenha os recentes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint tar bort den från Raspberry Pi. Loggar är bra att ha när du rapporterar ett problem, så behåll de senaste."
          }
        }
      }
    },
    "OctoPrint removes the plugin. Its settings may be kept in case you install it again. OctoPrint needs a restart afterwards.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint plugin odebere. Jeho nastavení se může zachovat pro případ, že ho nainstalujete znovu. OctoPrint pak bude potřebovat restart."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoPrint yn tynnu'r ategyn. Efallai y bydd ei osodiadau'n cael eu cadw rhag ofn i chi ei osod eto. Bydd angen ailgychwyn OctoPrint wedyn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint fjerner pluginnet. Dets indstillinger beholdes måske, hvis du installerer det igen. OctoPrint skal genstartes bagefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint entfernt das Plugin. Seine Einstellungen bleiben eventuell erhalten, falls du es wieder installierst. OctoPrint muss danach neu gestartet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint removes the plugin. Its settings may be kept in case you install it again. OctoPrint needs a restart afterwards."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint removes the plugin. Its settings may be kept in case you install it again. OctoPrint needs a restart afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint elimina el plugin. Puede que conserve sus ajustes por si lo vuelves a instalar. OctoPrint necesitará reiniciarse después."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint poistaa lisäosan. Sen asetukset voidaan säilyttää, jos asennat sen uudelleen. OctoPrint täytyy käynnistää sen jälkeen uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint supprime le plugin. Ses réglages peuvent être conservés au cas où vous le réinstalleriez. OctoPrint devra ensuite redémarrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint rimuove il plugin. Le sue impostazioni potrebbero restare nel caso tu lo reinstalli. Dopo serve un riavvio di OctoPrint."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint fjerner utvidelsen. Innstillingene kan bli beholdt i tilfelle du installerer den igjen. OctoPrint må startes på nytt etterpå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint verwijdert de plug-in. De instellingen blijven misschien bewaard voor als je hem opnieuw installeert. OctoPrint moet daarna opnieuw opstarten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint usunie wtyczkę. Jej ustawienia mogą zostać zachowane na wypadek ponownej instalacji. Potem trzeba uruchomić OctoPrint ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint remove o plugin. As definições podem ser mantidas caso o volte a instalar. O OctoPrint tem de reiniciar depois."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint tar bort pluginet. Dess inställningar kan sparas ifall du installerar det igen. OctoPrint behöver startas om efteråt."
          }
        }
      }
    },
