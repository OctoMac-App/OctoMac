    "OctoMac looks for a new version once a day and asks before installing it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac jednou denně hledá novou verzi a před instalací se zeptá."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoMac yn chwilio am fersiwn newydd unwaith y dydd ac yn gofyn cyn ei gosod."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac leder efter en ny version en gang om dagen og spørger, før den installeres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac sucht einmal am Tag nach einer neuen Version und fragt vor der Installation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac looks for a new version once a day and asks before installing it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac looks for a new version once a day and asks before installing it."
          }
        },
        "es": {
