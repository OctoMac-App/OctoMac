    "In the queue; add it again to print another": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve frontě; přidejte ho znovu a vytiskněte další"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn y ciw; ychwanegwch ef eto i argraffu un arall"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I køen; tilføj den igen for at printe en til"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Warteschlange. Erneut hinzufügen, um noch einmal zu drucken"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the queue; add it again to print another"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In the queue; add it again to print another"
          }
        },
        "es": {
