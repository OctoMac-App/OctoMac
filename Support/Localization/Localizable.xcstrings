    "Jump to the layer being printed and keep up with it": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejít na právě tištěnou vrstvu a sledovat ji"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Neidio i'r haen sy'n cael ei hargraffu a chadw i fyny â hi"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hop til det lag, der printes, og følg med"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur gerade gedruckten Schicht springen und mitlaufen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump to the layer being printed and keep up with it"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump to the layer being printed and keep up with it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saltar a la capa que se está imprimiendo y seguirla"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirry tulostettavaan kerrokseen ja pysy sen tahdissa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aller à la couche en cours d’impression et la suivre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai al layer in stampa e seguilo"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hopp til laget som skrives ut, og følg med på det"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spring naar de laag die wordt geprint en blijf die volgen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejdź do drukowanej warstwy i nadążaj za nią"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Saltar para a camada a ser impressa e acompanhá-la"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoppa till lagret som skrivs ut och följ med"
          }
        }
      }
    },
