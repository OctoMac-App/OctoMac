    "Shows how your print is going. Click to open OctoMac.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukazuje, jak váš tisk postupuje. Kliknutím otevřete OctoMac."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn dangos sut mae eich argraffiad yn mynd. Cliciwch i agor OctoMac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser, hvordan dit print går. Klik for at åbne OctoMac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, wie dein Druck läuft. Klicke, um OctoMac zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how your print is going. Click to open OctoMac."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how your print is going. Click to open OctoMac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra cómo va tu impresión. Haz clic para abrir OctoMac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää, miten tulostus etenee. Avaa OctoMac osoittamalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montre où en est votre impression. Cliquez pour ouvrir OctoMac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra come procede la stampa. Fai clic per aprire OctoMac."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser hvordan utskriften går. Klikk for å åpne OctoMac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat zien hoe je print ervoor staat. Klik om OctoMac te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje, jak idzie wydruk. Kliknij, aby otworzyć OctoMac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
