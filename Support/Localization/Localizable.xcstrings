    "Last attempt: OctoPrint couldn't find the printer on any USB port.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslední pokus: OctoPrint nenašel tiskárnu na žádném portu USB."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ymgais olaf: methodd OctoPrint â dod o hyd i'r argraffydd ar unrhyw borth USB."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidste forsøg: OctoPrint kunne ikke finde printeren på nogen USB-port."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzter Versuch: OctoPrint hat den Drucker an keinem USB-Anschluss gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last attempt: OctoPrint couldn't find the printer on any USB port."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Last attempt: OctoPrint couldn't find the printer on any USB port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Último intento: OctoPrint no ha encontrado la impresora en ningún puerto USB."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeisin yritys: OctoPrint ei löytänyt tulostinta mistään USB-portista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière tentative : OctoPrint n’a trouvé l’imprimante sur aucun port USB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultimo tentativo: OctoPrint non ha trovato la stampante su nessuna porta USB."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Siste forsøk: OctoPrint fant ikke skriveren på noen USB-port."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laatste poging: OctoPrint kon de printer op geen enkele USB-poort vinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnia próba: OctoPrint nie znalazł drukarki na żadnym porcie USB."
          }
        },
        "pt-PT": {
