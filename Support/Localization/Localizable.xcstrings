    "Highest point minus lowest point on the latest measurement.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejvyšší bod minus nejnižší bod při posledním měření."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Pwynt uchaf llai'r pwynt isaf ar y mesuriad diweddaraf."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højeste punkt minus laveste punkt ved den seneste måling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchster minus niedrigster Punkt der letzten Messung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highest point minus lowest point on the latest measurement."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Highest point minus lowest point on the latest measurement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Punto más alto menos punto más bajo en la última medición."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korkein kohta miinus matalin kohta viimeisimmässä mittauksessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Point le plus haut moins point le plus bas sur la dernière mesure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punto più alto meno punto più basso nell'ultima misurazione."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyeste punkt minus laveste punkt i den siste målingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoogste punt min laagste punt bij de laatste meting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najwyższy punkt minus najniższy w ostatnim pomiarze."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponto mais alto menos ponto mais baixo na última medição."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högsta punkten minus lägsta punkten vid den senaste mätningen."
          }
        }
      }
    },
    "Highest point minus lowest point. Under 0.2 mm is good for most printers.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejvyšší bod minus nejnižší bod. Pod 0,2 mm je pro většinu tiskáren dobré."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Pwynt uchaf llai'r pwynt isaf. Mae llai na 0.2 mm yn dda i'r rhan fwyaf o argraffwyr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højeste punkt minus laveste punkt. Under 0,2 mm er godt for de fleste printere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchster minus niedrigster Punkt. Unter 0,2 mm ist für die meisten Drucker gut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highest point minus lowest point. Under 0.2 mm is good for most printers."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Highest point minus lowest point. Under 0.2 mm is good for most printers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Punto más alto menos punto más bajo. Menos de 0,2 mm está bien para la mayoría de las impresoras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korkein kohta miinus matalin kohta. Alle 0,2 mm on hyvä useimmille tulostimille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Point le plus haut moins point le plus bas. Moins de 0,2 mm convient à la plupart des imprimantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punto più alto meno punto più basso. Sotto 0,2 mm va bene per la maggior parte delle stampanti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyeste punkt minus laveste punkt. Under 0,2 mm er bra for de fleste skrivere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoogste punt min laagste punt. Onder 0,2 mm is goed voor de meeste printers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najwyższy punkt minus najniższy. Poniżej 0,2 mm to dobry wynik dla większości drukarek."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponto mais alto menos ponto mais baixo. Abaixo de 0,2 mm é bom para a maioria das impressoras."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högsta punkten minus lägsta punkten. Under 0,2 mm är bra för de flesta skrivare."
          }
        }
      }
    },
    "Highest to lowest point: %@ mm. Under 0.2 mm is good, and more can still print fine.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Od nejvyššího k nejnižšímu bodu: %@ mm. Pod 0,2 mm je dobré a i víc se dá dobře tisknout."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "O'r pwynt uchaf i'r isaf: %@ mm. Mae llai na 0.2 mm yn dda, a gall mwy na hynny argraffu'n iawn o hyd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra højeste til laveste punkt: %@ mm. Under 0,2 mm er godt, og mere kan stadig give fine print."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchster bis niedrigster Punkt: %@ mm. Unter 0,2 mm ist gut, und auch mehr kann noch gut drucken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highest to lowest point: %@ mm. Under 0.2 mm is good, and more can still print fine."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Highest to lowest point: %@ mm. Under 0.2 mm is good, and more can still print fine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Del punto más alto al más bajo: %@ mm. Menos de 0,2 mm está bien, y con algo más se puede seguir imprimiendo bien."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korkeimmasta matalimpaan kohtaan: %@ mm. Alle 0,2 mm on hyvä, ja suuremmallakin voi yhä tulostaa hyvin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du point le plus haut au plus bas : %@ mm. Moins de 0,2 mm, c’est bien, et au-delà l’impression peut encore être bonne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal punto più alto al più basso: %@ mm. Sotto 0,2 mm va bene, e anche con qualcosa in più si può stampare bene."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra høyeste til laveste punkt: %@ mm. Under 0,2 mm er bra, og mer kan fortsatt gi fine utskrifter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoogste tot laagste punt: %@ mm. Onder 0,2 mm is goed, en met meer kun je vaak nog prima printen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od najwyższego do najniższego punktu: %@ mm. Poniżej 0,2 mm jest dobrze, a przy większej wartości nadal można dobrze drukować."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Do ponto mais alto ao mais baixo: %@ mm. Abaixo de 0,2 mm é bom, e acima disso ainda pode imprimir bem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högsta till lägsta punkt: %@ mm. Under 0,2 mm är bra, och mer kan ändå ge fina utskrifter."
          }
        }
      }
    },
