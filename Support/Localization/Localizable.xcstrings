        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svarer med gjeldende temperatur og måltemperatur for hvert varmeelement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoordt met de huidige en doeltemperatuur van elke verwarming."
          }
        },
        "pl": {
