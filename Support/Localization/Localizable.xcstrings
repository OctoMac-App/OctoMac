    "The pictures for %@ are deleted from OctoPrint, so no video can be made from them. This can't be undone.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímky pro %@ budou z OctoPrintu smazány, takže z nich už nepůjde vytvořit video. Tuto akci nelze vrátit."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Bydd y lluniau ar gyfer %@ yn cael eu dileu o OctoPrint, felly does dim modd gwneud fideo ohonyn nhw. Does dim modd dadwneud hyn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billederne til %@ slettes fra OctoPrint, så der kan ikke laves en video af dem. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bilder für %@ werden aus OctoPrint gelöscht, daher kann kein Video mehr daraus entstehen. Das kann nicht widerrufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pictures for %@ are deleted from OctoPrint, so no video can be made from them. This can't be undone."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The pictures for %@ are deleted from OctoPrint, so no video can be made from them. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes de %@ se eliminarán de OctoPrint, así que ya no se podrá hacer un vídeo con ellas. No se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohteen %@ kuvat poistetaan OctoPrintista, joten niistä ei voi enää tehdä videota. Tätä ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images de %@ sont supprimées d’OctoPrint, aucune vidéo ne pourra donc en être créée. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini di %@ vengono eliminate da OctoPrint, quindi non sarà più possibile crearne un video. Questa azione non può essere annullata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildene for %@ slettes fra OctoPrint, så det kan ikke lages noen video av dem. Dette kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De foto's voor %@ worden uit OctoPrint verwijderd, dus er kan geen video meer van worden gemaakt. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia dla %@ zostaną usunięte z OctoPrint, więc nie da się już z nich zrobić wideo. Tego nie można cofnąć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens de %@ são apagadas do OctoPrint, por isso já não é possível fazer um vídeo com elas. Esta ação não pode ser anulada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilderna för %@ raderas från OctoPrint, så ingen video kan göras av dem. Det går inte att ångra."
          }
        }
      }
    },
