    "Heats and cools the hotend (E0) or bed (E-1) a few times to tune its temperature control. C is the number of cycles.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Několikrát ohřeje a zchladí hotend (E0) nebo podložku (E-1) a vyladí regulaci teploty. C je počet cyklů."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn gwresogi ac yn oeri'r hotend (E0) neu'r gwely (E-1) ychydig o weithiau i diwnio ei reolaeth tymheredd. C yw nifer y cylchoedd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmer hotend (E0) eller plade (E-1) op og køler ned et par gange for at finjustere temperaturstyringen. C er antallet af cyklusser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heizt und kühlt das Hotend (E0) oder Bett (E-1) einige Male, um seine Temperaturregelung abzustimmen. C ist die Anzahl der Zyklen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heats and cools the hotend (E0) or bed (E-1) a few times to tune its temperature control. C is the number of cycles."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Heats and cools the hotend (E0) or bed (E-1) a few times to tune its temperature control. C is the number of cycles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calienta y enfría el hotend (E0) o la cama (E-1) varias veces para ajustar su control de temperatura. C es el número de ciclos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämmittää ja jäähdyttää hotendia (E0) tai alustaa (E-1) muutaman kerran lämpötilansäädön virittämiseksi. C on kierrosten määrä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chauffe et refroidit le hotend (E0) ou le plateau (E-1) plusieurs fois pour régler sa régulation de température. C est le nombre de cycles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riscalda e raffredda l'hotend (E0) o il piatto (E-1) alcune volte per regolarne il controllo della temperatura. C è il numero di cicli."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmer opp og kjøler ned hotenden (E0) eller platen (E-1) noen ganger for å finjustere temperaturstyringen. C er antall sykluser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwarmt en koelt de hotend (E0) of het bed (E-1) een paar keer om de temperatuurregeling af te stellen. C is het aantal cycli."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilka razy nagrzewa i chłodzi hotend (E0) lub stół (E-1), aby dostroić regulację temperatury. C to liczba cykli."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquece e arrefece o hotend (E0) ou a mesa (E-1) algumas vezes para afinar o controlo de temperatura. C é o número de ciclos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Värmer och kyler hotend (E0) eller bädd (E-1) några gånger för att finjustera temperaturregleringen. C är antalet cykler."
          }
        }
      }
    },
