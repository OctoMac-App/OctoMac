    "A bar for the print that finishes soonest, amber while it's paused.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruh pro tisk, který skončí nejdříve, během pozastavení jantarový."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Bar ar gyfer yr argraffiad sy'n gorffen gyntaf, yn ambr tra mae wedi'i seibio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En bjælke for det print, der bliver færdigt først, ravgul, mens det er på pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Balken für den Druck, der als Nächstes fertig wird, bernsteinfarben, solange er pausiert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bar for the print that finishes soonest, amber while it's paused."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A bar for the print that finishes soonest, amber while it's paused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra para la impresión que termina antes, en ámbar mientras está en pausa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palkki tulosteelle, joka valmistuu ensimmäisenä. Keltainen, kun se on tauolla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
