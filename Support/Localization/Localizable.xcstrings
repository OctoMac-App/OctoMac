    "Scales how much filament is pushed, as a percentage.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mění množství vytlačovaného filamentu v procentech."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn graddio faint o ffilament sy'n cael ei wthio, fel canran."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skalerer, hvor meget filament der skubbes frem, i procent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaliert die geförderte Filamentmenge in Prozent."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scales how much filament is pushed, as a percentage."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Scales how much filament is pushed, as a percentage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta cuánto filamento se empuja, en porcentaje."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaalaa pursotettavan filamentin määrää prosentteina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle la quantité de filament poussée, en pourcentage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola in percentuale quanto filamento viene spinto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skalerer hvor mye filament som mates, i prosent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Past aan hoeveel filament wordt doorgevoerd, als percentage."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaluje ilość wypychanego filamentu, w procentach."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta a quantidade de filamento empurrado, em percentagem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skalar hur mycket filament som matas fram, i procent."
          }
        }
      }
    },
    "Scales print speed as a percentage. Send with no value to see the current speed.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mění rychlost tisku v procentech. Bez hodnoty zobrazí aktuální rychlost."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn graddio'r cyflymder argraffu fel canran. Anfonwch heb werth i weld y cyflymder presennol."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skalerer printhastigheden i procent. Send uden værdi for at se den aktuelle hastighed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaliert die Druckgeschwindigkeit in Prozent. Ohne Wert gesendet, wird die aktuelle Geschwindigkeit angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scales print speed as a percentage. Send with no value to see the current speed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Scales print speed as a percentage. Send with no value to see the current speed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la velocidad de impresión en porcentaje. Envíalo sin valor para ver la velocidad actual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaalaa tulostusnopeutta prosentteina. Lähetä ilman arvoa nähdäksesi nykyisen nopeuden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règle la vitesse d’impression en pourcentage. Envoyez sans valeur pour voir la vitesse actuelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola in percentuale la velocità di stampa. Invia senza valore per vedere la velocità attuale."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skalerer utskriftshastigheten i prosent. Send uten verdi for å se gjeldende hastighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Past de printsnelheid aan als percentage. Stuur zonder waarde om de huidige snelheid te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaluje prędkość druku w procentach. Wyślij bez wartości, aby zobaczyć bieżącą prędkość."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta a velocidade de impressão em percentagem. Envie sem valor para ver a velocidade atual."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skalar utskriftshastigheten i procent. Skicka utan värde för att se aktuell hastighet."
          }
        }
      }
    },
