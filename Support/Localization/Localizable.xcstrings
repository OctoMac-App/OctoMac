            "state": "translated",
            "value": "El certificado HTTPS de esta impresora aún no es de confianza."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän tulostimen HTTPS-varmenteeseen ei vielä luoteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat HTTPS de cette imprimante n’est pas encore approuvé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il certificato HTTPS di questa stampante non è ancora attendibile."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS-sertifikatet til denne skriveren er ikke klarert ennå."
          }
        },
        "nl": {
