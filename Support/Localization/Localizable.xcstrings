            "state": "translated",
            "value": "Skift kamera, gem eller kopiér et snapshot, eller optag et klip"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera wechseln, Schnappschuss sichern oder kopieren, oder einen Clip aufnehmen"
          }
        },
