    "Waits until every queued move has finished.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počká, až se dokončí všechny pohyby ve frontě."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn aros nes bod pob symudiad yn y ciw wedi gorffen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter, til alle bevægelser i køen er færdige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet, bis alle anstehenden Bewegungen ausgeführt sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waits until every queued move has finished."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Waits until every queued move has finished."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera hasta que termine cada movimiento en cola."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odottaa, kunnes kaikki jonossa olevat liikkeet ovat valmiit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attend que tous les mouvements en file d’attente soient terminés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attende che ogni movimento in coda sia terminato."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter til alle bevegelser i køen er fullført."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht tot elke geplande beweging klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czeka, aż wszystkie ruchy w kolejce się zakończą."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera até todos os movimentos em fila terminarem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar tills alla köade rörelser är klara."
          }
        }
      }
    },
    "Watch the first layer on the camera, and nudge the nozzle down if lines have gaps or don't stick, or up if they're squashed flat.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte první vrstvu na kameře a dolaďte trysku dolů, pokud mají linky mezery nebo nedrží, nebo nahoru, pokud jsou rozmáčknuté."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Gwyliwch yr haen gyntaf ar y camera, a symudwch y ffroenell i lawr ychydig os oes bylchau yn y llinellau neu os nad ydyn nhw'n glynu, neu i fyny os ydyn nhw wedi'u gwasgu'n fflat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold øje med det første lag på kameraet, og skub dysen lidt ned, hvis linjerne har huller eller ikke sidder fast, eller op, hvis de er mast flade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beobachte die erste Schicht über die Kamera und senk die Düse etwas ab, wenn die Linien Lücken haben oder nicht haften, oder heb sie an, wenn sie platt gedrückt sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch the first layer on the camera, and nudge the nozzle down if lines have gaps or don't stick, or up if they're squashed flat."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch the first layer on the camera, and nudge the nozzle down if lines have gaps or don't stick, or up if they're squashed flat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Observa la primera capa en la cámara y baja la boquilla si las líneas tienen huecos o no se pegan, o súbela si quedan aplastadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa ensimmäistä kerrosta kamerasta ja laske suutinta, jos linjoissa on rakoja tai ne eivät tartu, tai nosta sitä, jos ne litistyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveillez la première couche à la caméra, et descendez la buse si les lignes ont des trous ou n’adhèrent pas, ou montez-la si elles sont écrasées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda il primo layer con la videocamera e abbassa l'ugello se le linee hanno spazi vuoti o non aderiscono, o alzalo se sono schiacciate."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg med på første lag på kameraet, og senk dysen hvis linjene har mellomrom eller ikke fester seg, eller hev den hvis de er klemt flate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk de eerste laag op de camera en zet de nozzle een tikje lager als lijnen gaten hebben of niet hechten, of hoger als ze plat geplet zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obserwuj pierwszą warstwę na kamerze i lekko opuść dyszę, jeśli linie mają przerwy lub się nie trzymają, albo podnieś ją, jeśli są zgniecione na płasko."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Observe a primeira camada na câmara e baixe um pouco o bico se as linhas tiverem falhas ou não aderirem, ou suba-o se ficarem esmagadas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titta på första lagret i kameran och sänk munstycket en aning om linjerna har glipor eller inte fäster, eller höj det om de är tillplattade."
          }
        }
      }
    },
