    "Nothing matches. OctoPrint's console accepts any command your firmware knows.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic neodpovídá. Konzole OctoPrintu přijme jakýkoli příkaz, který váš firmware zná."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Does dim byd yn cyfateb. Mae consol OctoPrint yn derbyn unrhyw orchymyn mae eich cadarnwedd yn ei wybod."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet matcher. OctoPrints konsol accepterer enhver kommando, din firmware kender."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Treffer. Die Konsole von OctoPrint akzeptiert jeden Befehl, den deine Firmware kennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing matches. OctoPrint's console accepts any command your firmware knows."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing matches. OctoPrint's console accepts any command your firmware knows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay coincidencias. La consola de OctoPrint acepta cualquier comando que conozca tu firmware."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei osumia. OctoPrintin konsoli hyväksyy minkä tahansa komennon, jonka firmwaresi tuntee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun résultat. La console d’OctoPrint accepte toute commande connue de votre firmware."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun risultato. La console di OctoPrint accetta qualsiasi comando conosciuto dal tuo firmware."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen treff. Konsollen i OctoPrint godtar alle kommandoer firmwaren din kjenner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets gevonden. De console van OctoPrint accepteert elk commando dat je firmware kent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie pasuje. Konsola OctoPrint przyjmuje każde polecenie, które zna twój firmware."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem resultados. A consola do OctoPrint aceita qualquer comando que o seu firmware conheça."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget matchar. OctoPrints konsol tar emot alla kommandon som din firmware känner till."
          }
        }
      }
    },
    "Nothing printed yet. Prints from OctoPrint's own file list show up here, newest first.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nic vytištěno. Tisky ze seznamu souborů OctoPrintu se zobrazí zde, od nejnovějších."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dim byd wedi'i argraffu eto. Mae argraffiadau o restr ffeiliau OctoPrint ei hun yn ymddangos yma, y diweddaraf yn gyntaf."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet printet endnu. Prints fra OctoPrints egen filliste vises her, nyeste først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts gedruckt. Drucke aus der Dateiliste von OctoPrint erscheinen hier, die neuesten zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing printed yet. Prints from OctoPrint's own file list show up here, newest first."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing printed yet. Prints from OctoPrint's own file list show up here, newest first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha impreso nada. Las impresiones de la lista de archivos de OctoPrint aparecen aquí, de la más reciente a la más antigua."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei ole vielä tulostettu. OctoPrintin oman tiedostoluettelon tulostukset näkyvät tässä, uusimmat ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d’imprimé pour l’instant. Les impressions lancées depuis la liste de fichiers d’OctoPrint apparaissent ici, les plus récentes en premier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna stampa. Le stampe dall'elenco file di OctoPrint compaiono qui, dalla più recente."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting skrevet ut ennå. Utskrifter fra OctoPrints egen filliste vises her, nyeste først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets geprint. Prints uit de eigen bestandslijst van OctoPrint verschijnen hier, nieuwste eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic jeszcze nie wydrukowano. Wydruki z listy plików OctoPrint pojawią się tutaj, od najnowszych."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda nada impresso. As impressões da lista de ficheiros do próprio OctoPrint aparecem aqui, as mais recentes primeiro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget utskrivet än. Utskrifter från OctoPrints egen fillista visas här, nyaste först."
          }
        }
      }
    },
