    "Timelapse videos can take up a lot of space.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Videa timelapse mohou zabrat hodně místa."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Gall fideos timelapse gymryd llawer o le."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Timelapse-videoer kan fylde meget."
          }
        },
        "de": {
