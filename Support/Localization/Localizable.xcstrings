            "state": "translated",
            "value": "Las temperaturas aparecen cuando la impresora está conectada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämpötilat näkyvät, kun tulostin on yhdistetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les températures s’affichent dès que l’imprimante est connectée."
          }
