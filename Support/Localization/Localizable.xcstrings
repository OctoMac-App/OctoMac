    "This bed mesh doesn't reach far enough across the bed, so there's nothing to go on for the screws.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato síť podložky nezasahuje dost daleko přes podložku, takže pro šrouby není z čeho vycházet."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dydy'r rhwyll gwely hon ddim yn cyrraedd yn ddigon pell ar draws y gwely, felly does dim i fynd arno ar gyfer y sgriwiau."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette bed mesh når ikke langt nok ud over pladen, så der er intet at gå ud fra for skruerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bett-Mesh reicht nicht weit genug über das Bett, daher gibt es für die Schrauben keine Anhaltspunkte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bed mesh doesn't reach far enough across the bed, so there's nothing to go on for the screws."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This bed mesh doesn't reach far enough across the bed, so there's nothing to go on for the screws."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta malla de la cama no llega lo bastante lejos sobre la cama, así que no hay datos para los tornillos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä alustan verkko ei ulotu tarpeeksi pitkälle alustan yli, joten ruuveille ei ole mitään, mistä lähteä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce maillage du plateau ne s’étend pas assez loin sur le plateau, il n’y a donc rien sur quoi se baser pour les vis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa mesh del piatto non si estende abbastanza sul piatto, quindi non ci sono dati su cui basarsi per le viti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette platenettet når ikke langt nok over platen, så det er ikke noe å gå etter for skruene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze bedmesh reikt niet ver genoeg over het bed, dus er is niets om de schroeven op te baseren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta siatka stołu nie sięga wystarczająco daleko na stole, więc nie ma na czym oprzeć ustawienia śrub."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta malha da mesa não chega suficientemente longe na mesa, por isso não há base para os parafusos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här bäddnätet når inte tillräckligt långt över bädden, så det finns inget att gå på för skruvarna."
          }
        }
      }
    },
