    "%@ uses an HTTPS certificate macOS doesn't recognise. That's normal for a self-signed certificate on an OctoPi. Only trust it if this is your printer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ používá certifikát HTTPS, který macOS nerozpoznává. U certifikátu podepsaného sám sebou na OctoPi je to normální. Důvěřujte mu, jen pokud jde o vaši tiskárnu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae %@ yn defnyddio tystysgrif HTTPS nad yw macOS yn ei hadnabod. Mae hynny'n arferol ar gyfer tystysgrif hunanlofnodedig ar OctoPi. Ymddiriedwch ynddi dim ond os mai eich argraffydd chi yw hwn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bruger et HTTPS-certifikat, som macOS ikke genkender. Det er normalt for et selvsigneret certifikat på en OctoPi. Stol kun på det, hvis det er din printer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwendet ein HTTPS-Zertifikat, das macOS nicht kennt. Bei einem selbst signierten Zertifikat auf einem OctoPi ist das normal. Vertraue ihm nur, wenn das dein Drucker ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uses an HTTPS certificate macOS doesn't recognize. That's normal for a self-signed certificate on an OctoPi. Only trust it if this is your printer."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uses an HTTPS certificate macOS doesn't recognise. That's normal for a self-signed certificate on an OctoPi. Only trust it if this is your printer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa un certificado HTTPS que macOS no reconoce. Es normal con un certificado autofirmado en un OctoPi. Confía en él solo si es tu impresora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ käyttää HTTPS-varmennetta, jota macOS ei tunnista. Se on tavallista OctoPin itse allekirjoitetulle varmenteelle. Luota siihen vain, jos tämä on oma tulostimesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utilise un certificat HTTPS que macOS ne reconnaît pas. C’est normal pour un certificat auto-signé sur un OctoPi. Ne lui faites confiance que s’il s’agit bien de votre imprimante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa un certificato HTTPS che macOS non riconosce. È normale per un certificato autofirmato su un OctoPi. Consideralo attendibile solo se si tratta della tua stampante."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bruker et HTTPS-sertifikat som macOS ikke kjenner igjen. Det er vanlig for et selvsignert sertifikat på en OctoPi. Stol bare på det hvis dette er skriveren din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gebruikt een HTTPS-certificaat dat macOS niet herkent. Dat is normaal voor een zelfondertekend certificaat op een OctoPi. Vertrouw het alleen als dit je eigen printer is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ używa certyfikatu HTTPS, którego macOS nie rozpoznaje. To normalne w przypadku certyfikatu z podpisem własnym na OctoPi. Zaufaj mu tylko, jeśli to twoja drukarka."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa um certificado HTTPS que o macOS não reconhece. É normal num certificado autoassinado num OctoPi. Confie nele apenas se for a sua impressora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ använder ett HTTPS-certifikat som macOS inte känner igen. Det är normalt för ett självsignerat certifikat på en OctoPi. Lita bara på det om det är din skrivare."
          }
        }
      }
    },
    "%@ was due to start at %@, but OctoMac wasn't open.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tisk %1$@ měl začít v %2$@, ale OctoMac nebyl otevřený."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Roedd %1$@ i fod i ddechrau am %2$@, ond doedd OctoMac ddim ar agor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ skulle have startet kl. %2$@, men OctoMac var ikke åben."
          }
        },
        "de": {
