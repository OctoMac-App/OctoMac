    "OctoPrint %@ is several versions behind %@. Update it in the Software panel.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint %1$@ je o několik verzí pozadu za %2$@. Aktualizujte ho v panelu Software."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoPrint %1$@ sawl fersiwn y tu ôl i %2$@. Diweddarwch ef yn y panel Meddalwedd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint %1$@ er flere versioner bagud i forhold til %2$@. Opdater det i panelet Software."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint %1$@ liegt mehrere Versionen hinter %2$@. Aktualisiere es im Bereich „Software“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint %1$@ is several versions behind %2$@. Update it in the Software panel."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint %1$@ is several versions behind %2$@. Update it in the Software panel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint %1$@ está varias versiones por detrás de %2$@. Actualízalo desde la sección Software."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint %1$@ on useita versioita jäljessä versiosta %2$@. Päivitä se Ohjelmisto-osiosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint %1$@ a plusieurs versions de retard sur %2$@. Mettez-le à jour depuis la section Logiciel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint %1$@ è indietro di diverse versioni rispetto a %2$@. Aggiornalo dalla sezione Software."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint %1$@ ligger flere versjoner bak %2$@. Oppdater den under Programvare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint %1$@ loopt een aantal versies achter op %2$@. Werk het bij in het paneel Software."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint %1$@ jest kilka wersji za %2$@. Uaktualnij go w panelu Oprogramowanie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint %1$@ está várias versões atrás da %2$@. Atualize-o no painel Software."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint %1$@ ligger flera versioner efter %2$@. Uppdatera det i panelen Programvara."
          }
        }
      }
    },
