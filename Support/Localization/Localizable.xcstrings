    "Higher plays the video faster.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyšší hodnota přehraje video rychleji."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae rhif uwch yn chwarae'r fideo'n gyflymach."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Højere afspiller videoen hurtigere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höher spielt das Video schneller ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher plays the video faster."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher plays the video faster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor más alto reproduce el vídeo más rápido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suurempi arvo toistaa videon nopeammin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus la valeur est élevée, plus la vidéo défile vite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valore più alto rende il video più veloce."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyere tall spiller av videoen raskere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoger speelt de video sneller af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyższa wartość przyspiesza film."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um valor mais alto reproduz o vídeo mais depressa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Högre spelar upp videon snabbare."
          }
        }
      }
