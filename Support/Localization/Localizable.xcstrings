    "Please don't paste API keys, passwords or printer addresses into the issue. Issues can be read by anyone.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do issue prosím nevkládejte klíče API, hesla ani adresy tiskáren. Issues si může přečíst kdokoli."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Peidiwch â gludo allweddi API, cyfrineiriau na chyfeiriadau argraffwyr i mewn i'r mater. Gall unrhyw un ddarllen materion."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt ikke API-nøgler, adgangskoder eller printeradresser i dit issue. Alle kan læse issues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte füge keine API-Schlüssel, Passwörter oder Druckeradressen in das Issue ein. Issues kann jeder lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please don't paste API keys, passwords or printer addresses into the issue. Issues can be read by anyone."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Please don't paste API keys, passwords or printer addresses into the issue. Issues can be read by anyone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pegues claves de API, contraseñas ni direcciones de impresoras en la incidencia. Cualquiera puede leer las incidencias."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä liitä issueen API-avaimia, salasanoja tai tulostinten osoitteita. Kuka tahansa voi lukea issueita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne collez pas de clés API, de mots de passe ni d’adresses d’imprimantes dans le ticket. Les tickets sont lisibles par tout le monde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non incollare chiavi API, password o indirizzi delle stampanti nella issue. Le issue possono essere lette da chiunque."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke lim inn API-nøkler, passord eller skriveradresser i saken. Saker kan leses av alle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak geen API-sleutels, wachtwoorden of printeradressen in het issue. Issues zijn voor iedereen leesbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wklejaj do zgłoszenia kluczy API, haseł ani adresów drukarek. Zgłoszenia może przeczytać każdy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não cole chaves da API, palavras-passe nem endereços de impressoras no issue. Os issues podem ser lidos por qualquer pessoa."
          }
        },
        "sv": {
