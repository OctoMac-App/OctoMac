            "value": "OctoPrint a redémarré et le plugin fonctionne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint si è riavviato e il plugin è in funzione."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint har startet på nytt, og utvidelsen kjører."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint is opnieuw opgestart en de plug-in draait."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint uruchomił się ponownie i wtyczka działa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint reiniciou e o plugin está a funcionar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint har startat om och pluginet körs."
          }
        }
      }
    },
    "OctoPrint hasn't come back after restarting. Check the Raspberry Pi is switched on.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint se po restartu nevrátil. Zkontrolujte, že je Raspberry Pi zapnuté."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dydy OctoPrint ddim wedi dod yn ôl ar ôl ailgychwyn. Gwiriwch fod y Raspberry Pi ymlaen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint er ikke kommet tilbage efter genstarten. Tjek, at din Raspberry Pi er tændt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ist nach dem Neustart nicht wieder erreichbar. Prüfe, ob der Raspberry Pi eingeschaltet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint hasn't come back after restarting. Check the Raspberry Pi is switched on."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint hasn't come back after restarting. Check the Raspberry Pi is switched on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint no ha vuelto después de reiniciarse. Comprueba que la Raspberry Pi está encendida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ei ole palannut uudelleenkäynnistyksen jälkeen. Tarkista, että Raspberry Pi on päällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint n’est pas revenu après le redémarrage. Vérifiez que le Raspberry Pi est allumé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint non è tornato attivo dopo il riavvio. Controlla che il Raspberry Pi sia acceso."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint har ikke kommet tilbake etter omstarten. Sjekk at Raspberry Pi er slått på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint is na het herstarten niet teruggekomen. Controleer of de Raspberry Pi aanstaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint nie wrócił po ponownym uruchomieniu. Sprawdź, czy Raspberry Pi jest włączone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint não voltou depois de reiniciar. Verifique se o Raspberry Pi está ligado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint har inte kommit tillbaka efter omstarten. Kontrollera att Raspberry Pi är påslagen."
          }
        }
      }
    },
    "OctoPrint is opening the serial port and waiting for the printer to reply. This usually takes a few seconds.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint otevírá sériový port a čeká na odpověď tiskárny. Obvykle to trvá několik sekund."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoPrint yn agor y porth cyfresol ac yn aros i'r argraffydd ateb. Mae hyn fel arfer yn cymryd ychydig eiliadau."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint åbner den serielle port og venter på svar fra printeren. Det tager som regel et par sekunder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint öffnet den seriellen Anschluss und wartet auf eine Antwort des Druckers. Das dauert meist ein paar Sekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint is opening the serial port and waiting for the printer to reply. This usually takes a few seconds."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint is opening the serial port and waiting for the printer to reply. This usually takes a few seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint está abriendo el puerto serie y esperando a que responda la impresora. Suele tardar unos segundos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint avaa sarjaporttia ja odottaa tulostimen vastausta. Tämä kestää yleensä muutaman sekunnin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint ouvre le port série et attend la réponse de l’imprimante. Cela prend généralement quelques secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint sta aprendo la porta seriale e aspetta la risposta della stampante. Di solito ci vogliono pochi secondi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint åpner serieporten og venter på svar fra skriveren. Dette tar vanligvis noen sekunder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint opent de seriële poort en wacht op antwoord van de printer. Dit duurt meestal een paar seconden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint otwiera port szeregowy i czeka na odpowiedź drukarki. Zwykle trwa to kilka sekund."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint está a abrir a porta série e à espera de que a impressora responda. Normalmente demora alguns segundos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint öppnar serieporten och väntar på att skrivaren ska svara. Det tar oftast några sekunder."
          }
        }
      }
    },
    "OctoPrint is restarting with the restored settings and plugins. OctoMac reconnects by itself.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint se restartuje s obnoveným nastavením a pluginy. OctoMac se znovu připojí sám."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoPrint yn ailgychwyn gyda'r gosodiadau a'r ategion a adferwyd. Bydd OctoMac yn ailgysylltu ar ei ben ei hun."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint genstarter med de gendannede indstillinger og plugins. OctoMac forbinder selv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint startet mit den wiederhergestellten Einstellungen und Plugins neu. OctoMac verbindet sich von selbst wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint is restarting with the restored settings and plugins. OctoMac reconnects by itself."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint is restarting with the restored settings and plugins. OctoMac reconnects by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint se está reiniciando con los ajustes y plugins restaurados. OctoMac se volverá a conectar solo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint käynnistyy uudelleen palautetuilla asetuksilla ja lisäosilla. OctoMac yhdistää uudelleen itsestään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint redémarre avec les réglages et plugins restaurés. OctoMac se reconnecte tout seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint si sta riavviando con le impostazioni e i plugin ripristinati. OctoMac si riconnette da solo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint starter på nytt med de gjenopprettede innstillingene og utvidelsene. OctoMac kobler til igjen av seg selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint herstart met de teruggezette instellingen en plug-ins. OctoMac maakt zelf opnieuw verbinding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint uruchamia się ponownie z przywróconymi ustawieniami i wtyczkami. OctoMac połączy się sam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint está a reiniciar com as definições e os plugins restaurados. O OctoMac volta a ligar-se sozinho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint startar om med de återställda inställningarna och pluginerna. OctoMac ansluter igen av sig självt."
          }
        }
      }
    },
    "OctoPrint is running, but it isn't connected to the printer. Switch the printer on, then connect.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint běží, ale není připojený k tiskárně. Zapněte tiskárnu a pak se připojte."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoPrint yn rhedeg, ond dydy e ddim wedi cysylltu â'r argraffydd. Trowch yr argraffydd ymlaen, yna cysylltwch."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kører, men er ikke forbundet til printeren. Tænd printeren, og forbind så."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint läuft, ist aber nicht mit dem Drucker verbunden. Schalte den Drucker ein und verbinde dann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint is running, but it isn't connected to the printer. Switch the printer on, then connect."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint is running, but it isn't connected to the printer. Switch the printer on, then connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint está en marcha, pero no está conectado a la impresora. Enciende la impresora y luego conecta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint on käynnissä, mutta se ei ole yhteydessä tulostimeen. Kytke tulostin päälle ja yhdistä sitten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint fonctionne, mais n’est pas connecté à l’imprimante. Allumez l’imprimante, puis connectez-la."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint è in funzione, ma non è connesso alla stampante. Accendi la stampante, poi connettiti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint kjører, men er ikke koblet til skriveren. Slå på skriveren, og koble deretter til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint draait, maar is niet verbonden met de printer. Zet de printer aan en maak dan verbinding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint działa, ale nie jest połączony z drukarką. Włącz drukarkę, a potem połącz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint está a funcionar, mas não está ligado à impressora. Ligue a impressora e depois clique em Ligar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint körs, men är inte anslutet till skrivaren. Slå på skrivaren och anslut sedan."
          }
        }
      }
    },
    "OctoPrint is still connecting to the printer.": {
      "localizations": {
