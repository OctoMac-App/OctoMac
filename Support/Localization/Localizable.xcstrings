    "Temperatures appear once the printer is connected.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teploty se zobrazí, jakmile bude tiskárna připojená."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae tymereddau'n ymddangos unwaith mae'r argraffydd wedi cysylltu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperaturer vises, når printeren er forbundet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperaturen erscheinen, sobald der Drucker verbunden ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
