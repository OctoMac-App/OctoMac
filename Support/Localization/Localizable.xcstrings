    "S1 turns bed levelling on, S0 off. V shows the stored mesh.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S1 zapne vyrovnání podložky, S0 ho vypne. V zobrazí uloženou síť."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae S1 yn troi lefelu'r gwely ymlaen, S0 i ffwrdd. Mae V yn dangos y rhwyll sydd wedi'i storio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "S1 slår pladenivellering til, S0 fra. V viser det gemte mesh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "S1 schaltet die Bettnivellierung ein, S0 aus. V zeigt das gespeicherte Mesh."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "S1 turns bed leveling on, S0 off. V shows the stored mesh."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "S1 turns bed levelling on, S0 off. V shows the stored mesh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "S1 activa la nivelación de la cama, S0 la desactiva. V muestra la malla guardada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "S1 kytkee alustan tasauksen päälle, S0 pois. V näyttää tallennetun verkon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S1 active le nivellement du plateau, S0 le désactive. V affiche le maillage enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "S1 attiva il livellamento del piatto, S0 lo disattiva. V mostra la mesh salvata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "S1 slår platenivellering på, S0 av. V viser det lagrede nettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "S1 zet bednivellering aan, S0 uit. V toont de opgeslagen mesh."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "S1 włącza poziomowanie stołu, S0 je wyłącza. V pokazuje zapisaną siatkę."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "S1 ativa o nivelamento da mesa, S0 desativa. V mostra a malha guardada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "S1 slår på bäddnivellering, S0 slår av. V visar det sparade nätet."
          }
        }
      }
    },
