    "Starts from the current profile. OctoPrint uses it to check prints fit, and to draw them.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vychází z aktuálního profilu. OctoPrint podle něj kontroluje, zda se tisky vejdou, a vykresluje je."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn dechrau o'r proffil presennol. Mae OctoPrint yn ei ddefnyddio i wirio bod argraffiadau'n ffitio, ac i'w llunio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tager udgangspunkt i den aktuelle profil. OctoPrint bruger den til at tjekke, at prints passer, og til at tegne dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basiert auf dem aktuellen Profil. OctoPrint prüft damit, ob Drucke passen, und zeichnet sie damit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts from the current profile. OctoPrint uses it to check prints fit, and to draw them."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts from the current profile. OctoPrint uses it to check prints fit, and to draw them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte del perfil actual. OctoPrint lo usa para comprobar que las impresiones caben y para dibujarlas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohjana on nykyinen profiili. OctoPrint käyttää sitä tarkistaakseen, että tulosteet mahtuvat, ja piirtääkseen ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Part du profil actuel. OctoPrint s’en sert pour vérifier que les impressions tiennent sur le plateau et pour les dessiner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte dal profilo attuale. OctoPrint lo usa per controllare che le stampe ci stiano e per disegnarle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar utgangspunkt i gjeldende profil. OctoPrint bruker den til å sjekke at utskrifter får plass, og til å tegne dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begint vanuit het huidige profiel. OctoPrint gebruikt het om te controleren of prints passen, en om ze te tekenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaczyna od bieżącego profilu. OctoPrint używa go, aby sprawdzić, czy wydruki się mieszczą, i aby je rysować."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa a partir do perfil atual. O OctoPrint usa-o para verificar se as impressões cabem e para as desenhar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utgår från den aktuella profilen. OctoPrint använder den för att kontrollera att utskrifter får plats och för att rita dem."
          }
        }
      }
    },
    "Starts or resumes printing from the printer's own SD card.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustí nebo obnoví tisk z vlastní SD karty tiskárny."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn dechrau neu'n ailddechrau argraffu o gerdyn SD yr argraffydd ei hun."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter eller genoptager print fra printerens eget SD-kort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet oder setzt das Drucken von der eigenen SD-Karte des Druckers fort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts or resumes printing from the printer's own SD card."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts or resumes printing from the printer's own SD card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia o reanuda la impresión desde la tarjeta SD de la propia impresora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloittaa tai jatkaa tulostusta tulostimen omalta SD-kortilta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance ou reprend l’impression depuis la carte SD de l’imprimante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia o riprende la stampa dalla scheda SD della stampante."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter eller fortsetter utskrift fra skriverens eget SD-kort."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start of hervat het printen vanaf de eigen SD-kaart van de printer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamia lub wznawia drukowanie z karty SD drukarki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia ou retoma a impressão a partir do cartão SD da própria impressora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Startar eller återupptar utskrift från skrivarens eget SD-kort."
          }
        }
      }
    },
