    "The session ended, reconnecting.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Relace skončila, připojuji znovu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Daeth y sesiwn i ben, yn ailgysylltu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessionen sluttede, forbinder igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sitzung wurde beendet, Verbindung wird neu hergestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session ended, reconnecting."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The session ended, reconnecting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión ha terminado, reconectando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Istunto päättyi, yhdistetään uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session s’est terminée, reconnexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione è terminata, riconnessione in corso."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Økten ble avsluttet, kobler til igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sessie is beëindigd, opnieuw verbinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja się zakończyła, ponowne łączenie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão terminou, a ligar novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessionen avslutades, ansluter igen."
          }
        }
      }
    },
    "The update didn't finish. The update's log shows what happened.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizace se nedokončila. Co se stalo, ukazuje protokol aktualizace."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Wnaeth y diweddariad ddim gorffen. Mae log y diweddariad yn dangos beth ddigwyddodd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdateringen blev ikke færdig. Opdateringens log viser, hvad der skete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update wurde nicht abgeschlossen. Das Protokoll des Updates zeigt, was passiert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update didn't finish. The update's log shows what happened."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The update didn't finish. The update's log shows what happened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización no ha terminado. El registro de la actualización muestra lo que ha pasado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitys ei valmistunut. Päivityksen lokista näkee, mitä tapahtui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour n’a pas abouti. Le journal de la mise à jour montre ce qui s’est passé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aggiornamento non è terminato. Il log dell'aggiornamento mostra cosa è successo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdateringen ble ikke fullført. Loggen for oppdateringen viser hva som skjedde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De update is niet afgerond. Het logbestand van de update laat zien wat er gebeurde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uaktualnienie się nie zakończyło. Log uaktualnienia pokazuje, co się stało."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização não terminou. O registo da atualização mostra o que aconteceu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdateringen blev inte klar. Uppdateringens logg visar vad som hände."
          }
        }
      }
    },
    "This OctoPrint can't hand out access this way. Paste an API key instead.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento OctoPrint nemůže tímto způsobem udělit přístup. Vložte raději klíč API."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dydy'r OctoPrint hwn ddim yn gallu rhoi mynediad fel hyn. Gludwch allwedd API yn lle hynny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne OctoPrint kan ikke give adgang på denne måde. Indsæt en API-nøgle i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses OctoPrint kann auf diese Weise keinen Zugriff vergeben. Füge stattdessen einen API-Schlüssel ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This OctoPrint can't hand out access this way. Paste an API key instead."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This OctoPrint can't hand out access this way. Paste an API key instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este OctoPrint no puede conceder acceso de esta forma. Pega una clave de API."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä OctoPrint ei voi myöntää käyttöoikeutta tällä tavalla. Liitä API-avain sen sijaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet OctoPrint ne peut pas donner l’accès de cette façon. Collez plutôt une clé API."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo OctoPrint non può concedere l'accesso in questo modo. Incolla invece una chiave API."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne OctoPrint-serveren kan ikke gi tilgang på denne måten. Lim inn en API-nøkkel i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze OctoPrint kan op deze manier geen toegang geven. Plak in plaats daarvan een API-sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten OctoPrint nie może przyznać dostępu w ten sposób. Zamiast tego wklej klucz API."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este OctoPrint não pode conceder acesso desta forma. Cole antes uma chave da API."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här OctoPrint kan inte dela ut åtkomst på det här sättet. Klistra in en API-nyckel i stället."
          }
        }
      }
    },
    "This Pi doesn't report its power and temperature.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto Pi nehlásí své napájení a teplotu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dydy'r Pi hwn ddim yn adrodd ei bŵer a'i dymheredd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Pi melder ikke sin strøm og temperatur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Pi meldet seine Stromversorgung und Temperatur nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Pi doesn't report its power and temperature."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This Pi doesn't report its power and temperature."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Pi no informa de su alimentación ni de su temperatura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä Pi ei ilmoita virtaansa ja lämpötilaansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Pi n’indique pas son alimentation ni sa température."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Pi non riporta alimentazione e temperatura."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Pi-en rapporterer ikke strøm og temperatur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Pi geeft zijn stroom en temperatuur niet door."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To Pi nie podaje informacji o zasilaniu i temperaturze."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
