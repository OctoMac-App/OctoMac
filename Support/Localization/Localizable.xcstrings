    "No timelapses yet. They appear here once a print with timelapse turned on finishes.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné timelapsy. Objeví se zde po dokončení tisku se zapnutým timelapsem."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dim timelapses eto. Maen nhw'n ymddangos yma unwaith mae argraffiad gyda timelapse ymlaen yn gorffen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen timelapses endnu. De vises her, når et print med timelapse slået til er færdigt."
