          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansio ja kaikki sen sisältö poistetaan tulostimelta. Tätä ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
