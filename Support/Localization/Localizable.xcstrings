    "Bed Visualizer needs the G-code that measures your bed.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bed Visualizer potřebuje G-code, který změří vaši podložku."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae angen y G-code sy'n mesur eich gwely ar Bed Visualizer."
          }
