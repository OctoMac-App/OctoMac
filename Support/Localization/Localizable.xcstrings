            "value": "Arraste para percorrer o clipe"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att bläddra i klippet"
          }
        }
      }
    },
    "Drag to reorder. Double-click a printer to edit it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetažením změníte pořadí. Dvojitým kliknutím na tiskárnu ji upravíte."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Llusgwch i aildrefnu. Cliciwch ddwywaith ar argraffydd i'w olygu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at ændre rækkefølgen. Dobbeltklik på en printer for at redigere den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Neuordnen ziehen. Doppelklicke auf einen Drucker, um ihn zu bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder. Double-click a printer to edit it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder. Double-click a printer to edit it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Haz doble clic en una impresora para editarla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestä vetämällä. Muokkaa tulostinta kaksoisosoittamalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réorganiser. Double-cliquez sur une imprimante pour la modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Fai doppio clic su una stampante per modificarla."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å endre rekkefølgen. Dobbeltklikk på en skriver for å redigere den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om de volgorde te wijzigen. Dubbelklik op een printer om hem te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zmienić kolejność. Kliknij dwukrotnie drukarkę, aby ją edytować."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. Faça duplo clique numa impressora para a editar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att ändra ordning. Dubbelklicka på en skrivare för att redigera den."
          }
        }
      }
    },
    "Drag to rotate, scroll or pinch to zoom, right-drag or ⌥-drag to move. Double-click to reset. The slider cuts the print off at any layer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tažením otáčíte, posouváním nebo sevřením přibližujete, tažením pravým tlačítkem nebo s ⌥ posouváte. Dvojitým kliknutím obnovíte výchozí pohled. Posuvník ořízne výtisk v libovolné vrstvě."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Llusgwch i gylchdroi, sgroliwch neu binsio i chwyddo, llusgwch â'r botwm de neu ⌥ i symud. Cliciwch ddwywaith i ailosod. Mae'r llithrydd yn torri'r argraffiad i ffwrdd ar unrhyw haen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at rotere, rul eller knib for at zoome, højretræk eller ⌥-træk for at flytte. Dobbeltklik for at nulstille. Skyderen skærer printet af ved et vilkårligt lag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Drehen ziehen, zum Zoomen scrollen oder zwei Finger zusammenziehen, zum Verschieben mit rechts oder mit ⌥ ziehen. Doppelklick setzt zurück. Mit dem Regler schneidest du den Druck bei einer beliebigen Schicht ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to rotate, scroll or pinch to zoom, right-drag or ⌥-drag to move. Double-click to reset. The slider cuts the print off at any layer."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to rotate, scroll or pinch to zoom, right-drag or ⌥-drag to move. Double-click to reset. The slider cuts the print off at any layer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para girar, desplaza o pellizca para ampliar, arrastra con el botón derecho o con ⌥ para mover. Haz doble clic para restablecer. El regulador corta la impresión en cualquier capa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kierrä vetämällä, zoomaa vierittämällä tai nipistämällä, siirrä oikealla vedolla tai ⌥-vedolla. Palauta kaksoisosoittamalla. Liukusäädin katkaisee tulosteen mihin tahansa kerrokseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour pivoter, faites défiler ou pincez pour zoomer, faites glisser avec le bouton droit ou ⌥ pour déplacer. Double-cliquez pour réinitialiser. Le curseur coupe l’impression à n’importe quelle couche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per ruotare, scorri o pizzica per lo zoom, trascina con il tasto destro o con ⌥ per spostare. Doppio clic per ripristinare. Il cursore taglia la stampa a qualsiasi layer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å rotere, rull eller knip for å zoome, høyreklikk og dra eller ⌥-dra for å flytte. Dobbeltklikk for å tilbakestille. Glidebryteren kutter utskriften ved et hvilket som helst lag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om te draaien, scrol of knijp om te zoomen, sleep met rechts of met ⌥ om te verplaatsen. Dubbelklik om terug te zetten. Met de schuifknop kap je de print bij elke laag af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby obracać, przewiń lub zsuń palce, aby powiększać, przeciągnij prawym przyciskiem lub z ⌥, aby przesuwać. Kliknij dwukrotnie, aby zresetować. Suwak ucina wydruk na dowolnej warstwie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para rodar, desloque ou junte os dedos para ampliar, arraste com o botão direito ou com ⌥ para mover. Faça duplo clique para repor. O cursor corta a impressão em qualquer camada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att rotera, scrolla eller nyp för att zooma, högerdra eller ⌥-dra för att flytta. Dubbelklicka för att återställa. Reglaget skär av utskriften vid valfritt lager."
          }
        }
      }
    },
    "Drag to turn any way. Double-click to reset. Heights exaggerated.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tažením otáčíte libovolným směrem. Dvojitým kliknutím obnovíte výchozí pohled. Výšky jsou zvětšené."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Llusgwch i droi unrhyw ffordd. Cliciwch ddwywaith i ailosod. Uchderau wedi'u gorliwio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at dreje i alle retninger. Dobbeltklik for at nulstille. Højder er overdrevet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Drehen in jede Richtung ziehen. Doppelklick setzt zurück. Höhen überzeichnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to turn any way. Double-click to reset. Heights exaggerated."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to turn any way. Double-click to reset. Heights exaggerated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para girar en cualquier dirección. Haz doble clic para restablecer. Alturas exageradas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käännä mihin suuntaan tahansa vetämällä. Palauta kaksoisosoittamalla. Korkeuksia liioiteltu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour tourner dans tous les sens. Double-cliquez pour réinitialiser. Hauteurs exagérées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per ruotare in ogni direzione. Doppio clic per ripristinare. Altezze esagerate."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å snu den hvilken som helst vei. Dobbeltklikk for å tilbakestille. Høydene er overdrevet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om alle kanten op te draaien. Dubbelklik om terug te zetten. Hoogtes zijn overdreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby obrócić w dowolną stronę. Kliknij dwukrotnie, aby zresetować. Wysokości są przesadzone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para rodar em qualquer direção. Faça duplo clique para repor. Alturas exageradas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att vrida åt valfritt håll. Dubbelklicka för att återställa. Höjderna är överdrivna."
          }
        }
      }
    },
