          "stringUnit": {
            "state": "translated",
            "value": "Den här Pi:n rapporterar inte sin ström och temperatur."
          }
        }
      }
    },
    "This account can't run system commands on the Pi.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet nemůže na Pi spouštět systémové příkazy."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dydy'r cyfrif hwn ddim yn gallu rhedeg gorchmynion system ar y Pi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne konto kan ikke køre systemkommandoer på Pi'en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto darf keine Systembefehle auf dem Pi ausführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account can't run system commands on the Pi."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This account can't run system commands on the Pi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta no puede ejecutar comandos del sistema en la Pi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tili ei voi suorittaa järjestelmäkomentoja Pi:ssä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte ne peut pas exécuter de commandes système sur le Pi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account non può eseguire comandi di sistema sul Pi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kontoen kan ikke kjøre systemkommandoer på Pi-en."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account kan geen systeemcommando's uitvoeren op de Pi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto nie może uruchamiać poleceń systemowych na Pi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta não pode executar comandos de sistema no Pi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här kontot kan inte köra systemkommandon på Pi:n."
          }
        }
      }
    },
    "This address answered with a web page instead of OctoPrint, perhaps a sign-in page. Check the address, or add the headers it needs under Sign-in.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato adresa odpověděla webovou stránkou místo OctoPrintu, možná přihlašovací stránkou. Zkontrolujte adresu nebo přidejte potřebná záhlaví v části Přihlášení."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Atebodd y cyfeiriad hwn gyda thudalen we yn lle OctoPrint, efallai tudalen fewngofnodi. Gwiriwch y cyfeiriad, neu ychwanegwch y penawdau sydd eu hangen o dan Mewngofnodi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne adresse svarede med en webside i stedet for OctoPrint, måske en loginside. Tjek adressen, eller tilføj de headers, den skal bruge, under Login."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Adresse hat mit einer Webseite statt mit OctoPrint geantwortet, vielleicht mit einer Anmeldeseite. Prüfe die Adresse oder füge unter „Anmeldung“ die benötigten Header hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address answered with a web page instead of OctoPrint, perhaps a sign-in page. Check the address, or add the headers it needs under Sign-in."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This address answered with a web page instead of OctoPrint, perhaps a sign-in page. Check the address, or add the headers it needs under Sign-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dirección ha respondido con una página web en lugar de OctoPrint, quizá una página de inicio de sesión. Comprueba la dirección o añade las cabeceras que necesita en Inicio de sesión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä osoite vastasi verkkosivulla OctoPrintin sijaan, ehkä kirjautumissivulla. Tarkista osoite tai lisää sen tarvitsemat otsakkeet kohtaan Kirjautuminen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse a répondu avec une page web au lieu d’OctoPrint, peut-être une page de connexion. Vérifiez l’adresse, ou ajoutez les en-têtes nécessaires dans Connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo indirizzo ha risposto con una pagina web invece che con OctoPrint, forse una pagina di accesso. Controlla l'indirizzo o aggiungi le intestazioni necessarie in Accesso."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne adressen svarte med en nettside i stedet for OctoPrint, kanskje en påloggingsside. Sjekk adressen, eller legg til headerne den trenger under Pålogging."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit adres antwoordde met een webpagina in plaats van OctoPrint, misschien een aanmeldpagina. Controleer het adres, of voeg de benodigde headers toe onder Aanmelding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod tym adresem odpowiedziała strona internetowa zamiast OctoPrint, być może strona logowania. Sprawdź adres lub dodaj wymagane nagłówki w sekcji Logowanie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este endereço respondeu com uma página web em vez do OctoPrint, talvez uma página de início de sessão. Verifique o endereço ou adicione os cabeçalhos necessários em Início de sessão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här adressen svarade med en webbsida i stället för OctoPrint, kanske en inloggningssida. Kontrollera adressen eller lägg till rubrikerna den behöver under Inloggning."
          }
        }
      }
    },
    "This address asks for a user name and password before OctoPrint. Add them under Sign-in.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato adresa před OctoPrintem vyžaduje uživatelské jméno a heslo. Přidejte je v části Přihlášení."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae'r cyfeiriad hwn yn gofyn am enw defnyddiwr a chyfrinair cyn OctoPrint. Ychwanegwch nhw o dan Mewngofnodi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne adresse beder om brugernavn og adgangskode før OctoPrint. Tilføj dem under Login."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Adresse verlangt vor OctoPrint einen Benutzernamen und ein Passwort. Füge sie unter „Anmeldung“ hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address asks for a user name and password before OctoPrint. Add them under Sign-in."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This address asks for a user name and password before OctoPrint. Add them under Sign-in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dirección pide un nombre de usuario y una contraseña antes de OctoPrint. Añádelos en Inicio de sesión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä osoite kysyy käyttäjänimeä ja salasanaa ennen OctoPrintia. Lisää ne kohtaan Kirjautuminen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse demande un nom d’utilisateur et un mot de passe avant OctoPrint. Ajoutez-les dans Connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo indirizzo chiede nome utente e password prima di OctoPrint. Aggiungili in Accesso."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne adressen ber om brukernavn og passord før OctoPrint. Legg dem til under Pålogging."
          }
        },
        "nl": {
          "stringUnit": {
