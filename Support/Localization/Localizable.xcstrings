    "OctoPrint uses this to check prints fit, and to draw them. Changes apply from the next print.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint podle toho kontroluje, zda se tisky vejdou, a vykresluje je. Změny platí od dalšího tisku."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae OctoPrint yn defnyddio hwn i wirio bod argraffiadau'n ffitio, ac i'w llunio. Mae newidiadau'n dod i rym o'r argraffiad nesaf."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint bruger dette til at tjekke, at prints passer, og til at tegne dem. Ændringer gælder fra næste print."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint prüft damit, ob Drucke passen, und zeichnet sie damit. Änderungen gelten ab dem nächsten Druck."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint uses this to check prints fit, and to draw them. Changes apply from the next print."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint uses this to check prints fit, and to draw them. Changes apply from the next print."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint lo usa para comprobar que las impresiones caben y para dibujarlas. Los cambios se aplican a partir de la próxima impresión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint käyttää tätä tarkistaakseen, että tulosteet mahtuvat, ja piirtääkseen ne. Muutokset tulevat voimaan seuraavasta tulostuksesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint s’en sert pour vérifier que les impressions tiennent sur le plateau et pour les dessiner. Les modifications s’appliquent à partir de la prochaine impression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint lo usa per controllare che le stampe ci stiano e per disegnarle. Le modifiche valgono dalla prossima stampa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint bruker dette til å sjekke at utskrifter får plass, og til å tegne dem. Endringer gjelder fra neste utskrift."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint gebruikt dit om te controleren of prints passen, en om ze te tekenen. Wijzigingen gelden vanaf de volgende print."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint używa tego, aby sprawdzić, czy wydruki się mieszczą, i aby je rysować. Zmiany obowiązują od następnego wydruku."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O OctoPrint usa isto para verificar se as impressões cabem e para as desenhar. As alterações aplicam-se a partir da próxima impressão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoPrint använder detta för att kontrollera att utskrifter får plats och för att rita dem. Ändringar gäller från nästa utskrift."
          }
        }
      }
    },
