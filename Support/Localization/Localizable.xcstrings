    "Sends M108, which breaks the firmware out of its heating wait so the cancel can finish": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odešle M108, který vyvede firmware z čekání na ohřev, aby se zrušení mohlo dokončit"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn anfon M108, sy'n torri'r gadarnwedd allan o'i haros i wresogi fel bod y canslo'n gallu gorffen"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender M108, som får firmwaren ud af ventetiden på opvarmning, så annulleringen kan blive færdig"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet M108, damit die Firmware das Warten aufs Aufheizen abbricht und der Abbruch abgeschlossen werden kann"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends M108, which breaks the firmware out of its heating wait so the cancel can finish"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends M108, which breaks the firmware out of its heating wait so the cancel can finish"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía M108, que saca al firmware de su espera de calentamiento para que la cancelación pueda terminar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää M108:n, joka vapauttaa firmwaren lämmityksen odotuksesta, jotta peruutus voi valmistua"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie M108, qui sort le firmware de son attente de chauffe pour que l’annulation puisse se terminer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia M108, che fa uscire il firmware dall'attesa di riscaldamento così l'annullamento può completarsi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender M108, som får firmwaren ut av oppvarmingsventingen så avbrytingen kan fullføres"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt M108, waarmee de firmware stopt met wachten op opwarmen zodat het annuleren kan worden afgerond"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyła M108, które przerywa oczekiwanie firmware na nagrzanie, aby anulowanie mogło się zakończyć"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia M108, que tira o firmware da espera de aquecimento para que o cancelamento possa terminar"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skickar M108, som bryter firmwarens uppvärmningsväntan så att avbrytningen kan slutföras"
          }
        }
      }
    },
    "Sends temperatures every S seconds without being asked. S0 stops it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posílá teploty každých S sekund bez vyžádání. S0 to vypne."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn anfon tymereddau bob S eiliad heb i neb ofyn. Mae S0 yn ei stopio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender temperaturer hver S sekunder uden at blive spurgt. S0 stopper det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet alle S Sekunden Temperaturen, ohne gefragt zu werden. S0 beendet das."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends temperatures every S seconds without being asked. S0 stops it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends temperatures every S seconds without being asked. S0 stops it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía las temperaturas cada S segundos sin que se le pida. S0 lo detiene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettää lämpötilat S sekunnin välein pyytämättä. S0 lopettaa sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie les températures toutes les S secondes sans qu’on le demande. S0 arrête l’envoi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia le temperature ogni S secondi senza che vengano richieste. S0 lo interrompe."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender temperaturer hvert S. sekund uten å bli spurt. S0 stopper det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuurt elke S seconden uit zichzelf de temperaturen. S0 stopt dit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyła temperatury co S sekund bez pytania. S0 to zatrzymuje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia as temperaturas a cada S segundos sem ser pedido. S0 desativa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skickar temperaturer var S:e sekund utan att bli tillfrågad. S0 stoppar det."
          }
        }
      }
    },
