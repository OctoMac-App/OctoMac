    "Timelapses are switched off. Turn them on in Timelapse settings and each print gets a video here.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Timelapsy jsou vypnuté. Zapněte je v Nastavení timelapsu a každý tisk tu bude mít video."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae timelapses wedi'u diffodd. Trowch nhw ymlaen yn Gosodiadau timelapse a bydd pob argraffiad yn cael fideo yma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Timelapses er slået fra. Slå dem til under Timelapse-indstillinger, så får hvert print en video her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitraffer sind ausgeschaltet. Schalte sie in den Zeitraffer-Einstellungen ein, dann bekommt jeder Druck hier ein Video."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timelapses are switched off. Turn them on in Timelapse settings and each print gets a video here."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Timelapses are switched off. Turn them on in Timelapse settings and each print gets a video here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los timelapses están desactivados. Actívalos en Ajustes de timelapse y cada impresión tendrá aquí su vídeo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Timelapset ovat pois päältä. Ota ne käyttöön Timelapse-asetuksissa, niin jokaisesta tulostuksesta tulee tähän video."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les timelapses sont désactivés. Activez-les dans Réglages du timelapse et chaque impression aura sa vidéo ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I timelapse sono disattivati. Attivali in Impostazioni timelapse e ogni stampa avrà qui il suo video."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Timelapser er slått av. Slå dem på i Timelapse-innstillinger, så får hver utskrift en video her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Timelapses staan uit. Zet ze aan in Timelapse-instellingen en elke print krijgt hier een video."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Timelapse’y są wyłączone. Włącz je w Ustawieniach timelapse, a każdy wydruk będzie miał tutaj film."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os timelapses estão desativados. Ative-os em Definições de timelapse e cada impressão terá aqui um vídeo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Timelapser är avstängda. Slå på dem i Timelapseinställningar så får varje utskrift en video här."
          }
        }
      }
    },
    "Tints what you send from here and the printer's answer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obarví, co odtud odešlete, i odpověď tiskárny."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn arlliwio'r hyn rydych chi'n ei anfon o fan hyn ac ateb yr argraffydd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Farvelægger det, du sender herfra, og printerens svar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbt ein, was du von hier sendest, und die Antwort des Druckers."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tints what you send from here and the printer's answer."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tints what you send from here and the printer's answer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorea lo que envías desde aquí y la respuesta de la impresora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Värittää tästä lähettämäsi ja tulostimen vastauksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore ce que vous envoyez d’ici et la réponse de l’imprimante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colora ciò che invii da qui e la risposta della stampante."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fargelegger det du sender herfra og svaret fra skriveren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleurt wat je hiervandaan verstuurt en het antwoord van de printer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koloruje to, co wysyłasz stąd, i odpowiedź drukarki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá cor ao que envia daqui e à resposta da impressora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Färgar det du skickar härifrån och skrivarens svar."
          }
        }
      }
    },
    "To finish a print gracefully instead, use Stop, which lets OctoPrint run its cancel routine.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li tisk ukončit šetrně, použijte Zastavit, které nechá OctoPrint spustit rutinu pro zrušení."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "I orffen argraffiad yn daclus yn lle hynny, defnyddiwch Stopio, sy'n gadael i OctoPrint redeg ei drefn ganslo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug i stedet Stop for at afslutte et print pænt, så OctoPrint kan køre sin annulleringsrutine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um einen Druck stattdessen sauber zu beenden, verwende „Stoppen“, damit OctoPrint seine Abbruchroutine ausführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To finish a print gracefully instead, use Stop, which lets OctoPrint run its cancel routine."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To finish a print gracefully instead, use Stop, which lets OctoPrint run its cancel routine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para terminar una impresión de forma ordenada, usa Detener, que deja que OctoPrint ejecute su rutina de cancelación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos haluat lopettaa tulostuksen hallitusti, käytä Pysäytä-toimintoa, jolloin OctoPrint ajaa peruutusrutiininsa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour terminer une impression proprement, utilisez plutôt Arrêter, qui laisse OctoPrint lancer sa routine d’annulation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per terminare invece una stampa in modo ordinato, usa Interrompi, che lascia a OctoPrint eseguire la sua routine di annullamento."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk heller Stopp for å avslutte en utskrift på en skånsom måte, så OctoPrint får kjøre avbrytrutinen sin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wil je een print netjes afronden, gebruik dan Stop, zodat OctoPrint zijn annuleerroutine kan uitvoeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zamiast tego łagodnie zakończyć wydruk, użyj Zatrzymaj, co pozwoli OctoPrint uruchomić procedurę anulowania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para terminar uma impressão de forma controlada, use Parar, que deixa o OctoPrint executar a rotina de cancelamento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill avsluta en utskrift på ett snyggt sätt i stället använder du Stoppa, som låter OctoPrint köra sin avbrytningsrutin."
          }
        }
      }
    },
    "To keep it, run Z_OFFSET_APPLY_PROBE and then SAVE_CONFIG in the console once the print has finished.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li změnu zachovat, spusťte po dokončení tisku v konzoli Z_OFFSET_APPLY_PROBE a pak SAVE_CONFIG."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "I'w gadw, rhedwch Z_OFFSET_APPLY_PROBE ac yna SAVE_CONFIG yn y consol unwaith y bydd yr argraffiad wedi gorffen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at beholde den skal du køre Z_OFFSET_APPLY_PROBE og derefter SAVE_CONFIG i konsollen, når printet er færdigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um sie zu behalten, führe nach dem Druck Z_OFFSET_APPLY_PROBE und dann SAVE_CONFIG in der Konsole aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To keep it, run Z_OFFSET_APPLY_PROBE and then SAVE_CONFIG in the console once the print has finished."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To keep it, run Z_OFFSET_APPLY_PROBE and then SAVE_CONFIG in the console once the print has finished."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para conservarlo, ejecuta Z_OFFSET_APPLY_PROBE y luego SAVE_CONFIG en la consola cuando termine la impresión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos haluat säilyttää säädön, aja konsolissa Z_OFFSET_APPLY_PROBE ja sitten SAVE_CONFIG, kun tulostus on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le conserver, lancez Z_OFFSET_APPLY_PROBE puis SAVE_CONFIG dans la console une fois l’impression terminée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per mantenerla, esegui Z_OFFSET_APPLY_PROBE e poi SAVE_CONFIG nella console al termine della stampa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å beholde den, kjør Z_OFFSET_APPLY_PROBE og deretter SAVE_CONFIG i konsollen når utskriften er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om hem te bewaren voer je Z_OFFSET_APPLY_PROBE en daarna SAVE_CONFIG uit in de console zodra de print klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby ją zachować, po zakończeniu wydruku uruchom w konsoli Z_OFFSET_APPLY_PROBE, a potem SAVE_CONFIG."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o manter, execute Z_OFFSET_APPLY_PROBE e depois SAVE_CONFIG na consola quando a impressão terminar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll den genom att köra Z_OFFSET_APPLY_PROBE och sedan SAVE_CONFIG i konsolen när utskriften är klar."
          }
        }
      }
    },
    "To keep it, set the same change in the printer's own Z offset or Live adjust Z menu.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li změnu zachovat, nastavte ji stejně v nabídce Z offset nebo Live adjust Z přímo na tiskárně."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "I'w gadw, gosodwch yr un newid yn newislen Z offset neu Live adjust Z yr argraffydd ei hun."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at beholde den skal du indstille samme ændring i printerens egen Z offset- eller Live adjust Z-menu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um sie zu behalten, stell dieselbe Änderung im Menü „Z offset“ oder „Live adjust Z“ des Druckers ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To keep it, set the same change in the printer's own Z offset or Live adjust Z menu."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To keep it, set the same change in the printer's own Z offset or Live adjust Z menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para conservarlo, aplica el mismo cambio en el offset Z de la propia impresora o en su menú Live adjust Z."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos haluat säilyttää säädön, tee sama muutos tulostimen omaan Z-siirtymään tai Live adjust Z -valikkoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le conserver, appliquez le même changement au décalage Z de l’imprimante ou dans son menu Live adjust Z."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per mantenerla, applica la stessa modifica all'offset Z della stampante o nel suo menu Live adjust Z."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å beholde den, gjør samme endring i skriverens egen Z-forskyvning eller i Live adjust Z-menyen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om hem te bewaren stel je dezelfde wijziging in via het Z-offset- of Live adjust Z-menu van de printer zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby ją zachować, wprowadź tę samą zmianę w menu przesunięcia Z lub Live adjust Z samej drukarki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o manter, faça a mesma alteração no menu de desvio Z ou Live adjust Z da própria impressora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll den genom att göra samma ändring i skrivarens egen meny för Z-förskjutning eller Live adjust Z."
          }
        }
      }
    },
