        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Printeren kan ikke gøre det lige nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Drucker kann das gerade nicht tun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer can't do that right now."
