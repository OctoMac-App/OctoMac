          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac tappar kontakten med skrivaren en minut medan OctoPrint startar om."
          }
        }
      }
    },
    "OctoMac needs an API key from this server": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac potřebuje od tohoto serveru klíč API"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae angen allwedd API o'r gweinydd hwn ar OctoMac"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OctoMac skal bruge en API-nøgle fra denne server"
          }
        },
        "de": {
