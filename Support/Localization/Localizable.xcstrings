    "Any print in progress will stop.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Probíhající tisk se zastaví."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Bydd unrhyw argraffiad sydd ar y gweill yn stopio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et igangværende print stopper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein laufender Druck wird gestoppt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any print in progress will stop."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Any print in progress will stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detendrá cualquier impresión en curso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnissä oleva tulostus pysähtyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute impression en cours sera arrêtée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi stampa in corso verrà interrotta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En pågående utskrift stopper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een lopende print stopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy trwający wydruk zostanie zatrzymany."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer impressão em curso será parada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pågående utskrifter stoppas."
          }
        }
      }
    },
    "Any print is lost and can't be resumed.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Případný tisk bude ztracen a nepůjde obnovit."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Bydd unrhyw argraffiad yn cael ei golli a does dim modd ei ailddechrau."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et eventuelt print går tabt og kan ikke genoptages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein laufender Druck geht verloren und kann nicht fortgesetzt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any print is lost and can't be resumed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Any print is lost and can't be resumed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier impresión se pierde y no se puede reanudar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnissä oleva tulostus menetetään, eikä sitä voi jatkaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute impression est perdue et ne peut pas être reprise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi stampa andrà persa e non potrà essere ripresa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En eventuell utskrift går tapt og kan ikke fortsettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een lopende print gaat verloren en kan niet worden hervat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy wydruk przepadnie i nie da się go wznowić."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer impressão é perdida e não pode ser retomada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pågående utskrifter går förlorade och kan inte återupptas."
