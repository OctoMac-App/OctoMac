    },
    "The last 10 seconds of the camera, %@. Good for catching something that just happened.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posledních 10 sekund z kamery, %@. Hodí se k zachycení něčeho, co se právě stalo."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "10 eiliad olaf y camera, %@. Da ar gyfer dal rhywbeth sydd newydd ddigwydd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De sidste 10 sekunder fra kameraet, %@. Godt til at fange noget, der lige er sket."
          }
        },
        "de": {
          "stringUnit": {
