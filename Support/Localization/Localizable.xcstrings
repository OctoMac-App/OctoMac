    "%@ starts once OctoPrint is back. This usually takes a minute.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se spustí, jakmile bude OctoPrint zpět. Obvykle to trvá minutu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Bydd %@ yn dechrau pan fydd OctoPrint yn ôl. Mae hyn fel arfer yn cymryd munud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ starter, når OctoPrint er tilbage. Det tager normalt et minut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ startet, sobald OctoPrint wieder da ist. Das dauert meist eine Minute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ starts once OctoPrint is back. This usually takes a minute."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ starts once OctoPrint is back. This usually takes a minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se iniciará cuando OctoPrint vuelva. Suele tardar un minuto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ käynnistyy, kun OctoPrint on taas käytettävissä. Tämä kestää yleensä minuutin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ démarrera dès le retour d’OctoPrint. Cela prend généralement une minute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ si avvierà quando OctoPrint sarà di nuovo attivo. Di solito ci vuole un minuto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ starter når OctoPrint er tilbake. Dette tar vanligvis et minutt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ start zodra OctoPrint terug is. Dit duurt meestal een minuut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uruchomi się, gdy OctoPrint wróci. Zwykle trwa to minutę."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ arranca quando o OctoPrint voltar. Normalmente demora um minuto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ startar när OctoPrint är tillbaka. Det brukar ta en minut."
          }
        }
      }
    },
