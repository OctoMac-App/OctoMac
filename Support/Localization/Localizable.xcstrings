    "Only if OctoPrint is behind a proxy that asks for its own sign-in": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen pokud je OctoPrint za proxy, která vyžaduje vlastní přihlášení"
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dim ond os yw OctoPrint y tu ôl i ddirprwy sy'n gofyn am ei fewngofnodi ei hun"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun hvis OctoPrint ligger bag en proxy, der kræver sit eget login"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn OctoPrint hinter einem Proxy liegt, der eine eigene Anmeldung verlangt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only if OctoPrint is behind a proxy that asks for its own sign-in"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only if OctoPrint is behind a proxy that asks for its own sign-in"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo si OctoPrint está detrás de un proxy que pide su propio inicio de sesión"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain jos OctoPrint on välityspalvelimen takana, joka vaatii oman kirjautumisen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement si OctoPrint se trouve derrière un proxy qui demande sa propre connexion"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se OctoPrint è dietro un proxy che chiede un proprio accesso"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare hvis OctoPrint står bak en proxy som krever egen pålogging"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen als OctoPrint achter een proxy staat die om een eigen aanmelding vraagt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko jeśli OctoPrint działa za proxy, które wymaga własnego logowania"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só se o OctoPrint estiver atrás de um proxy que peça o seu próprio início de sessão"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara om OctoPrint ligger bakom en proxy som kräver en egen inloggning"
          }
        }
      }
    },
    "Only install plugins you trust: a plugin can do anything on the Raspberry Pi. Plugins from outside OctoPrint's list haven't been looked at by anyone.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalujte jen pluginy, kterým důvěřujete: plugin může na Raspberry Pi dělat cokoli. Pluginy mimo seznam OctoPrintu nikdo nekontroloval."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dim ond ategion rydych chi'n ymddiried ynddyn nhw y dylech eu gosod: gall ategyn wneud unrhyw beth ar y Raspberry Pi. Does neb wedi edrych ar ategion o'r tu allan i restr OctoPrint."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer kun plugins, du stoler på: et plugin kan gøre hvad som helst på Raspberry Pi'en. Plugins uden for OctoPrints liste er ikke blevet set igennem af nogen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere nur Plugins, denen du vertraust: Ein Plugin kann auf dem Raspberry Pi alles tun. Plugins von außerhalb der OctoPrint-Liste hat niemand geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only install plugins you trust: a plugin can do anything on the Raspberry Pi. Plugins from outside OctoPrint's list haven't been looked at by anyone."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only install plugins you trust: a plugin can do anything on the Raspberry Pi. Plugins from outside OctoPrint's list haven't been looked at by anyone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala solo plugins de confianza: un plugin puede hacer cualquier cosa en la Raspberry Pi. Nadie ha revisado los plugins que no están en la lista de OctoPrint."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asenna vain lisäosia, joihin luotat: lisäosa voi tehdä Raspberry Pi:llä mitä tahansa. Kukaan ei ole tarkistanut OctoPrintin listan ulkopuolisia lisäosia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’installez que des plugins de confiance : un plugin peut tout faire sur le Raspberry Pi. Personne n’a examiné les plugins absents de la liste d’OctoPrint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa solo plugin di cui ti fidi: un plugin può fare qualsiasi cosa sul Raspberry Pi. Nessuno ha controllato i plugin che non sono nell'elenco di OctoPrint."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer bare utvidelser du stoler på: en utvidelse kan gjøre hva som helst på Raspberry Pi. Ingen har sett på utvidelser som ikke står på OctoPrints liste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer alleen plug-ins die je vertrouwt: een plug-in kan alles doen op de Raspberry Pi. Niemand heeft plug-ins van buiten de lijst van OctoPrint bekeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaluj tylko wtyczki, którym ufasz: wtyczka może zrobić wszystko na Raspberry Pi. Wtyczek spoza listy OctoPrint nikt nie sprawdzał."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale apenas plugins em que confia: um plugin pode fazer tudo no Raspberry Pi. Os plugins de fora da lista do OctoPrint não foram analisados por ninguém."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installera bara pluginer du litar på: en plugin kan göra vad som helst på Raspberry Pi. Ingen har granskat pluginer från utanför OctoPrints lista."
          }
        }
      }
    },
