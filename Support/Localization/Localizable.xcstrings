    "Status messages the printer's firmware sends, such as “Heating done”. Some printers send a lot, so this starts off.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavové zprávy, které posílá firmware tiskárny, například „Heating done“. Některé tiskárny jich posílají hodně, proto je to zpočátku vypnuté."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Negeseuon statws mae cadarnwedd yr argraffydd yn eu hanfon, fel “Heating done”. Mae rhai argraffwyr yn anfon llawer, felly mae hyn i ffwrdd i ddechrau."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Statusbeskeder, som printerens firmware sender, f.eks. »Heating done«. Nogle printere sender mange, så dette er slået fra til at starte med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statusmeldungen, die die Firmware des Druckers sendet, zum Beispiel „Heating done“. Manche Drucker senden sehr viele, daher ist das anfangs aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status messages the printer's firmware sends, such as “Heating done”. Some printers send a lot, so this starts off."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Status messages the printer's firmware sends, such as “Heating done”. Some printers send a lot, so this starts off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensajes de estado que envía el firmware de la impresora, como «Heating done». Algunas impresoras envían muchos, así que empieza desactivado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulostimen firmwaren lähettämät tilaviestit, kuten ”Heating done”. Jotkin tulostimet lähettävät niitä paljon, joten tämä on aluksi pois päältä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages d’état envoyés par le firmware de l’imprimante, comme « Heating done ». Certaines imprimantes en envoient beaucoup, c’est donc désactivé au départ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Messaggi di stato inviati dal firmware della stampante, come “Heating done”. Alcune stampanti ne inviano molti, quindi all'inizio è disattivato."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Statusmeldinger som skriverens firmware sender, for eksempel «Heating done». Noen skrivere sender mange, så dette er av til å begynne med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Statusberichten die de firmware van de printer stuurt, zoals “Heating done”. Sommige printers sturen er veel, dus dit staat eerst uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komunikaty o stanie wysyłane przez firmware drukarki, na przykład „Heating done”. Niektóre drukarki wysyłają ich dużo, więc na początku jest to wyłączone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensagens de estado que o firmware da impressora envia, como “Heating done”. Algumas impressoras enviam muitas, por isso começa desativado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Statusmeddelanden som skrivarens firmware skickar, till exempel ”Heating done”. Vissa skrivare skickar många, så det här är avstängt från början."
          }
        }
      }
    },
