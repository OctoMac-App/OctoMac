    "Banners for the printer on screen are skipped while OctoMac is in front.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bannery pro tiskárnu na obrazovce se nezobrazují, když je OctoMac v popředí."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae baneri ar gyfer yr argraffydd sydd ar y sgrin yn cael eu hepgor tra mae OctoMac o'ch blaen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bannere for den printer, der vises, springes over, mens OctoMac er forrest."
